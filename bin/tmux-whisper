#!/usr/bin/env bash
set -euo pipefail

# GUI launchers (SwiftBar/Raycast) often run with a minimal PATH.
# Prefer Homebrew for python3 (tomllib) and ffmpeg.
export PATH="$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:${PATH:-/usr/bin:/bin}"

if [[ -f "$HOME/.zshenv" ]]; then
  # Load XDG vars + SOUNDS_DIR for non-interactive invocations (tmux/Raycast/etc.)
  source "$HOME/.zshenv"
fi

STATE_FILE="${DICTATE_STATE_FILE:-/tmp/whisper-dictate.state}"
INLINE_STATE_FILE="${DICTATE_INLINE_STATE_FILE:-/tmp/whisper-dictate-inline.state}"
TMPDIR="${DICTATE_TMPDIR:-/tmp}"
RECORD_LOG="${DICTATE_RECORD_LOG:-$TMPDIR/whisper-dictate.record.log}"
TRANSCRIBE_LOG="${DICTATE_TRANSCRIBE_LOG:-$TMPDIR/whisper-dictate.transcribe.log}"
TMUX_JOBS_DIR="${DICTATE_TMUX_JOBS_DIR:-/tmp/dictate-tmux-jobs}"

XDG_DATA_HOME="${XDG_DATA_HOME:-$HOME/.local/share}"
DEFAULT_SWIFT_PARAKEET_MODELS_DIR="$XDG_DATA_HOME/tmux-whisper/models"
DICTATE_CONFIG_SCHEMA_VERSION=1

usage() {
  cat <<'EOF'
tmux-whisper: local dictation for macOS with a warm Swift/CoreML Parakeet backend, tmux routing, and mode-aware cleanup.

RECORDING:
  tmux-whisper                    # toggle: start/stop recording (tmux mode)
  tmux-whisper inline             # foreground recording (inline mode)
  tmux-whisper inline start       # start background inline recording
  tmux-whisper inline stop        # stop background inline recording
  tmux-whisper inline toggle      # toggle background inline recording
  tmux-whisper status [--json] [--preset compact]    # show runtime + effective settings snapshot
  tmux-whisper stop               # force stop any recording
  tmux-whisper cancel             # cancel recording (discard, no paste)

AUDIO:
  tmux-whisper devices [--json]   # list macOS audio devices
  tmux-whisper device             # show current device + list available
  tmux-whisper device source <auto|external|mac|iphone|name>  # set mic source strategy
  tmux-whisper device external    # prefer plugged-in external mic, then fallback
  tmux-whisper device mac         # prefer built-in Mac microphone
  tmux-whisper device iphone      # prefer iPhone/Continuity microphone
  tmux-whisper device <index>     # set preferred device by index (stores name; index used as fallback)
  tmux-whisper device index <n>   # pin device index (not recommended; indices can change)
  tmux-whisper device auto        # auto source: prefer external -> mac -> iphone
  tmux-whisper device name "<X>"  # named source: prefer device name substring
  tmux-whisper device mac-name "<X>"    # override built-in Mac source name hint
  tmux-whisper device iphone-name "<X>" # override iPhone source name hint

DIAGNOSTICS:
  tmux-whisper debug [--json]     # show resolved device + relevant env/config
  tmux-whisper doctor [--json]    # quick health summary (state files, markers, logs)
  tmux-whisper config [--json]    # show config path + schema health + key values
  tmux-whisper config path [--json] # print active config path
  tmux-whisper config get <path> [--json] # inspect one config value (file/default)
  tmux-whisper config defaults    # print canonical default config TOML
  tmux-whisper config repair [--dry-run] # fill missing defaults + bump schema safely
  tmux-whisper logs [--json]      # show log paths + recent tails
  tmux-whisper logs path [stream] [--json] # show log file paths
  tmux-whisper logs tail [stream] [--lines N] [--json] # tail one or all logs
  tmux-whisper logs follow [stream] [--lines N] [--json] # follow one or all logs
  tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N] # live status + latest history + bench overview
  tmux-whisper warmup            # preload the Swift Parakeet daemon/model
  tmux-whisper keep-logs          # show persistent log retention setting
  tmux-whisper keep-logs on|off   # persist log retention in config
  tmux-whisper bench [N|all] [--json] [--flow inline|tmux] [--status STATUS] [--mode MODE] [--slow-startup-audio-ms N] # summarize recent stage timings
  tmux-whisper bench export [N|all] [--json] [filters] # export raw bench rows (default: 30 recent)
  tmux-whisper bench-matrix [N] [phrase_file] # compare llm_model(post=on) x postprocess x vocab_clean on fixed phrases
  tmux-whisper changelog          # show recent Tmux Whisper changes

INTEGRATIONS:
  tmux-whisper integrations [--json] # inspect installed SwiftBar/Raycast adapters
  tmux-whisper integrations doctor   # diagnose adapter lifecycle drift
  tmux-whisper integrations repair [--dry-run] # refresh adapter files only
  tmux-whisper swiftbar           # show SwiftBar runtime integration state
  tmux-whisper swiftbar on|off    # enable/disable SwiftBar runtime integration
  tmux-whisper swiftbar toggle    # toggle SwiftBar runtime integration

TEXT CLEANUP:
  tmux-whisper silence-trim       # show silence-trim status
  tmux-whisper silence-trim on|off|toggle  # control ffmpeg silence trimming
  tmux-whisper repeats            # show repeat cleanup level
  tmux-whisper repeats 0|1|2      # set repeat cleanup level

SOUNDS:
  tmux-whisper sound              # show sound settings
  tmux-whisper sound on|off       # master mute toggle
  tmux-whisper sound mute|unmute  # alias for off/on
  tmux-whisper sound start on|off # toggle start sound
  tmux-whisper sound stop on|off  # toggle stop sound
  tmux-whisper sound process on|off # toggle process sound
  tmux-whisper sound error on|off # toggle error sound

LLM POST-PROCESSING (Cerebras API):
  tmux-whisper postprocess        # show current setting
  tmux-whisper postprocess on     # enable LLM cleanup
  tmux-whisper postprocess off    # disable LLM cleanup
  tmux-whisper llm                # show current Cerebras LLM + list all
  tmux-whisper llm fast           # llama3.1-8b (~2200 t/s)
  tmux-whisper llm smart          # llama-3.3-70b (~2100 t/s)
  tmux-whisper llm qwen           # qwen-3-32b (~2600 t/s)
  tmux-whisper llm gpt            # gpt-oss-120b (~3000 t/s, default)
  tmux-whisper llm <mode> <llm>   # per-mode override (e.g., "tmux-whisper llm code smart")
  tmux-whisper budget             # show short/long budget profiles (effective)
  tmux-whisper budget <profile>   # show one budget profile (short or long)
  tmux-whisper budget <profile> llm fast|smart|qwen|gpt|<id>
  tmux-whisper budget <profile> max_tokens <n>
  tmux-whisper budget <profile> chunk_words <n>
  tmux-whisper budget <profile> clear # remove budget-profile overrides

MODES (context-aware prompts):
  tmux-whisper mode               # show current inline mode policy + list all
  tmux-whisper mode auto          # auto-detect inline mode from app (default)
  tmux-whisper mode code          # force code mode for inline cleanup
  tmux-whisper mode long          # long-form cleanup mode
  tmux-whisper mode email         # email mode (formal, professional)
  tmux-whisper mode chat          # chat mode (casual, minimal intervention)
  tmux-whisper mode apps          # list apps that trigger current mode
  tmux-whisper mode apps add X    # add app to current mode's trigger list
  tmux-whisper mode flows [name] [inline|tmux|both] # show/set mode flow availability
  tmux-whisper mode create <name> # create new custom mode
  tmux-whisper mode edit [name]   # edit mode's prompt in $EDITOR

VOCABULARY:
  tmux-whisper vocab              # show custom word corrections
  tmux-whisper vocab add "X::Y" ["A::B"...] # add one or more corrections
  tmux-whisper vocab import [--dry-run] <file> # import corrections from file (one per line)
  tmux-whisper vocab export <file> # export normalized/deduped corrections to file
  tmux-whisper vocab clipboard [--dry-run] # import corrections from clipboard lines
  tmux-whisper vocab dedupe       # normalize + remove duplicate entries
  tmux-whisper vocab edit         # open global vocab file in $EDITOR
  tmux-whisper vocab rm [--dry-run] [--regex] "pattern" # remove entries by literal match (regex opt-in)

INLINE OPTIONS:
  tmux-whisper autosend           # show auto-send setting
  tmux-whisper autosend on        # paste + Enter (default)
  tmux-whisper autosend off       # paste only, no Enter
  tmux-whisper inline process-sound on|off # inline: play processing SFX before transcribe
  tmux-whisper send-mode          # show inline autosend key strategy
  tmux-whisper send-mode enter    # inline autosend uses Enter
  tmux-whisper send-mode ctrl_j   # inline autosend uses Ctrl+J (Claude-friendly)
  tmux-whisper send-mode cmd_enter # inline autosend uses Cmd+Enter
  tmux-whisper target             # show paste target setting
  tmux-whisper target origin      # paste to app from recording start (default; alias: restore)
  tmux-whisper target current     # paste to whatever app is frontmost now

TMUX OPTIONS:
  tmux-whisper tmux               # show tmux defaults
  tmux-whisper tmux autosend on   # tmux: paste + Enter (default)
  tmux-whisper tmux autosend off  # tmux: paste only, no Enter
  tmux-whisper tmux target origin # tmux: paste to pane where recording started (default)
  tmux-whisper tmux target current# tmux: paste to current pane at stop
  tmux-whisper tmux postprocess on|off # tmux: LLM cleanup toggle
  tmux-whisper tmux process-sound on|off # tmux: play processing SFX before transcribe
  tmux-whisper tmux send-mode auto|enter|codex # tmux autosend strategy
  tmux-whisper tmux mode <name>   # tmux: force mode for postprocess (default: code)
KEYBINDS (reference for display in SwiftBar):
  tmux-whisper keybind            # show current keybinds
  tmux-whisper keybind tmux F12   # set tmux mode keybind
  tmux-whisper keybind inline F11 # set inline mode keybind

REPLAY (re-process text with different mode):
  tmux-whisper replay             # re-process clipboard with current mode
  tmux-whisper replay <mode>      # re-process clipboard with specified mode
  tmux-whisper replay <mode> "X"  # re-process provided text with specified mode

HISTORY (saved transcripts, auto-cleanup after 7 days):
  tmux-whisper history            # list recent dictations (last 20)
  tmux-whisper history list [N] [--json] # list recent dictations (default: 20)
  tmux-whisper history search <query> [N] [--json] # find matching dictations
  tmux-whisper history export [N|all] [--json] # export full recent/history entries
  tmux-whisper history N [--json] # show entry N (1 = most recent)
  tmux-whisper history stats [--json] # summarize saved dictations + operator timings
  tmux-whisper history sessions [N] [--json] # compact per-dictation session summaries
  tmux-whisper last [--json]      # concise summary of the most recent dictation
  tmux-whisper history reprocess N [mode]  # re-run LLM on raw transcript
  tmux-whisper history clear      # delete all history

ENV OPTIONS:
  DICTATE_CLEAN=1            # regex filler removal (fast, no LLM)
  DICTATE_POSTPROCESS=1      # LLM cleanup via Cerebras (inline/global default)
  DICTATE_VOCAB_CLEAN=1      # apply vocab-only corrections when postprocess is OFF
  DICTATE_TRIM_WITH_POSTPROCESS=1 # keep silence-trim enabled even when postprocess is ON
  DICTATE_REPEATS_WITH_POSTPROCESS=1 # keep repeat cleanup enabled even when postprocess is ON
  DICTATE_TMUX_POSTPROCESS=1 # tmux-only postprocess override
  DICTATE_TMUX_AUTOSEND=1    # tmux-only autosend override
  DICTATE_TMUX_PASTE_TARGET=origin|current # tmux-only paste target override
  DICTATE_TMUX_SEND_MODE=auto|enter|codex # tmux autosend strategy (default: auto)
  DICTATE_TMUX_SEND_DELAY_MS=90 # delay after paste before autosend key
  DICTATE_TMUX_CODEX_TAB_DELAY_MS=35 # delay between Tab and Enter in codex mode
  DICTATE_INLINE_PROCESS_SOUND=1 # inline-only processing sound override
  DICTATE_INLINE_PASTE_TARGET=origin|current # inline paste target override
  DICTATE_INLINE_ACTIVATE_DELAY_MS=90 # inline: focus settle delay before paste (restore/origin only)
  DICTATE_INLINE_SEND_DELAY_MS=35 # inline: delay between Cmd+V and send key when autosend=on
  DICTATE_INLINE_SEND_MODE=enter|ctrl_j|cmd_enter # inline autosend key strategy (default: enter)
  DICTATE_TMUX_PROCESS_SOUND=1 # tmux-only processing sound toggle
  DICTATE_TMUX_MODE=code     # tmux-only forced mode
  DICTATE_LLM_MODEL=...      # override Cerebras model id (one-off)
  DICTATE_LLM_MAX_TOKENS=3000 # cap postprocess output tokens
  DICTATE_LLM_CHUNK_WORDS=700 # chunk long postprocess input
  DICTATE_BRITISH_SPELLING=1 # enforce UK spellings (default on; set 0 to disable)
  DICTATE_PARAGRAPH_MIN_WORDS=80 # auto split long short/long outputs into paragraphs
  DICTATE_AUDIO_SOURCE=auto|external|mac|iphone|name # source strategy override
  DICTATE_AUDIO_INDEX=N      # audio device index
  DICTATE_AUDIO_NAME="X"     # preferred device name substring (more stable than index)
  DICTATE_STOP_GRACE_MS=700 # shared stop grace (tmux; inline falls back here if unset)
  DICTATE_INLINE_STOP_GRACE_MS=1000 # inline/Raycast stop grace before ffmpeg interrupt
  DICTATE_TRANSCRIBE_TAIL_PAD_MS=500 # append a little silence before ASR to preserve final words
  DICTATE_SWIFT_PARAKEET_TAIL_RESCUE=0|1 # re-transcribe final seconds and merge when full-file ASR drops the tail
  DICTATE_SWIFT_PARAKEET_CHUNKING=1 # opt into experimental long-audio chunked Swift transcription
  DICTATE_KEEP_LOGS=1        # keep /tmp logs even on success
  DICTATE_HISTORY_RETENTION_DAYS=7 # keep transcript JSON history for stats/search
  DICTATE_HISTORY_AUDIO_RETENTION_DAYS=2 # keep archived inline debug WAVs; metadata/logs remain
  DICTATE_BENCH_MAX_ROWS=800 # cap retained bench samples in history/bench.tsv
  DICTATE_BENCH_MATRIX_MODE=code # force mode used by bench-matrix cleanup/postprocess
  DICTATE_BENCH_MATRIX_MODELS=fast,smart,qwen,gpt # LLM list for postprocess-on matrix runs
  DICTATE_BENCH_MATRIX_PROGRESS=1 # show per-combo progress lines (set 0 for summary-only output)
  CEREBRAS_API_KEY=...       # required for postprocess

CONFIG FILES (kept under ~/.config/dictate/ for now):
  config.toml                # main settings (Parakeet backend, postprocess, autosend, keybind refs, icons)
  vocab                      # global corrections (one per line: wrong → right)
  current-mode               # mode selection (code/email/etc)
  modes/<mode>/apps          # apps that trigger this mode (one per line)
  modes/<mode>/prompt        # mode-specific LLM prompt
  modes/<mode>/vocab         # mode-specific corrections
  history/                   # saved transcripts + stats metadata (JSON auto-cleaned after history.retention_days)
  history/inline-debug/      # keep_logs artifacts; WAVs auto-pruned after history.audio_retention_days
  sounds/                    # sample sounds still install under ~/.local/share/sounds/dictate in this phase
EOF
}

die() {
  local msg="tmux-whisper: $*"
  echo "$msg" >&2
  if [[ -n "${TMUX:-}" ]] && command -v tmux >/dev/null 2>&1; then
    tmux display-message -d 5000 "$msg" 2>/dev/null || true
  fi
  exit 2
}
need() { command -v "$1" >/dev/null 2>&1 || die "missing dependency: $1"; }

now_ms() {
  perl -MTime::HiRes=time -e 'printf "%.0f\n", time()*1000'
}

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

DICTATE_LIB_PATH="${DICTATE_LIB_PATH:-$HOME/.local/bin/dictate-lib.sh}"
if [[ ! -r "$DICTATE_LIB_PATH" ]]; then
  FALLBACK_LIB="$SCRIPT_DIR/dictate-lib.sh"
  if [[ -r "$FALLBACK_LIB" ]]; then
    DICTATE_LIB_PATH="$FALLBACK_LIB"
  fi
fi
[[ -r "$DICTATE_LIB_PATH" ]] || die "missing shared library: $DICTATE_LIB_PATH"
# shellcheck disable=SC1090
source "$DICTATE_LIB_PATH"

DICTATE_INTERNAL_LIB_DIR="${DICTATE_INTERNAL_LIB_DIR:-$HOME/.local/bin/tmux-whisper-lib}"
if [[ ! -d "$DICTATE_INTERNAL_LIB_DIR" ]]; then
  FALLBACK_INTERNAL_LIB_DIR="$SCRIPT_DIR/tmux-whisper-lib"
  if [[ -d "$FALLBACK_INTERNAL_LIB_DIR" ]]; then
    DICTATE_INTERNAL_LIB_DIR="$FALLBACK_INTERNAL_LIB_DIR"
  fi
fi
for internal_runtime_module in config.sh audio.sh mode.sh recording.sh integrations.sh history.sh diagnostics.sh; do
  [[ -r "$DICTATE_INTERNAL_LIB_DIR/$internal_runtime_module" ]] || die "missing internal runtime module: $DICTATE_INTERNAL_LIB_DIR/$internal_runtime_module"
  # shellcheck disable=SC1090
  source "$DICTATE_INTERNAL_LIB_DIR/$internal_runtime_module"
done

cmd="${1:-toggle}"
SKIP_INITIAL_CONFIG_LOAD=0

if [[ "$cmd" == "-h" || "$cmd" == "--help" || "$cmd" == "help" ]]; then
  usage
  exit 0
fi
if [[ "$cmd" == "config" ]]; then
  SKIP_INITIAL_CONFIG_LOAD=1
fi

# Clean filler words from text (uses perl for case-insensitive)
clean_fillers() {
  dictate_lib_clean_fillers
}

# Clean stutters/repeats (configurable; avoids code-ish tokens like iTerm2, foo_bar, gpt-4, paths)
# Level 0: off
# Level 1: repeated word ("the the" -> "the")
# Level 2: repeated short phrase (2–3 words) ("go ahead and go ahead and" -> "go ahead and")
clean_repeats() {
  local level="${1:-1}"
  dictate_lib_clean_repeats "$level"
}

# Remove known whisper placeholder artefacts (e.g. "[blank audio]") from transcript text.
sanitize_transcript_artifacts() {
  dictate_lib_sanitize_transcript_artifacts
}

auto_paragraphs() {
  local mode="${1:-}"
  local min_words="${2:-${DICTATE_PARAGRAPH_MIN_WORDS:-80}}"
  dictate_lib_auto_paragraphs "$mode" "$min_words"
}

apply_mode_cleanup() {
  local mode="${1:-}"
  case "$mode" in
    code)
      auto_paragraphs "$mode" "${DICTATE_CODE_PARAGRAPH_MIN_WORDS:-70}"
      ;;
    long)
      auto_paragraphs "$mode" "${DICTATE_LONG_PARAGRAPH_MIN_WORDS:-55}"
      ;;
    *)
      cat
      ;;
  esac
}

normalize_british_spelling() {
  local enabled="${DICTATE_BRITISH_SPELLING:-1}"
  dictate_lib_normalize_british_spelling "$enabled"
}

apply_vocab_corrections() {
  local mode="${1:-}"
  dictate_lib_apply_vocab_corrections "$mode" "$DICTATE_CONFIG_DIR"
}

XDG_CONFIG_HOME="${XDG_CONFIG_HOME:-$HOME/.config}"
DICTATE_CONFIG_DIR="${DICTATE_CONFIG_DIR:-$XDG_CONFIG_HOME/dictate}"
DICTATE_CONFIG_FILE="${DICTATE_CONFIG_FILE:-$DICTATE_CONFIG_DIR/config.toml}"
MODE_FILE="$DICTATE_CONFIG_DIR/current-mode"

mkdir -p "$DICTATE_CONFIG_DIR"

# Cache resolved audio index by source selection key to avoid repeated
# `ffmpeg -list_devices` scans on every invocation when source choice is stable.
AUDIO_CACHE_DIR="$DICTATE_CONFIG_DIR/.cache"
AUDIO_INDEX_CACHE="$AUDIO_CACHE_DIR/audio-index.sh"
BACKEND_RUNTIME_CACHE="$AUDIO_CACHE_DIR/backend-state.sh"
INLINE_SESSION_CACHE="$AUDIO_CACHE_DIR/inline-session.sh"
PROCESSING_DIR="${DICTATE_PROCESSING_DIR:-/tmp/dictate-processing}"
PROCESSED_FLAG="${DICTATE_PROCESSED_FLAG:-/tmp/dictate-just-processed}"
PROCESSING_LONG_FLAG="${DICTATE_PROCESSING_LONG_FLAG:-/tmp/dictate-inline-processing-long.flag}"
PROCESSING_MARKER_FILE=""
DICTATE_LAST_AUDIO_INDEX_SOURCE=""
DICTATE_LAST_AUDIO_INDEX_MS="0"
DICTATE_LAST_AUDIO_CACHE_NOTE=""
DICTATE_LAST_BACKEND_REQUESTED=""
DICTATE_LAST_BACKEND_USED=""
DICTATE_LAST_BACKEND_FALLBACK_REASON=""
DICTATE_LAST_BACKEND_ENGINE=""
DICTATE_LAST_BACKEND_MODEL=""

processing_marker_start() {
  local kind="${1:-inline}"
  local session_id="${2:-}"
  local pid_override="${3:-}"
  PROCESSING_MARKER_FILE=""
  mkdir -p "$PROCESSING_DIR" 2>/dev/null || return 0

  local marker_pid f
  marker_pid="$pid_override"
  [[ -n "$marker_pid" ]] || marker_pid="${BASHPID:-$$}"
  f="$PROCESSING_DIR/${kind}-${marker_pid}"
  {
    printf 'pid=%s\n' "$marker_pid"
    printf 'kind=%s\n' "$kind"
    [[ -n "$session_id" ]] && printf 'session_id=%s\n' "$session_id"
    printf 'started_at=%s\n' "$(date +%s)"
  } >"$f" 2>/dev/null || return 0
  PROCESSING_MARKER_FILE="$f"
}

processing_marker_stop() {
  local f="${1:-}"
  [[ -n "$f" ]] && rm -f "$f" 2>/dev/null || true
}

processing_marker_stop_by_session() {
  local session_id="${1:-}"
  [[ -n "$session_id" && -d "$PROCESSING_DIR" ]] || return 0

  local f marker_session
  for f in "$PROCESSING_DIR"/inline-*; do
    [[ -f "$f" ]] || continue
    marker_session="$(sed -n 's/^session_id=//p' "$f" 2>/dev/null | head -n 1)"
    [[ "$marker_session" == "$session_id" ]] && rm -f "$f" 2>/dev/null || true
  done
}

signal_just_processed() {
  touch "$PROCESSED_FLAG" 2>/dev/null || true
  rm -f "$PROCESSING_LONG_FLAG" 2>/dev/null || true
}

generate_inline_session_id() {
  printf 'inline-%s-%s-%s\n' "$(date +%s)" "$$" "$RANDOM"
}

write_inline_latest_session() {
  local session_id="${1:-}"
  [[ -n "$session_id" ]] || return 0

  mkdir -p "$AUDIO_CACHE_DIR" 2>/dev/null || return 0
  local tmp
  tmp="$(mktemp "$AUDIO_CACHE_DIR/.inline-session.XXXXXX" 2>/dev/null || true)"
  [[ -n "$tmp" ]] || return 0

  umask 077
  printf 'INLINE_LATEST_SESSION_ID=%q\nINLINE_LATEST_SESSION_AT=%q\n' \
    "$session_id" "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >"$tmp" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 0
  }
  mv -f "$tmp" "$INLINE_SESSION_CACHE" 2>/dev/null || true
}

load_inline_latest_session() {
  [[ -f "$INLINE_SESSION_CACHE" ]] || return 1
  # shellcheck disable=SC1090
  source "$INLINE_SESSION_CACHE" 2>/dev/null || return 1
  [[ -n "${INLINE_LATEST_SESSION_ID:-}" ]]
}

inline_session_is_current() {
  local session_id="${1:-}"
  [[ -n "$session_id" ]] || return 0
  if ! load_inline_latest_session; then
    return 0
  fi
  [[ "${INLINE_LATEST_SESSION_ID:-}" == "$session_id" ]]
}

load_backend_runtime_cache() {
  [[ -f "$BACKEND_RUNTIME_CACHE" ]] || return 1
  # shellcheck disable=SC1090
  source "$BACKEND_RUNTIME_CACHE" 2>/dev/null || return 1
  return 0
}

write_backend_runtime_cache() {
  local requested="${1:-swift_parakeet}"
  local used="${2:-swift_parakeet}"
  local fallback_reason="${3:-}"
  local engine="${4:-}"
  local model="${5:-}"

  mkdir -p "$AUDIO_CACHE_DIR" 2>/dev/null || return 0
  local tmp
  tmp="$(mktemp "$AUDIO_CACHE_DIR/.backend-state.XXXXXX" 2>/dev/null || true)"
  [[ -n "$tmp" ]] || return 0

  umask 077
  {
    printf 'DICTATE_LAST_BACKEND_REQUESTED=%q\n' "$requested"
    printf 'DICTATE_LAST_BACKEND_USED=%q\n' "$used"
    printf 'DICTATE_LAST_BACKEND_FALLBACK_REASON=%q\n' "$fallback_reason"
    printf 'DICTATE_LAST_BACKEND_ENGINE=%q\n' "$engine"
    printf 'DICTATE_LAST_BACKEND_MODEL=%q\n' "$model"
    printf 'DICTATE_LAST_BACKEND_AT=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
  } >"$tmp" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 0
  }
  mv -f "$tmp" "$BACKEND_RUNTIME_CACHE" 2>/dev/null || true
}

# --- Config (TOML) -----------------------------------------------------------

expand_path() {
  dictate_lib_expand_path "${1:-}"
}

expand_sound_path() {
  dictate_lib_expand_sound_path "${1:-}"
}

		sound_enabled() {
		  local event="${1:-}"

		  [[ "${CFG_AUDIO_SOUNDS_ENABLED:-1}" == "1" ]] || return 1

		  case "$event" in
		    start) [[ "${CFG_AUDIO_SOUNDS_START_ENABLED:-1}" == "1" ]] || return 1 ;;
		    stop) [[ "${CFG_AUDIO_SOUNDS_STOP_ENABLED:-1}" == "1" ]] || return 1 ;;
		    process) [[ "${CFG_AUDIO_SOUNDS_PROCESS_ENABLED:-1}" == "1" ]] || return 1 ;;
		    error) [[ "${CFG_AUDIO_SOUNDS_ERROR_ENABLED:-1}" == "1" ]] || return 1 ;;
		    cancel) [[ "${CFG_AUDIO_SOUNDS_CANCEL_ENABLED:-1}" == "1" ]] || return 1 ;;
		  esac

		  return 0
		}

		dictate_sound_path() {
		  local event="${1:-}"
		  local cfg=""

	  case "$event" in
	    start) cfg="${CFG_AUDIO_SOUNDS_START:-}" ;;
	    stop) cfg="${CFG_AUDIO_SOUNDS_STOP:-}" ;;
	    process) cfg="${CFG_AUDIO_SOUNDS_PROCESS:-}" ;;
	    error) cfg="${CFG_AUDIO_SOUNDS_ERROR:-}" ;;
	    cancel) cfg="${CFG_AUDIO_SOUNDS_CANCEL:-}" ;;
	    *) return 0 ;;
	  esac

	  if [[ -z "$cfg" ]]; then
	    [[ -n "${SOUNDS_DIR:-}" ]] || return 0
	    cfg="$SOUNDS_DIR/dictate/$event.wav"
	  else
	    cfg="$(expand_sound_path "$cfg")"
	  fi

	  [[ -f "$cfg" ]] && printf "%s" "$cfg"
	}

play_sound() {
  local event="${1:-}"
  local p
  sound_enabled "$event" || return 0
  p="$(dictate_sound_path "$event" || true)"
  [[ -n "$p" ]] || return 0
  nohup afplay "$p" >/dev/null 2>&1 &
}

keep_logs_enabled() {
  [[ "${DICTATE_KEEP_LOGS:-${CFG_DEBUG_KEEP_LOGS:-0}}" == "1" ]]
}

file_size_bytes() {
  local path="${1:-}"
  [[ -n "$path" && -f "$path" ]] || return 0
  stat -f '%z' "$path" 2>/dev/null || stat -c '%s' "$path" 2>/dev/null || true
}

audio_duration_ms() {
  local path="${1:-}"
  [[ -n "$path" && -f "$path" ]] || return 0
  command -v ffprobe >/dev/null 2>&1 || return 0

  local duration
  duration="$(ffprobe -v error -show_entries format=duration -of default=noprint_wrappers=1:nokey=1 "$path" 2>/dev/null || true)"
  [[ "$duration" =~ ^[0-9]+([.][0-9]+)?$ ]] || return 0
  awk -v duration="$duration" 'BEGIN { printf "%.0f\n", duration * 1000 }'
}

inline_debug_archive_dir() {
  printf "%s\n" "$HISTORY_DIR/inline-debug"
}

inline_archive_prefix() {
  local session_id="${1:-inline}"
  keep_logs_enabled || return 1

  local dir
  dir="$(inline_debug_archive_dir)"
  mkdir -p "$dir" 2>/dev/null || return 1

  local safe_session ts
  safe_session="$(printf '%s' "$session_id" | tr -c '[:alnum:]._-' '_')"
  ts="$(date '+%Y-%m-%dT%H-%M-%S')"
  printf "%s/%s-%s\n" "$dir" "$ts" "$safe_session"
}

archive_inline_debug_artifacts() {
  local prefix="${1:-}"
  local wav="${2:-}"
  local record_log="${3:-}"
  local transcribe_log="${4:-}"
  local status="${5:-unknown}"
  local record_ms="${6:-0}"
  local transcribe_ms="${7:-0}"
  local clean_ms="${8:-0}"
  local postprocess_ms="${9:-0}"
  local paste_ms="${10:-0}"
  local total_ms="${11:-0}"
  local session_id="${12:-}"

  if [[ -n "$prefix" ]]; then
    local archive_wav_ms archive_wav_bytes
    archive_wav_ms="$(audio_duration_ms "$wav" 2>/dev/null || true)"
    archive_wav_bytes="$(file_size_bytes "$wav" 2>/dev/null || true)"
    INLINE_ARCHIVE_WAV_MS="$archive_wav_ms"
    INLINE_ARCHIVE_WAV_BYTES="$archive_wav_bytes"
    INLINE_DEBUG_ARCHIVE_PREFIX="$prefix"
    INLINE_DEBUG_WAV_RETENTION_DAYS="$(history_audio_retention_days)"
    INLINE_DEBUG_AUDIO_RETENTION_NOTE="WAV retained for ${INLINE_DEBUG_WAV_RETENTION_DAYS} day(s); JSON history and .meta/.log artifacts remain for stats/roundups."

    [[ -f "$wav" ]] && cp -f "$wav" "${prefix}.wav" 2>/dev/null || true
    [[ -f "$record_log" ]] && cp -f "$record_log" "${prefix}.record.log" 2>/dev/null || true
    [[ -f "$transcribe_log" ]] && cp -f "$transcribe_log" "${prefix}.transcribe.log" 2>/dev/null || true
    {
      printf 'session_id=%q\n' "$session_id"
      printf 'status=%q\n' "$status"
      printf 'record_ms=%q\n' "$record_ms"
      printf 'stop_grace_ms=%q\n' "${INLINE_STOP_GRACE_MS:-}"
      printf 'capture_wav_ms=%q\n' "${INLINE_CAPTURE_WAV_MS:-}"
      printf 'capture_wav_bytes=%q\n' "${INLINE_CAPTURE_WAV_BYTES:-}"
      printf 'capture_gap_to_record_ms=%q\n' "${INLINE_CAPTURE_GAP_TO_RECORD_MS:-}"
      printf 'capture_gap_to_record_plus_grace_ms=%q\n' "${INLINE_CAPTURE_GAP_TO_RECORD_PLUS_GRACE_MS:-}"
      printf 'archive_wav_ms=%q\n' "$archive_wav_ms"
      printf 'archive_wav_bytes=%q\n' "$archive_wav_bytes"
      printf 'wav_retention_days=%q\n' "$INLINE_DEBUG_WAV_RETENTION_DAYS"
      printf 'retention_note=%q\n' "$INLINE_DEBUG_AUDIO_RETENTION_NOTE"
      printf 'transcribe_ms=%q\n' "$transcribe_ms"
      printf 'clean_ms=%q\n' "$clean_ms"
      printf 'postprocess_ms=%q\n' "$postprocess_ms"
      printf 'paste_ms=%q\n' "$paste_ms"
      printf 'total_ms=%q\n' "$total_ms"
      printf 'archived_at=%q\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    } >"${prefix}.meta" 2>/dev/null || true
    cleanup_inline_debug_audio "$INLINE_DEBUG_WAV_RETENTION_DAYS"
  fi

  rm -f "$wav" 2>/dev/null || true
}

resolve_stop_grace_ms() {
  local requested_ms="${1:-}"
  local default_ms="${2:-700}"
  if [[ "$requested_ms" =~ ^[0-9]+$ ]]; then
    printf "%s\n" "$requested_ms"
  else
    printf "%s\n" "$default_ms"
  fi
}

resolve_inline_stop_grace_ms() {
  resolve_stop_grace_ms "${DICTATE_INLINE_STOP_GRACE_MS:-${DICTATE_STOP_GRACE_MS:-}}" "1000"
}

logs() {
  logs_usage() {
    die "usage: tmux-whisper logs [--json] | logs path [record|transcribe|inline-record|inline-transcribe|all] [--json] | logs tail [record|transcribe|inline-record|inline-transcribe|all] [--lines N] [--json] | logs follow [record|transcribe|inline-record|inline-transcribe|all] [--lines N] [--json]"
  }

  logs_stream_keys() {
    printf '%s\n' "record" "transcribe" "inline-record" "inline-transcribe"
  }

  logs_inline_record_path() {
    printf '%s\n' "$TMPDIR/whisper-dictate-inline.record.log"
  }

  logs_inline_transcribe_path() {
    printf '%s\n' "$TMPDIR/whisper-dictate-inline.transcribe.log"
  }

  logs_stream_path() {
    case "${1:-}" in
      record) printf '%s\n' "$RECORD_LOG" ;;
      transcribe) printf '%s\n' "$TRANSCRIBE_LOG" ;;
      inline-record) logs_inline_record_path ;;
      inline-transcribe) logs_inline_transcribe_path ;;
      *) return 1 ;;
    esac
  }

  logs_stream_label() {
    case "${1:-}" in
      record) printf '%s\n' "record" ;;
      transcribe) printf '%s\n' "transcribe" ;;
      inline-record) printf '%s\n' "inline record" ;;
      inline-transcribe) printf '%s\n' "inline transcribe" ;;
      *) return 1 ;;
    esac
  }

  logs_stream_default_lines() {
    case "${1:-}" in
      record|inline-record) printf '%s\n' "40" ;;
      transcribe|inline-transcribe) printf '%s\n' "80" ;;
      *) return 1 ;;
    esac
  }

  logs_canonical_stream() {
    case "${1:-}" in
      all|"") printf '%s\n' "all" ;;
      record) printf '%s\n' "record" ;;
      transcribe) printf '%s\n' "transcribe" ;;
      inline-record|inline_record|inline-rec|inline_record_log) printf '%s\n' "inline-record" ;;
      inline-transcribe|inline_transcribe|inline-trn|inline_transcribe_log) printf '%s\n' "inline-transcribe" ;;
      *) return 1 ;;
    esac
  }

  logs_selected_streams() {
    local spec="${1:-all}"
    local canonical
    canonical="$(logs_canonical_stream "$spec")" || die "unknown log stream: $spec (use: record, transcribe, inline-record, inline-transcribe, all)"
    if [[ "$canonical" == "all" ]]; then
      logs_stream_keys
    else
      printf '%s\n' "$canonical"
    fi
  }

  logs_json() {
    local subcmd="$1"
    local rows_input=""
    rows_input="$(cat)"
    LOG_ROWS="$rows_input" python3 - "$subcmd" <<'PYEOF'
import json
import os
import sys
from collections import deque

subcmd = sys.argv[1]
streams = []

for raw_line in os.environ.get("LOG_ROWS", "").splitlines():
    if not raw_line:
        continue
    key, label, path, tail_lines = raw_line.split("\t", 3)
    path = os.path.expanduser(path)
    tail_n = int(tail_lines)
    exists = os.path.exists(path)
    item = {
        "key": key,
        "label": label,
        "path": path,
        "exists": exists,
        "tail_lines_requested": tail_n,
    }
    if subcmd in ("show", "tail"):
        lines = []
        if exists:
          try:
              with open(path, "r", encoding="utf-8", errors="replace") as fh:
                  lines = list(deque((line.rstrip("\n") for line in fh), maxlen=tail_n))
          except Exception as exc:
              item["read_error"] = str(exc)
        item["line_count"] = len(lines)
        item["lines"] = lines
    streams.append(item)

print(json.dumps({
    "command": "logs",
    "subcommand": subcmd,
    "streams": streams,
    "next_commands": [
        "tmux-whisper status --preset compact",
        "tmux-whisper history sessions 5",
        "tmux-whisper bench 10",
    ],
}, indent=2, sort_keys=True))
PYEOF
  }

  logs_follow_output() {
    local rows_input="$1"
    local json_output="$2"
    LOG_ROWS="$rows_input" python3 -u - "$json_output" <<'PYEOF'
import json
import os
import sys
import time

json_output = sys.argv[1] == "1"
poll_ms_raw = os.environ.get("DICTATE_LOGS_FOLLOW_POLL_MS", "1000").strip()
iterations_raw = os.environ.get("DICTATE_LOGS_FOLLOW_ITERATIONS", "").strip()

try:
    poll_ms = int(poll_ms_raw)
except Exception:
    poll_ms = 1000
if poll_ms <= 0:
    poll_ms = 1000

iterations = None
if iterations_raw:
    try:
        parsed_iterations = int(iterations_raw)
    except Exception:
        parsed_iterations = 0
    if parsed_iterations > 0:
        iterations = parsed_iterations

streams = []
for raw_line in os.environ.get("LOG_ROWS", "").splitlines():
    if not raw_line:
        continue
    key, label, path, tail_lines = raw_line.split("\t", 3)
    streams.append(
        {
            "key": key,
            "label": label,
            "path": os.path.expanduser(path),
            "tail_lines_requested": int(tail_lines),
            "seen_lines": 0,
        }
    )

multi_stream = len(streams) > 1

def emit_text(line: str = ""):
    print(line, flush=True)

def emit_json(payload):
    print(json.dumps(payload, sort_keys=True), flush=True)

def emit_line(stream, line, initial):
    if json_output:
        emit_json(
            {
                "command": "logs",
                "subcommand": "follow",
                "event": "line",
                "stream": stream["key"],
                "label": stream["label"],
                "path": stream["path"],
                "line": line,
                "initial": initial,
            }
        )
    else:
        if multi_stream:
            emit_text(f"[{stream['key']}] {line}")
        else:
            emit_text(line)

def read_lines(path):
    try:
        with open(path, "r", encoding="utf-8", errors="replace") as fh:
            return [line.rstrip("\n") for line in fh]
    except FileNotFoundError:
        return None
    except Exception:
        return []

if json_output:
    for stream in streams:
        exists = os.path.exists(stream["path"])
        emit_json(
            {
                "command": "logs",
                "subcommand": "follow",
                "event": "start",
                "stream": stream["key"],
                "label": stream["label"],
                "path": stream["path"],
                "exists": exists,
                "tail_lines_requested": stream["tail_lines_requested"],
                "poll_ms": poll_ms,
            }
        )
else:
    emit_text(f"Following logs (poll {poll_ms}ms). Press Ctrl-C to stop.")
    for stream in streams:
        emit_text("")
        emit_text(f"--- {stream['label']} (follow tail {stream['tail_lines_requested']}) ---")

for stream in streams:
    current_lines = read_lines(stream["path"])
    if current_lines is None:
        if not json_output:
            emit_text(f"No {stream['label']} log yet at: {stream['path']}")
        stream["seen_lines"] = 0
        continue

    stream["seen_lines"] = len(current_lines)
    initial_lines = current_lines[-stream["tail_lines_requested"] :]
    for line in initial_lines:
        emit_line(stream, line, True)

poll_count = 0
while iterations is None or poll_count < iterations:
    time.sleep(poll_ms / 1000.0)
    poll_count += 1
    for stream in streams:
        current_lines = read_lines(stream["path"])
        if current_lines is None:
            stream["seen_lines"] = 0
            continue
        if len(current_lines) < stream["seen_lines"]:
            stream["seen_lines"] = 0
        new_lines = current_lines[stream["seen_lines"] :]
        stream["seen_lines"] = len(current_lines)
        for line in new_lines:
            emit_line(stream, line, False)
PYEOF
  }

  local subcmd="show"
  case "${1:-}" in
    show|path|tail|follow)
      subcmd="$1"
      shift
      ;;
  esac

  local json_output="0"
  local stream_spec="all"
  local lines_override=""
  while [[ $# -gt 0 ]]; do
    case "$1" in
      --json)
        json_output="1"
        ;;
      --lines)
        shift
        [[ $# -gt 0 ]] || logs_usage
        lines_override="$1"
        ;;
      record|transcribe|inline-record|inline_record|inline-rec|inline_record_log|inline-transcribe|inline_transcribe|inline-trn|inline_transcribe_log|all)
        [[ "$stream_spec" == "all" ]] || logs_usage
        stream_spec="$1"
        ;;
      *)
        logs_usage
        ;;
    esac
    shift
  done

  if [[ -n "$lines_override" && ! "$lines_override" =~ ^[0-9]+$ ]]; then
    die "logs --lines expects an integer"
  fi
  if [[ "$subcmd" == "path" && -n "$lines_override" ]]; then
    die "logs path does not accept --lines"
  fi

  local selected rows=""
  while IFS= read -r selected; do
    [[ -n "$selected" ]] || continue
    local path label tail_lines
    path="$(logs_stream_path "$selected")"
    label="$(logs_stream_label "$selected")"
    tail_lines="${lines_override:-$(logs_stream_default_lines "$selected")}"
    if [[ -n "$rows" ]]; then
      rows+=$'\n'
    fi
    rows+="${selected}"$'\t'"${label}"$'\t'"${path}"$'\t'"${tail_lines}"
  done < <(logs_selected_streams "$stream_spec")

  if [[ "$subcmd" == "follow" ]]; then
    logs_follow_output "$rows" "$json_output"
    return 0
  fi

  if [[ "$json_output" == "1" ]]; then
    printf '%s\n' "$rows" | logs_json "$subcmd"
    return 0
  fi

  case "$subcmd" in
    show|path)
      echo "Log paths"
      echo ""
      while IFS=$'\t' read -r selected label path tail_lines; do
        [[ -n "$selected" ]] || continue
        local status="missing"
        [[ -f "$path" ]] && status="present"
        printf "  %-16s %s (%s)\n" "${selected}:" "$path" "$status"
      done <<< "$rows"
      ;;
  esac

  case "$subcmd" in
    path)
      ;;
    show|tail)
      local first_block="1"
      while IFS=$'\t' read -r selected label path tail_lines; do
        [[ -n "$selected" ]] || continue
        if [[ "$first_block" == "1" ]]; then
          echo ""
          first_block="0"
        else
          echo ""
        fi
        echo "--- ${label} (tail ${tail_lines}) ---"
        if [[ -f "$path" ]]; then
          tail -n "$tail_lines" "$path" || true
        else
          echo "No ${label} log yet at: $path"
        fi
      done <<< "$rows"
      ;;
    *)
      logs_usage
      ;;
  esac

  echo ""
  echo "Next:"
  echo "  tmux-whisper status --preset compact"
  echo "  tmux-whisper history sessions 5"
  echo "  tmux-whisper bench 10"
}

changelog() {
  local f="$DICTATE_CONFIG_DIR/CHANGELOG.md"
  if [[ -f "$f" ]]; then
    cat "$f"
  else
    echo "No changelog yet at: $f"
  fi
}

config_set() {
  # Usage: config_set <path.like.this> <type:bool|int|string> <value>
  need python3
  config_ensure

  local key="${1:-}"
  local type="${2:-}"
  local value="${3:-}"
  local py_output rc parse_error
  [[ -n "$key" && -n "$type" ]] || die "config_set requires: <key> <type> <value>"

  set +e
  py_output="$(
    python3 - "$DICTATE_CONFIG_FILE" "$key" "$type" "$value" <<'PYEOF'
import os, sys, tomllib

path = os.path.expanduser(sys.argv[1])
key = sys.argv[2]
typ = sys.argv[3]
raw = sys.argv[4] if len(sys.argv) > 4 else ""

try:
  with open(path, "rb") as f:
    cfg = tomllib.load(f) or {}
except tomllib.TOMLDecodeError as exc:
  print("CONFIG_PARSE_ERROR\t" + str(exc).replace("\n", " "))
  raise SystemExit(2)

def ensure(obj, parts):
  cur = obj
  for p in parts[:-1]:
    nxt = cur.get(p)
    if not isinstance(nxt, dict):
      nxt = {}
      cur[p] = nxt
    cur = nxt
  return cur, parts[-1]

def parse_value(typ, raw):
  if typ == "bool":
    return raw.strip().lower() in ("1", "true", "yes", "on")
  if typ == "int":
    raw = raw.strip()
    return int(raw) if raw else None
  if typ == "string":
    return raw
  raise SystemExit(f"unknown type: {typ}")

parent, leaf = ensure(cfg, key.split("."))
val = parse_value(typ, raw)
if val is None:
  parent.pop(leaf, None)
else:
  parent[leaf] = val

def esc(s: str) -> str:
  return (
    s.replace("\\", "\\\\")
     .replace('"', '\\"')
     .replace("\n", "\\n")
     .replace("\r", "\\r")
     .replace("\t", "\\t")
  )

def fmt(v):
  if isinstance(v, bool):
    return "true" if v else "false"
  if isinstance(v, int):
    return str(v)
  if isinstance(v, float):
    return str(v)
  if isinstance(v, str):
    return f"\"{esc(v)}\""
  if isinstance(v, list):
    return "[" + ", ".join(fmt(x) for x in v) + "]"
  raise TypeError(type(v))

preferred_table_order = [
  "meta",
  "audio",
  "audio.sounds",
  "clean",
  "history",
  "whisper",
  "swift_parakeet",
  "postprocess",
  "postprocess.budget_profiles.long",
  "postprocess.budget_profiles.short",
  "inline",
  "tmux",
  "debug",
  "integrations.swiftbar",
  "ui.keybinds",
  "ui.icons",
]

preferred_key_order = {
  "meta": ["config_version"],
  "audio": ["source", "device_name", "mac_name", "iphone_name", "device_index", "silence_trim", "silence_trim_mode", "silence_threshold_db", "silence_min_ms", "silence_keep_ms"],
  "audio.sounds": ["cancel", "cancel_enabled", "enabled", "error", "error_enabled", "process", "process_enabled", "start", "start_enabled", "stop", "stop_enabled"],
  "clean": ["repeats_level"],
  "history": ["retention_days", "audio_retention_days"],
  "whisper": ["models_dir", "backend", "model", "threads", "beam_size", "best_of", "vad", "vad_model", "vad_threshold", "vad_min_speech_ms", "vad_min_silence_ms", "vad_speech_pad_ms"],
  "swift_parakeet": ["model_path", "model_version", "socket_path"],
  "postprocess": ["enabled", "llm", "max_tokens", "chunk_words", "budget_long_words_threshold"],
  "postprocess.budget_profiles.long": ["chunk_words", "llm", "max_tokens"],
  "postprocess.budget_profiles.short": ["chunk_words", "llm", "max_tokens"],
  "inline": ["autosend", "process_sound", "paste_target", "send_mode"],
  "tmux": ["autosend", "paste_target", "postprocess", "process_sound", "mode", "model", "send_mode"],
  "debug": ["keep_logs"],
  "integrations.swiftbar": ["enabled"],
  "ui.keybinds": ["tmux", "inline"],
  "ui.icons": [
    "recording","processing","ready","error",
    "base","code","long","email","chat","linkedin","twitter","cancel",
  ],
}

def split_tables(obj, prefix=""):
  if not isinstance(obj, dict):
    return
  scalars = {}
  tables = {}
  for k, v in obj.items():
    if isinstance(v, dict):
      tables[k] = v
    else:
      scalars[k] = v
  yield prefix, scalars
  for k in sorted(tables.keys()):
    nxt = f"{prefix}.{k}" if prefix else k
    yield from split_tables(tables[k], nxt)

tables = {}
for section, scalars in split_tables(cfg, ""):
  if scalars:
    tables[section] = scalars

def ordered_keys(section, scalars):
  pref = preferred_key_order.get(section, [])
  remaining = sorted([k for k in scalars.keys() if k not in pref])
  return [k for k in pref if k in scalars] + remaining

parts = [
  "# Tmux Whisper configuration (TOML)",
  "# Generated by `tmux-whisper`; safe to edit.",
  "",
]

# Root-level scalars (rare; include if present).
if "" in tables:
  for k in ordered_keys("", tables[""]):
    parts.append(f"{k} = {fmt(tables[''][k])}")
  parts.append("")

sections = [s for s in tables.keys() if s]
ordered_sections = []
for s in preferred_table_order:
  if s in sections:
    ordered_sections.append(s)
    sections.remove(s)
ordered_sections.extend(sorted(sections))

for s in ordered_sections:
  parts.append(f"[{s}]")
  for k in ordered_keys(s, tables[s]):
    parts.append(f"{k} = {fmt(tables[s][k])}")
  parts.append("")

os.makedirs(os.path.dirname(path), exist_ok=True)
with open(path, "w", encoding="utf-8") as f:
  f.write("\n".join(parts))
PYEOF
  )"
  rc=$?
  set -e

  if [[ "$rc" -ne 0 ]]; then
    if [[ "$py_output" == CONFIG_PARSE_ERROR$'\t'* ]]; then
      parse_error="${py_output#*$'\t'}"
      die "config TOML is invalid. Preview repair with tmux-whisper config repair --dry-run, then apply with tmux-whisper config repair. Parse error: $parse_error"
    fi
    [[ -n "$py_output" ]] && printf '%s\n' "$py_output" >&2
    return "$rc"
  fi
}

config_inspect_raw() {
  need python3
  python3 - "$DICTATE_CONFIG_FILE" "$DICTATE_CONFIG_SCHEMA_VERSION" <<'PYEOF'
import os, sys, tomllib

path = os.path.expanduser(sys.argv[1])
expected = int(sys.argv[2])
exists = os.path.isfile(path)
status = "missing"
label = "missing"
parse_error = ""

if exists:
  try:
    with open(path, "rb") as f:
      cfg = tomllib.load(f) or {}
    raw = cfg.get("meta", {}).get("config_version", "")
    if isinstance(raw, int):
      label = f"v{raw}"
      status = "ok" if raw == expected else "mismatch"
    else:
      label = "unset"
      status = "mismatch"
  except tomllib.TOMLDecodeError as exc:
    label = "invalid"
    status = "invalid"
    parse_error = str(exc).replace("\n", " ")

print(f"exists\t{1 if exists else 0}")
print(f"schema_label\t{label}")
print(f"schema_status\t{status}")
print(f"parse_error\t{parse_error}")
PYEOF
}

config_snapshot_rows() {
  need python3
  local default_cfg_text
  default_cfg_text="$(default_config_toml)"
  DEFAULT_CONFIG_TOML="$default_cfg_text" python3 - "$DICTATE_CONFIG_FILE" "$DICTATE_CONFIG_SCHEMA_VERSION" <<'PYEOF'
import os
import sys
import tomllib

path = os.path.expanduser(sys.argv[1])
expected = int(sys.argv[2])
default_cfg = tomllib.loads(os.environ["DEFAULT_CONFIG_TOML"])
exists = os.path.isfile(path)
cfg = {}
parse_error = ""
MISSING = object()

if exists:
    try:
        with open(path, "rb") as f:
            cfg = tomllib.load(f) or {}
    except tomllib.TOMLDecodeError as exc:
        parse_error = str(exc).replace("\n", " ")

def get(tree, dotted_path, default=MISSING):
    cur = tree
    for part in dotted_path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur

def get_effective(dotted_path):
    value = get(cfg, dotted_path, MISSING)
    if value is not MISSING:
        return value
    value = get(default_cfg, dotted_path, MISSING)
    if value is not MISSING:
        return value
    return None

raw_version = get(cfg, "meta.config_version", MISSING)
if parse_error:
    label = "invalid"
    status = "invalid"
elif exists:
    if isinstance(raw_version, int):
        label = f"v{raw_version}"
        status = "ok" if raw_version == expected else "mismatch"
    else:
        label = "unset"
        status = "mismatch"
else:
    label = "missing"
    status = "missing"

def fmt(value):
    if value is None:
        return ""
    if isinstance(value, bool):
        return "1" if value else "0"
    return str(value)

rows = [
    ("path", path),
    ("exists", "1" if exists else "0"),
    ("schema_label", label),
    ("schema_status", status),
    ("parse_error", parse_error),
    ("audio_source", get_effective("audio.source")),
    ("audio_device_name", get_effective("audio.device_name")),
    ("audio_mac_name", get_effective("audio.mac_name")),
    ("audio_iphone_name", get_effective("audio.iphone_name")),
    ("audio_device_index", get_effective("audio.device_index")),
    ("swift_parakeet_model_path", get_effective("swift_parakeet.model_path")),
    ("swift_parakeet_socket_path", get_effective("swift_parakeet.socket_path")),
    ("postprocess_enabled", get_effective("postprocess.enabled")),
    ("postprocess_llm", get_effective("postprocess.llm")),
    ("history_retention_days", get_effective("history.retention_days")),
    ("history_audio_retention_days", get_effective("history.audio_retention_days")),
    ("inline_autosend", get_effective("inline.autosend")),
    ("inline_process_sound", get_effective("inline.process_sound")),
    ("tmux_mode", get_effective("tmux.mode")),
    ("debug_keep_logs", get_effective("debug.keep_logs")),
]

for key, value in rows:
    print(f"{key}\t{fmt(value)}")
PYEOF
}

config_show_text() {
  local rows_input path exists label status parse_error
  local audio_source audio_device_name audio_mac_name audio_iphone_name audio_device_index
  local model_path socket_path postprocess_enabled postprocess_llm history_retention_days history_audio_retention_days inline_autosend inline_process_sound tmux_mode debug_keep_logs
  rows_input="$(config_snapshot_rows)"

  while IFS=$'\t' read -r key value; do
    case "$key" in
      path) path="$value" ;;
      exists) exists="$value" ;;
      schema_label) label="$value" ;;
      schema_status) status="$value" ;;
      parse_error) parse_error="$value" ;;
      audio_source) audio_source="$value" ;;
      audio_device_name) audio_device_name="$value" ;;
      audio_mac_name) audio_mac_name="$value" ;;
      audio_iphone_name) audio_iphone_name="$value" ;;
      audio_device_index) audio_device_index="$value" ;;
      swift_parakeet_model_path) model_path="$value" ;;
      swift_parakeet_socket_path) socket_path="$value" ;;
      postprocess_enabled) postprocess_enabled="$value" ;;
      postprocess_llm) postprocess_llm="$value" ;;
      history_retention_days) history_retention_days="$value" ;;
      history_audio_retention_days) history_audio_retention_days="$value" ;;
      inline_autosend) inline_autosend="$value" ;;
      inline_process_sound) inline_process_sound="$value" ;;
      tmux_mode) tmux_mode="$value" ;;
      debug_keep_logs) debug_keep_logs="$value" ;;
    esac
  done <<<"$rows_input"

  config_show_text_value() {
    local value="${1:-}"
    if [[ -z "$value" ]]; then
      printf '%s\n' "<unset>"
    else
      printf '%s\n' "$value"
    fi
  }

  config_show_text_bool() {
    if bool_is_on "${1:-0}"; then
      printf '%s\n' "on"
    else
      printf '%s\n' "off"
    fi
  }

  echo "Config path: $path $([[ "$exists" == "1" ]] && echo '(present)' || echo '(missing)')"
  echo "Config schema: $label (expected v${DICTATE_CONFIG_SCHEMA_VERSION}, status=$status)"
  [[ -n "$parse_error" ]] && echo "Parse error: $parse_error"
  echo ""
  echo "Current values:"
  echo "  audio.source: $(config_show_text_value "$audio_source")"
  echo "  audio.device_name: $(config_show_text_value "$audio_device_name")"
  echo "  audio.mac_name: $(config_show_text_value "$audio_mac_name")"
  echo "  audio.iphone_name: $(config_show_text_value "$audio_iphone_name")"
  echo "  audio.device_index: $(config_show_text_value "$audio_device_index")"
  echo "  swift_parakeet.model_path: $(config_show_text_value "$model_path")"
  echo "  swift_parakeet.socket_path: $(config_show_text_value "$socket_path")"
  echo "  postprocess.enabled: $(config_show_text_bool "$postprocess_enabled")"
  echo "  postprocess.llm: $(config_show_text_value "$postprocess_llm")"
  echo "  history.retention_days: $(config_show_text_value "$history_retention_days")"
  echo "  history.audio_retention_days: $(config_show_text_value "$history_audio_retention_days")"
  echo "  inline.autosend: $(config_show_text_bool "$inline_autosend")"
  echo "  inline.process_sound: $(config_show_text_bool "$inline_process_sound")"
  echo "  tmux.mode: $(config_show_text_value "$tmux_mode")"
  echo "  debug.keep_logs: $(config_show_text_bool "$debug_keep_logs")"
  echo ""
  echo "Commands:"
  echo "  tmux-whisper config path"
  echo "  tmux-whisper config get audio.source"
  echo "  tmux-whisper config defaults"
  echo "  tmux-whisper config repair --dry-run"
  echo "  tmux-whisper config repair"
}

config_show_json() {
  local rows_input
  rows_input="$(config_snapshot_rows)"
  CONFIG_SNAPSHOT_ROWS="$rows_input" python3 - "$DICTATE_CONFIG_SCHEMA_VERSION" <<'PYEOF'
import json
import os
import sys

rows = {}
for raw_line in os.environ.get("CONFIG_SNAPSHOT_ROWS", "").splitlines():
    if not raw_line:
        continue
    key, value = raw_line.split("\t", 1)
    rows[key] = value

def bool_value(key):
    return rows.get(key, "0") == "1"

def nullable(key):
    value = rows.get(key, "")
    return value if value != "" else None

print(json.dumps({
    "command": "config",
    "subcommand": "show",
    "config_path": rows.get("path", ""),
    "config_exists": bool_value("exists"),
    "schema": {
        "expected": f"v{sys.argv[1]}",
        "label": rows.get("schema_label", "missing"),
        "status": rows.get("schema_status", "missing"),
    },
    "parse_error": rows.get("parse_error", ""),
    "effective": {
        "audio": {
            "source": nullable("audio_source"),
            "device_name": nullable("audio_device_name"),
            "mac_name": nullable("audio_mac_name"),
            "iphone_name": nullable("audio_iphone_name"),
            "device_index": int(rows["audio_device_index"]) if rows.get("audio_device_index", "") else None,
        },
        "swift_parakeet": {
            "model_path": nullable("swift_parakeet_model_path"),
            "socket_path": nullable("swift_parakeet_socket_path"),
        },
        "postprocess": {
            "enabled": bool_value("postprocess_enabled"),
            "llm": nullable("postprocess_llm"),
        },
        "history": {
            "retention_days": int(rows["history_retention_days"]) if rows.get("history_retention_days", "") else None,
            "audio_retention_days": int(rows["history_audio_retention_days"]) if rows.get("history_audio_retention_days", "") else None,
        },
        "inline": {
            "autosend": bool_value("inline_autosend"),
            "process_sound": bool_value("inline_process_sound"),
        },
        "tmux": {
            "mode": nullable("tmux_mode"),
        },
        "debug": {
            "keep_logs": bool_value("debug_keep_logs"),
        },
    },
}, indent=2, sort_keys=True))
PYEOF
}

config_path_json() {
  local rows_input
  rows_input="$(config_snapshot_rows)"
  CONFIG_SNAPSHOT_ROWS="$rows_input" python3 - <<'PYEOF'
import json
import os

rows = {}
for raw_line in os.environ.get("CONFIG_SNAPSHOT_ROWS", "").splitlines():
    if not raw_line:
        continue
    key, value = raw_line.split("\t", 1)
    rows[key] = value

print(json.dumps({
    "command": "config",
    "subcommand": "path",
    "config_path": rows.get("path", ""),
    "config_exists": rows.get("exists", "0") == "1",
}, indent=2, sort_keys=True))
PYEOF
}

config_get_emit() {
  local query_path="${1:-}"
  local render="${2:-text}"
  [[ -n "$query_path" ]] || die "usage: tmux-whisper config get <path> [--json]"
  need python3

  local default_cfg_text
  default_cfg_text="$(default_config_toml)"
  DEFAULT_CONFIG_TOML="$default_cfg_text" python3 - "$DICTATE_CONFIG_FILE" "$DICTATE_CONFIG_SCHEMA_VERSION" "$query_path" "$render" <<'PYEOF'
import json
import os
import sys
import tomllib

path = os.path.expanduser(sys.argv[1])
expected = int(sys.argv[2])
query_path = sys.argv[3]
render = sys.argv[4]
default_cfg = tomllib.loads(os.environ["DEFAULT_CONFIG_TOML"])
exists = os.path.isfile(path)
cfg = {}
parse_error = ""
MISSING = object()

if exists:
    try:
        with open(path, "rb") as f:
            cfg = tomllib.load(f) or {}
    except tomllib.TOMLDecodeError as exc:
        parse_error = str(exc).replace("\n", " ")

def get(tree, dotted_path, default=MISSING):
    cur = tree
    for part in dotted_path.split("."):
        if not isinstance(cur, dict) or part not in cur:
            return default
        cur = cur[part]
    return cur

raw_version = get(cfg, "meta.config_version", MISSING)
if parse_error:
    label = "invalid"
    status = "invalid"
elif exists:
    if isinstance(raw_version, int):
        label = f"v{raw_version}"
        status = "ok" if raw_version == expected else "mismatch"
    else:
        label = "unset"
        status = "mismatch"
else:
    label = "missing"
    status = "missing"

file_value = get(cfg, query_path, MISSING)
default_value = get(default_cfg, query_path, MISSING)

if file_value is not MISSING:
    source = "file"
    found = True
    value = file_value
elif default_value is not MISSING:
    source = "default"
    found = True
    value = default_value
else:
    source = "unset"
    found = False
    value = None

def value_type(input_value):
    if input_value is None:
        return "null"
    if isinstance(input_value, bool):
        return "boolean"
    if isinstance(input_value, int):
        return "integer"
    if isinstance(input_value, float):
        return "number"
    if isinstance(input_value, str):
        return "string"
    if isinstance(input_value, list):
        return "array"
    if isinstance(input_value, dict):
        return "object"
    return type(input_value).__name__

payload = {
    "command": "config",
    "subcommand": "get",
    "path": query_path,
    "config_path": path,
    "config_exists": exists,
    "schema": {
        "expected": f"v{expected}",
        "label": label,
        "status": status,
    },
    "parse_error": parse_error,
    "found": found,
    "source": source,
    "value_type": value_type(value),
    "value": value,
}

if render == "json":
    print(json.dumps(payload, indent=2, sort_keys=True))
else:
    if found:
        print(f"{query_path} = {json.dumps(value, ensure_ascii=False)}")
    else:
        print(f"{query_path} = <unset>")
    print(f"source: {source}")
    print(f"config path: {path}")
    if parse_error:
        print(f"parse error: {parse_error}")
PYEOF
}

config_get_text() {
  config_get_emit "${1:-}" "text"
}

config_get_json() {
  config_get_emit "${1:-}" "json"
}

config_repair() {
  local dry_run=0
  if [[ "${1:-}" == "--dry-run" ]]; then
    dry_run=1
    shift
  fi
  [[ "$#" -eq 0 ]] || die "usage: tmux-whisper config repair [--dry-run]"
  need python3

  local report
  local default_cfg_text
  default_cfg_text="$(default_config_toml)"
  report="$(
    DEFAULT_CONFIG_TOML="$default_cfg_text" python3 - "$DICTATE_CONFIG_FILE" "$DICTATE_CONFIG_SCHEMA_VERSION" "$dry_run" <<'PYEOF'
import copy
import os
import sys
import tomllib
from datetime import datetime

path = os.path.expanduser(sys.argv[1])
expected = int(sys.argv[2])
dry_run = sys.argv[3] == "1"
default_toml = os.environ["DEFAULT_CONFIG_TOML"]
default_cfg = tomllib.loads(default_toml)

def scalar_type_matches(current, default):
  if isinstance(default, bool):
    return isinstance(current, bool)
  if isinstance(default, int):
    return isinstance(current, int) and not isinstance(current, bool)
  if isinstance(default, str):
    return isinstance(current, str)
  return isinstance(current, type(default))

def merge_defaults(defaults, current, prefix=""):
  added = []
  reset = []
  if not isinstance(defaults, dict):
    return copy.deepcopy(defaults), added, reset

  result = {}
  if isinstance(current, dict):
    for key, value in current.items():
      if key not in defaults:
        result[key] = value

  for key, default_value in defaults.items():
    key_path = f"{prefix}.{key}" if prefix else key
    if not isinstance(current, dict) or key not in current:
      result[key] = copy.deepcopy(default_value)
      added.append(key_path)
      continue
    current_value = current[key]
    if isinstance(default_value, dict):
      if isinstance(current_value, dict):
        merged_value, sub_added, sub_reset = merge_defaults(default_value, current_value, key_path)
        result[key] = merged_value
        added.extend(sub_added)
        reset.extend(sub_reset)
      else:
        result[key] = copy.deepcopy(default_value)
        reset.append(key_path)
      continue
    if scalar_type_matches(current_value, default_value):
      result[key] = current_value
    else:
      result[key] = copy.deepcopy(default_value)
      reset.append(key_path)
  return result, added, reset

def esc(s: str) -> str:
  return (
    s.replace("\\", "\\\\")
     .replace('"', '\\"')
     .replace("\n", "\\n")
     .replace("\r", "\\r")
     .replace("\t", "\\t")
  )

def fmt(v):
  if isinstance(v, bool):
    return "true" if v else "false"
  if isinstance(v, int):
    return str(v)
  if isinstance(v, float):
    return str(v)
  if isinstance(v, str):
    return f"\"{esc(v)}\""
  if isinstance(v, list):
    return "[" + ", ".join(fmt(x) for x in v) + "]"
  raise TypeError(type(v))

preferred_table_order = [
  "meta",
  "audio",
  "audio.sounds",
  "clean",
  "history",
  "whisper",
  "swift_parakeet",
  "postprocess",
  "postprocess.budget_profiles.long",
  "postprocess.budget_profiles.short",
  "inline",
  "tmux",
  "debug",
  "integrations.swiftbar",
  "ui.keybinds",
  "ui.icons",
]

preferred_key_order = {
  "meta": ["config_version"],
  "audio": ["source", "device_name", "mac_name", "iphone_name", "device_index", "silence_trim", "silence_trim_mode", "silence_threshold_db", "silence_min_ms", "silence_keep_ms"],
  "audio.sounds": ["cancel", "cancel_enabled", "enabled", "error", "error_enabled", "process", "process_enabled", "start", "start_enabled", "stop", "stop_enabled"],
  "clean": ["repeats_level"],
  "history": ["retention_days", "audio_retention_days"],
  "whisper": ["models_dir", "backend", "model", "threads", "beam_size", "best_of", "vad", "vad_model", "vad_threshold", "vad_min_speech_ms", "vad_min_silence_ms", "vad_speech_pad_ms"],
  "swift_parakeet": ["model_path", "model_version", "socket_path"],
  "postprocess": ["enabled", "llm", "max_tokens", "chunk_words", "budget_long_words_threshold"],
  "postprocess.budget_profiles.long": ["chunk_words", "llm", "max_tokens"],
  "postprocess.budget_profiles.short": ["chunk_words", "llm", "max_tokens"],
  "inline": ["autosend", "process_sound", "paste_target", "send_mode"],
  "tmux": ["autosend", "paste_target", "postprocess", "process_sound", "mode", "model", "send_mode"],
  "debug": ["keep_logs"],
  "integrations.swiftbar": ["enabled"],
  "ui.keybinds": ["tmux", "inline"],
  "ui.icons": ["recording", "processing", "ready", "error", "base", "code", "long", "email", "chat", "linkedin", "twitter", "cancel"],
}

def split_tables(obj, prefix=""):
  if not isinstance(obj, dict):
    return
  scalars = {}
  tables = {}
  for k, v in obj.items():
    if isinstance(v, dict):
      tables[k] = v
    else:
      scalars[k] = v
  yield prefix, scalars
  for k in sorted(tables.keys()):
    nxt = f"{prefix}.{k}" if prefix else k
    yield from split_tables(tables[k], nxt)

def render_toml(cfg):
  tables = {}
  for section, scalars in split_tables(cfg, ""):
    if scalars:
      tables[section] = scalars

  def ordered_keys(section, scalars):
    pref = preferred_key_order.get(section, [])
    remaining = sorted([k for k in scalars.keys() if k not in pref])
    return [k for k in pref if k in scalars] + remaining

  parts = [
    "# Tmux Whisper configuration (TOML)",
    "# Generated by `tmux-whisper`; safe to edit.",
    "",
  ]

  if "" in tables:
    for key in ordered_keys("", tables[""]):
      parts.append(f"{key} = {fmt(tables[''][key])}")
    parts.append("")

  sections = [s for s in tables.keys() if s]
  ordered_sections = []
  for section in preferred_table_order:
    if section in sections:
      ordered_sections.append(section)
      sections.remove(section)
  ordered_sections.extend(sorted(sections))

  for section in ordered_sections:
    parts.append(f"[{section}]")
    for key in ordered_keys(section, tables[section]):
      parts.append(f"{key} = {fmt(tables[section][key])}")
    parts.append("")

  return "\n".join(parts)

exists = os.path.isfile(path)
current_cfg = {}
current_status = "missing"
current_label = "missing"
parse_error = ""
action = "noop"
backup_path = ""

if exists:
  try:
    with open(path, "rb") as f:
      current_cfg = tomllib.load(f) or {}
    raw = current_cfg.get("meta", {}).get("config_version", "")
    if isinstance(raw, int):
      current_label = f"v{raw}"
      current_status = "ok" if raw == expected else "mismatch"
    else:
      current_label = "unset"
      current_status = "mismatch"
  except tomllib.TOMLDecodeError as exc:
    parse_error = str(exc).replace("\n", " ")
    current_cfg = None
    current_label = "invalid"
    current_status = "invalid"

added = []
reset = []
if current_cfg is None:
  merged = copy.deepcopy(default_cfg)
  action = "reset-invalid"
  reset = ["config.toml"]
elif not exists:
  merged = copy.deepcopy(default_cfg)
  action = "create"
else:
  merged, added, reset = merge_defaults(default_cfg, current_cfg)

if not isinstance(merged.get("meta"), dict):
  merged["meta"] = {}
  if "meta" not in reset:
    reset.append("meta")
if merged["meta"].get("config_version") != expected:
  if "meta.config_version" not in reset and "meta.config_version" not in added:
    reset.append("meta.config_version")
  merged["meta"]["config_version"] = expected

changed = (not exists) or current_cfg is None or (current_cfg != merged)
result_label = f"v{expected}"

if changed and not dry_run:
  os.makedirs(os.path.dirname(path), exist_ok=True)
  if exists:
    backup_path = f"{path}.bak.{datetime.now().strftime('%Y%m%d-%H%M%S')}"
    with open(path, "rb") as src, open(backup_path, "wb") as dst:
      dst.write(src.read())
  with open(path, "w", encoding="utf-8") as f:
    f.write(render_toml(merged))
elif not changed:
  action = "noop"

if changed and action == "noop":
  action = "repair"

preview_added = ", ".join(added[:5])
preview_reset = ", ".join(reset[:5])

print(f"action\t{action}")
print(f"changed\t{1 if changed else 0}")
print(f"backup\t{backup_path}")
print(f"current_label\t{current_label}")
print(f"current_status\t{current_status}")
print(f"result_label\t{result_label}")
print(f"added_count\t{len(added)}")
print(f"reset_count\t{len(reset)}")
print(f"added_preview\t{preview_added}")
print(f"reset_preview\t{preview_reset}")
print(f"parse_error\t{parse_error}")
PYEOF
  )"

  local action changed backup current_label current_status result_label added_count reset_count added_preview reset_preview parse_error
  action="$(printf "%s\n" "$report" | sed -n 's/^action\t//p')"
  changed="$(printf "%s\n" "$report" | sed -n 's/^changed\t//p')"
  backup="$(printf "%s\n" "$report" | sed -n 's/^backup\t//p')"
  current_label="$(printf "%s\n" "$report" | sed -n 's/^current_label\t//p')"
  current_status="$(printf "%s\n" "$report" | sed -n 's/^current_status\t//p')"
  result_label="$(printf "%s\n" "$report" | sed -n 's/^result_label\t//p')"
  added_count="$(printf "%s\n" "$report" | sed -n 's/^added_count\t//p')"
  reset_count="$(printf "%s\n" "$report" | sed -n 's/^reset_count\t//p')"
  added_preview="$(printf "%s\n" "$report" | sed -n 's/^added_preview\t//p')"
  reset_preview="$(printf "%s\n" "$report" | sed -n 's/^reset_preview\t//p')"
  parse_error="$(printf "%s\n" "$report" | sed -n 's/^parse_error\t//p')"

  if [[ "$changed" != "1" ]]; then
    echo "Config repair: no changes needed ($current_label, status=$current_status)"
    return 0
  fi

  if [[ "$dry_run" == "1" ]]; then
    echo "Config repair dry-run: $current_label/$current_status -> $result_label"
  else
    echo "Config repair: $current_label/$current_status -> $result_label"
  fi
  case "$action" in
    create) echo "Action: create default config" ;;
    reset-invalid) echo "Action: replace invalid TOML with canonical defaults" ;;
    repair) echo "Action: merge missing defaults and normalize schema version" ;;
  esac
  if [[ "${added_count:-0}" -gt 0 ]]; then
    echo "Added defaults: $added_count${added_preview:+ ($added_preview)}"
  fi
  if [[ "${reset_count:-0}" -gt 0 ]]; then
    echo "Reset fields: $reset_count${reset_preview:+ ($reset_preview)}"
  fi
  if [[ -n "$parse_error" ]]; then
    echo "Parse error: $parse_error"
  fi
  if [[ -n "$backup" ]]; then
    echo "Backup: $backup"
  fi
}

manage_config() {
  local json_output="0"
  local args=()
  local arg

  for arg in "$@"; do
    if [[ "$arg" == "--json" ]]; then
      json_output="1"
    else
      args+=("$arg")
    fi
  done

  local action="${args[0]:-show}"
  case "$action" in
    ""|show|status)
      [[ "${#args[@]}" -le 1 ]] || die "usage: tmux-whisper config [show|path|get <path>|defaults|repair [--dry-run]] [--json]"
      if [[ "$json_output" == "1" ]]; then
        config_show_json
      else
        config_show_text
      fi
      ;;
    path)
      [[ "${#args[@]}" -eq 1 ]] || die "usage: tmux-whisper config path [--json]"
      if [[ "$json_output" == "1" ]]; then
        config_path_json
      else
        echo "$DICTATE_CONFIG_FILE"
      fi
      ;;
    get)
      [[ "${#args[@]}" -eq 2 ]] || die "usage: tmux-whisper config get <path> [--json]"
      if [[ "$json_output" == "1" ]]; then
        config_get_json "${args[1]}"
      else
        config_get_text "${args[1]}"
      fi
      ;;
    defaults|default)
      [[ "$json_output" == "0" ]] || die "config defaults does not accept --json"
      [[ "${#args[@]}" -eq 1 ]] || die "usage: tmux-whisper config defaults"
      default_config_toml
      ;;
    repair)
      [[ "$json_output" == "0" ]] || die "config repair does not accept --json"
      config_repair "${args[@]:1}"
      ;;
    *)
      die "usage: tmux-whisper config [show|path|get <path>|defaults|repair [--dry-run]] [--json]"
      ;;
  esac
}

log_transcribe_event() {
  local message="${1:-}"
  [[ -n "$message" ]] || return 0
  if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
    printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >>"$TRANSCRIBE_LOG" 2>/dev/null || true
  fi
}

log_record_event() {
  local message="${1:-}"
  local record_log_path="${2:-${RECORD_LOG:-}}"
  [[ -n "$message" && -n "$record_log_path" ]] || return 0
  printf '[%s] %s\n' "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$message" >>"$record_log_path" 2>/dev/null || true
}

log_audio_cache_note_if_any() {
  local audio_cache_note="${1:-}"
  local record_log_path="${2:-${RECORD_LOG:-}}"
  [[ -n "$audio_cache_note" ]] || return 0
  log_record_event "audio cache: $audio_cache_note" "$record_log_path"
}

resolve_transcribe_backend() {
  printf "%s\n" "swift_parakeet"
}

resolve_swift_parakeet_socket_path() {
  local socket_path="${DICTATE_SWIFT_PARAKEET_SOCKET_PATH:-${CFG_SWIFT_PARAKEET_SOCKET_PATH:-$DICTATE_CONFIG_DIR/.cache/tmux-whisperd.sock}}"
  expand_path "$socket_path"
}

resolve_swift_parakeet_model_path() {
  local explicit="${DICTATE_SWIFT_PARAKEET_MODEL_PATH:-${CFG_SWIFT_PARAKEET_MODEL_PATH:-}}"
  local candidate

  if [[ -n "$explicit" ]]; then
    expand_path "$explicit"
    return 0
  fi

  for candidate in \
    "$DEFAULT_SWIFT_PARAKEET_MODELS_DIR/parakeet-tdt-0.6b-v3-coreml" \
    "$DEFAULT_SWIFT_PARAKEET_MODELS_DIR/parakeet-tdt-0.6b-v2-coreml"
  do
    [[ -d "$candidate" ]] || continue
    printf "%s\n" "$candidate"
    return 0
  done

  return 1
}

resolve_swift_parakeet_model_version() {
  local explicit="${DICTATE_SWIFT_PARAKEET_MODEL_VERSION:-${CFG_SWIFT_PARAKEET_MODEL_VERSION:-}}"
  local model_path="${1:-}"
  local base_name=""

  if [[ -n "$explicit" ]]; then
    explicit="$(printf "%s" "$explicit" | tr '[:upper:]' '[:lower:]' | tr -d '\r\n' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    case "$explicit" in
      v2|v3)
        printf "%s\n" "$explicit"
        return 0
        ;;
    esac
  fi

  base_name="$(basename "$model_path" 2>/dev/null || true)"
  case "$base_name" in
    *v2*|*V2*)
      printf "%s\n" "v2"
      ;;
    *v3*|*V3*)
      printf "%s\n" "v3"
      ;;
    *)
      printf "%s\n" "v3"
      ;;
  esac
}

current_transcribe_model_label() {
  local model_path=""
  model_path="$(resolve_swift_parakeet_model_path 2>/dev/null || true)"
  if [[ -n "$model_path" ]]; then
    basename "$model_path"
  else
    printf "%s\n" "parakeet-unresolved"
  fi
}

resolve_tmux_whisperd_root() {
  local script_dir candidate
  script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

  for candidate in \
    "${DICTATE_TMUX_WHISPERD_ROOT:-}" \
    "$script_dir/../tmux-whisperd" \
    "$XDG_DATA_HOME/tmux-whisper/native/tmux-whisperd"
  do
    [[ -n "$candidate" ]] || continue
    candidate="$(expand_path "$candidate")"
    [[ -f "$candidate/Package.swift" ]] || continue
    printf "%s\n" "$candidate"
    return 0
  done

  return 1
}

ensure_tmux_whisperd_binary() {
  local binary="${DICTATE_TMUX_WHISPERD_BIN:-}"
  local root=""

  if [[ -n "$binary" ]]; then
    binary="$(expand_path "$binary")"
    [[ -x "$binary" ]] || return 1
    printf "%s\n" "$binary"
    return 0
  fi

  root="$(resolve_tmux_whisperd_root 2>/dev/null || true)"
  [[ -n "$root" ]] || return 1

  binary="$root/.build/release/tmux-whisperd"
  if [[ -x "$binary" ]]; then
    printf "%s\n" "$binary"
    return 0
  fi

  command -v swift >/dev/null 2>&1 || return 1
  log_transcribe_event "swift_parakeet: building tmux-whisperd in $root"
  (
    cd "$root"
    swift build -c release --product tmux-whisperd
  ) >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1 || return 1

  [[ -x "$binary" ]] || return 1
  printf "%s\n" "$binary"
}

swift_parakeet_request_json() {
  local op="${1:-ping}"
  local socket_path="${2:-}"
  local wav_path="${3:-}"
  local language="${4:-en}"
  local flow="${5:-inline}"
  local model_path="${6:-}"
  local model_version="${7:-}"

  python3 - "$socket_path" "$op" "$wav_path" "$language" "$flow" "$model_path" "$model_version" <<'PYEOF'
import json
import os
import socket
import sys
import uuid

socket_path, op, wav_path, language, flow, model_path, model_version = sys.argv[1:8]

payload = {
    "id": str(uuid.uuid4()),
    "op": op,
}
if wav_path:
    payload["wav_path"] = wav_path
if language:
    payload["language"] = language
if flow:
    payload["flow"] = flow
if model_path:
    payload["model_path"] = model_path
if model_version:
    payload["model_version"] = model_version

timeout = float(os.environ.get("DICTATE_SWIFT_PARAKEET_TIMEOUT_SECONDS", "600"))

try:
    client = socket.socket(socket.AF_UNIX, socket.SOCK_STREAM)
    client.settimeout(timeout)
    client.connect(socket_path)
    client.sendall(json.dumps(payload).encode("utf-8") + b"\n")
    chunks = []
    while True:
        data = client.recv(4096)
        if not data:
            break
        chunks.append(data)
        if b"\n" in data:
            break
    client.close()
    raw = b"".join(chunks).split(b"\n", 1)[0].decode("utf-8", "replace").strip()
    if not raw:
        raise RuntimeError("empty daemon response")
    json.loads(raw)
    print(raw)
except Exception as exc:
    print(json.dumps({
        "id": "local-error",
        "ok": False,
        "engine": "swift_parakeet",
        "error_code": "socket_error",
        "message": str(exc),
    }))
PYEOF
}

daemon_response_to_shell() {
  local json_payload="${1:-}"
  python3 - "$json_payload" <<'PYEOF'
import json
import shlex
import sys

payload = json.loads(sys.argv[1])

def q(value):
    if value is None:
        value = ""
    return shlex.quote(str(value))

ok = payload.get("ok", False)
print(f"RESP_OK={q('1' if ok else '0')}")
print(f"RESP_TEXT={q(payload.get('text', ''))}")
print(f"RESP_ENGINE={q(payload.get('engine', ''))}")
print(f"RESP_MODEL={q(payload.get('model', ''))}")
print(f"RESP_DURATION_MS={q(payload.get('duration_ms', ''))}")
print(f"RESP_ERROR_CODE={q(payload.get('error_code', ''))}")
print(f"RESP_MESSAGE={q(payload.get('message', ''))}")
PYEOF
}

swift_parakeet_ping() {
  local socket_path="${1:-}"
  local response shell_vars
  [[ -S "$socket_path" ]] || return 1
  response="$(swift_parakeet_request_json "ping" "$socket_path")" || return 1
  shell_vars="$(daemon_response_to_shell "$response" 2>/dev/null || true)"
  [[ -n "$shell_vars" ]] || return 1
  eval "$shell_vars"
  [[ "${RESP_OK:-0}" == "1" ]]
}

ensure_swift_parakeet_daemon() {
  local socket_path="${1:-}"
  local binary=""
  local attempt

  if swift_parakeet_ping "$socket_path"; then
    return 0
  fi

  rm -f "$socket_path" 2>/dev/null || true
  binary="$(ensure_tmux_whisperd_binary 2>/dev/null || true)"
  [[ -n "$binary" ]] || return 1

  mkdir -p "$(dirname "$socket_path")" 2>/dev/null || true
  log_transcribe_event "swift_parakeet: starting daemon at $socket_path"
  nohup "$binary" serve --socket "$socket_path" >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1 </dev/null &

  for attempt in {1..40}; do
    swift_parakeet_ping "$socket_path" && return 0
    sleep 0.1
  done

  return 1
}

maybe_warmup_swift_parakeet_in_background() {
  local backend_requested socket_path
  backend_requested="$(resolve_transcribe_backend)"
  [[ "$backend_requested" == "swift_parakeet" ]] || return 0

  socket_path="$(resolve_swift_parakeet_socket_path 2>/dev/null || true)"

  (
    trap '' HUP
    if [[ -n "$socket_path" ]] && swift_parakeet_ping "$socket_path"; then
      exit 0
    fi
    warmup_backend --best-effort >/dev/null 2>>"${TRANSCRIBE_LOG:-/dev/null}" || true
  ) &
}

create_silent_wav() {
  local wav_path="${1:-}"
  local duration_ms="${2:-160}"
  [[ -n "$wav_path" ]] || return 1
  [[ "$duration_ms" =~ ^[0-9]+$ ]] || duration_ms=160

  python3 - "$wav_path" "$duration_ms" <<'PYEOF'
import sys
import wave

path = sys.argv[1]
duration_ms = max(1, int(sys.argv[2]))
sample_rate = 16000
samples = max(1, int(sample_rate * duration_ms / 1000))

with wave.open(path, "wb") as wav_file:
    wav_file.setnchannels(1)
    wav_file.setsampwidth(2)
    wav_file.setframerate(sample_rate)
    wav_file.writeframes(b"\x00\x00" * samples)
PYEOF
}

swift_parakeet_prime_cli() {
  local socket_path=""
  local model_path=""
  local model_version=""
  local response=""
  local shell_vars=""
  local tmp_wav=""
  local prime_ms="${DICTATE_WARMUP_PRIME_MS:-1000}"

  # FluidAudio warmup transcribes require at least 1 second of 16kHz audio.
  if [[ "$prime_ms" =~ ^[0-9]+$ ]]; then
    prime_ms=$((10#$prime_ms))
  fi
  if [[ ! "$prime_ms" =~ ^[0-9]+$ ]] || (( prime_ms < 1000 )); then
    prime_ms=1000
  fi

  socket_path="$(resolve_swift_parakeet_socket_path)"
  model_path="$(resolve_swift_parakeet_model_path 2>/dev/null || true)"
  [[ -n "$model_path" ]] || return 1
  model_version="$(resolve_swift_parakeet_model_version "$model_path")"

  ensure_swift_parakeet_daemon "$socket_path" || return 1
  tmp_wav="$(mktemp "${TMPDIR:-/tmp}/tmux-whisper-prime.XXXXXX.wav" 2>/dev/null || true)"
  [[ -n "$tmp_wav" ]] || return 1

  if ! create_silent_wav "$tmp_wav" "$prime_ms"; then
    rm -f "$tmp_wav" 2>/dev/null || true
    return 1
  fi

  response="$(swift_parakeet_request_json "transcribe" "$socket_path" "$tmp_wav" "en" "warmup" "$model_path" "$model_version")" || true
  rm -f "$tmp_wav" 2>/dev/null || true
  [[ -n "$response" ]] || return 1

  shell_vars="$(daemon_response_to_shell "$response" 2>/dev/null || true)"
  [[ -n "$shell_vars" ]] || return 1
  eval "$shell_vars"

  if [[ "${RESP_OK:-0}" != "1" ]]; then
    log_transcribe_event "swift_parakeet: daemon prime error ${RESP_ERROR_CODE:-unknown}: ${RESP_MESSAGE:-unknown error}"
    return 1
  fi

  log_transcribe_event "swift_parakeet: prime transcribe ok (${RESP_DURATION_MS:-0}ms)"
  DICTATE_LAST_BACKEND_ENGINE="${RESP_ENGINE:-swift_parakeet}"
  DICTATE_LAST_BACKEND_MODEL="${RESP_MODEL:-$(basename "$model_path")}"
  return 0
}

maybe_prime_swift_parakeet_after_warmup() {
  local enabled="${DICTATE_WARMUP_PRIME_TRANSCRIBE:-1}"
  if ! bool_is_on "$enabled"; then
    return 0
  fi
  swift_parakeet_prime_cli || true
}

swift_parakeet_warmup_cli() {
  local socket_path=""
  local model_path=""
  local model_version=""
  local response=""
  local shell_vars=""

  socket_path="$(resolve_swift_parakeet_socket_path)"
  model_path="$(resolve_swift_parakeet_model_path 2>/dev/null || true)"
  [[ -n "$model_path" ]] || return 1
  model_version="$(resolve_swift_parakeet_model_version "$model_path")"

  ensure_swift_parakeet_daemon "$socket_path" || return 1
  response="$(swift_parakeet_request_json "warmup" "$socket_path" "" "en" "warmup" "$model_path" "$model_version")" || return 1
  shell_vars="$(daemon_response_to_shell "$response" 2>/dev/null || true)"
  [[ -n "$shell_vars" ]] || return 1
  eval "$shell_vars"

  if [[ "${RESP_OK:-0}" != "1" ]]; then
    log_transcribe_event "swift_parakeet: daemon warmup error ${RESP_ERROR_CODE:-unknown}: ${RESP_MESSAGE:-unknown error}"
    return 1
  fi

  DICTATE_LAST_BACKEND_ENGINE="${RESP_ENGINE:-swift_parakeet}"
  DICTATE_LAST_BACKEND_MODEL="${RESP_MODEL:-$(basename "$model_path")}"
  printf "%s\t%s\t%s\n" "${RESP_MODEL:-$(basename "$model_path")}" "${RESP_DURATION_MS:-0}" "${RESP_MESSAGE:-warmed}"
}

transcribe_swift_parakeet_cli() {
  local wav="$1"
  local language="${2:-en}"
  local flow="${3:-inline}"
  local socket_path=""
  local model_path=""
  local model_version=""
  local response=""
  local shell_vars=""

  socket_path="$(resolve_swift_parakeet_socket_path)"
  model_path="$(resolve_swift_parakeet_model_path 2>/dev/null || true)"
  [[ -n "$model_path" ]] || return 1
  model_version="$(resolve_swift_parakeet_model_version "$model_path")"

  ensure_swift_parakeet_daemon "$socket_path" || return 1
  response="$(swift_parakeet_request_json "transcribe" "$socket_path" "$wav" "$language" "$flow" "$model_path" "$model_version")" || return 1
  shell_vars="$(daemon_response_to_shell "$response" 2>/dev/null || true)"
  [[ -n "$shell_vars" ]] || return 1
  eval "$shell_vars"

  if [[ "${RESP_OK:-0}" != "1" ]]; then
    log_transcribe_event "swift_parakeet: daemon error ${RESP_ERROR_CODE:-unknown}: ${RESP_MESSAGE:-unknown error}"
    return 1
  fi

  DICTATE_LAST_BACKEND_ENGINE="${RESP_ENGINE:-swift_parakeet}"
  DICTATE_LAST_BACKEND_MODEL="${RESP_MODEL:-$(basename "$model_path")}"
  printf "%s" "${RESP_TEXT:-}"
}

merge_transcript_chunks() {
  local chunks_file="${1:-}"
  [[ -n "$chunks_file" && -f "$chunks_file" ]] || return 0

  python3 - "$chunks_file" <<'PYEOF'
import re
import sys

path = sys.argv[1]
texts = [line.strip() for line in open(path, encoding="utf-8", errors="replace") if line.strip()]

def word_matches(text):
    return list(re.finditer(r"[A-Za-z0-9']+", text))

def norm_words(text):
    return [m.group(0).lower() for m in word_matches(text)]

def char_after_words(text, count):
    matches = word_matches(text)
    if count <= 0 or count > len(matches):
        return 0
    return matches[count - 1].end()

merged = ""
merged_words = []

for text in texts:
    if not merged:
        merged = text
        merged_words = norm_words(merged)
        continue

    incoming_words = norm_words(text)
    incoming_offset = 0
    max_overlap = min(24, len(merged_words), len(incoming_words))
    overlap = 0
    for size in range(max_overlap, 1, -1):
        if merged_words[-size:] == incoming_words[:size]:
            overlap = size
            break

    if not overlap:
        max_offset = min(12, max(0, len(incoming_words) - 2))
        for offset in range(1, max_offset + 1):
            max_overlap = min(24, len(merged_words), len(incoming_words) - offset)
            for size in range(max_overlap, 1, -1):
                if merged_words[-size:] == incoming_words[offset:offset + size]:
                    incoming_offset = offset
                    overlap = size
                    break
            if overlap:
                break

    if overlap:
        rest = text[char_after_words(text, incoming_offset + overlap):].lstrip(" \t,.;:!?-")
        if rest:
            merged = (merged.rstrip() + " " + rest).strip()
    else:
        merged = (merged.rstrip() + " " + text.lstrip()).strip()
    merged_words = norm_words(merged)

print(merged, end="")
PYEOF
}

transcribe_swift_parakeet_tail_rescue_cli() {
  local wav="$1"
  local language="${2:-en}"
  local flow="${3:-inline}"
  local txt duration_ms tail_ms min_duration_ms tail_s tail_dir tail_wav tail_text rescue_texts rc

  txt="$(transcribe_swift_parakeet_cli "$wav" "$language" "$flow")" || return $?

  if ! bool_is_on "${DICTATE_SWIFT_PARAKEET_TAIL_RESCUE:-1}"; then
    printf "%s" "$txt"
    return 0
  fi

  duration_ms="$(audio_duration_ms "$wav" 2>/dev/null || true)"
  tail_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_TAIL_RESCUE_MS:-}" "8000")"
  min_duration_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_TAIL_RESCUE_MIN_MS:-}" "12000")"

  if [[ ! "$duration_ms" =~ ^[0-9]+$ ]] || (( duration_ms < min_duration_ms )); then
    printf "%s" "$txt"
    return 0
  fi
  if (( tail_ms < 1000 )); then
    tail_ms=1000
  fi
  if (( duration_ms <= tail_ms + 1000 )); then
    printf "%s" "$txt"
    return 0
  fi
  command -v ffmpeg >/dev/null 2>&1 || {
    printf "%s" "$txt"
    return 0
  }

  tail_dir="$(mktemp -d "${TMPDIR:-/tmp}/tmux-whisper-tail-rescue.XXXXXX" 2>/dev/null || true)"
  if [[ -z "$tail_dir" ]]; then
    printf "%s" "$txt"
    return 0
  fi
  tail_wav="$tail_dir/tail.wav"
  rescue_texts="$tail_dir/rescue.txt"
  tail_s="$(awk -v ms="$tail_ms" 'BEGIN { printf "%.3f", ms/1000 }')"
  rc=0

  if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
    printf "[%s] swift_parakeet_tail_rescue: duration_ms=%s tail_ms=%s min_duration_ms=%s\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$duration_ms" "$tail_ms" "$min_duration_ms" \
      >>"$TRANSCRIBE_LOG" 2>/dev/null || true
  fi

  if ffmpeg -hide_banner -loglevel error -y \
    -sseof "-$tail_s" -i "$wav" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$tail_wav" >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1; then
    if tail_text="$(transcribe_swift_parakeet_cli "$tail_wav" "$language" "${flow}-tail" 2>>"${TRANSCRIBE_LOG:-/dev/null}")"; then
      tail_text="${tail_text//$'\n'/ }"
      if [[ -n "${tail_text//[[:space:]]/}" ]]; then
        {
          printf "%s\n" "$txt"
          printf "%s\n" "$tail_text"
        } >"$rescue_texts"
        merge_transcript_chunks "$rescue_texts"
        rc=$?
      else
        printf "%s" "$txt"
      fi
    else
      printf "%s" "$txt"
    fi
  else
    printf "%s" "$txt"
  fi

  rm -rf "$tail_dir" 2>/dev/null || true
  return "$rc"
}

transcribe_swift_parakeet_chunked_cli() {
  local wav="$1"
  local language="${2:-en}"
  local flow="${3:-inline}"
  local duration_ms threshold_ms chunk_ms overlap_ms step_ms min_segment_ms
  duration_ms="$(audio_duration_ms "$wav" 2>/dev/null || true)"
  threshold_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_CHUNK_THRESHOLD_MS:-}" "45000")"
  chunk_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_CHUNK_MS:-}" "30000")"
  overlap_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_CHUNK_OVERLAP_MS:-}" "2000")"
  min_segment_ms="$(resolve_stop_grace_ms "${DICTATE_SWIFT_PARAKEET_MIN_CHUNK_MS:-}" "1000")"

  if [[ ! "$duration_ms" =~ ^[0-9]+$ ]] || (( duration_ms <= threshold_ms )); then
    transcribe_swift_parakeet_cli "$wav" "$language" "$flow"
    return $?
  fi

  if (( chunk_ms < 5000 )); then
    chunk_ms=5000
  fi
  if (( overlap_ms >= chunk_ms )); then
    overlap_ms=$(( chunk_ms / 5 ))
  fi
  if (( min_segment_ms < 1 )); then
    min_segment_ms=1000
  fi
  step_ms=$(( chunk_ms - overlap_ms ))
  if (( step_ms <= 0 )); then
    step_ms="$chunk_ms"
  fi

  command -v ffmpeg >/dev/null 2>&1 || {
    transcribe_swift_parakeet_cli "$wav" "$language" "$flow"
    return $?
  }

  local chunk_dir chunk_texts start_ms index segment_ms start_s segment_s chunk_wav chunk_text rc
  chunk_dir="$(mktemp -d "${TMPDIR:-/tmp}/tmux-whisper-chunks.XXXXXX" 2>/dev/null || true)"
  [[ -n "$chunk_dir" ]] || {
    transcribe_swift_parakeet_cli "$wav" "$language" "$flow"
    return $?
  }
  chunk_texts="$chunk_dir/chunks.txt"
  : >"$chunk_texts"

  if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
    printf "[%s] swift_parakeet_chunked: duration_ms=%s threshold_ms=%s chunk_ms=%s overlap_ms=%s\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$duration_ms" "$threshold_ms" "$chunk_ms" "$overlap_ms" \
      >>"$TRANSCRIBE_LOG" 2>/dev/null || true
  fi

  start_ms=0
  index=0
  rc=0
  while (( start_ms < duration_ms )); do
    segment_ms="$chunk_ms"
    if (( start_ms + segment_ms > duration_ms )); then
      segment_ms=$(( duration_ms - start_ms ))
    fi
    (( segment_ms > 0 )) || break
    if (( segment_ms < min_segment_ms )); then
      if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
        printf "[%s] swift_parakeet_chunk_skip: index=%s start_ms=%s duration_ms=%s reason=subsecond_tail\n" \
          "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$index" "$start_ms" "$segment_ms" \
          >>"$TRANSCRIBE_LOG" 2>/dev/null || true
      fi
      break
    fi

    start_s="$(awk -v ms="$start_ms" 'BEGIN { printf "%.3f", ms/1000 }')"
    segment_s="$(awk -v ms="$segment_ms" 'BEGIN { printf "%.3f", ms/1000 }')"
    chunk_wav="$chunk_dir/chunk-${index}.wav"

    if ! ffmpeg -hide_banner -loglevel error -y \
      -ss "$start_s" -t "$segment_s" -i "$wav" \
      -ac 1 -ar 16000 -c:a pcm_s16le \
      "$chunk_wav" >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1; then
      rc=1
      break
    fi

    if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
      printf "[%s] swift_parakeet_chunk: index=%s start_ms=%s duration_ms=%s\n" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$index" "$start_ms" "$segment_ms" \
        >>"$TRANSCRIBE_LOG" 2>/dev/null || true
    fi

    if ! chunk_text="$(transcribe_swift_parakeet_cli "$chunk_wav" "$language" "$flow" 2>>"${TRANSCRIBE_LOG:-/dev/null}")"; then
      rc=1
      break
    fi
    chunk_text="${chunk_text//$'\n'/ }"
    printf "%s\n" "$chunk_text" >>"$chunk_texts"

    index=$(( index + 1 ))
    start_ms=$(( start_ms + step_ms ))
  done

  if [[ "$rc" -ne 0 ]]; then
    rm -rf "$chunk_dir" 2>/dev/null || true
    return "$rc"
  fi

  merge_transcript_chunks "$chunk_texts"
  rc=$?
  rm -rf "$chunk_dir" 2>/dev/null || true
  return "$rc"
}

transcribe_swift_parakeet_dispatch_cli() {
  local wav="$1"
  local language="${2:-en}"
  local flow="${3:-inline}"

  if bool_is_on "${DICTATE_SWIFT_PARAKEET_CHUNKING:-0}"; then
    transcribe_swift_parakeet_chunked_cli "$wav" "$language" "$flow"
    return $?
  fi

  transcribe_swift_parakeet_tail_rescue_cli "$wav" "$language" "$flow"
}

warmup_backend() {
  local best_effort="0"
  local arg model_path result model_name duration_ms message

  for arg in "$@"; do
    case "$arg" in
      --best-effort) best_effort="1" ;;
      *) die "usage: tmux-whisper warmup [--best-effort]" ;;
    esac
  done

  model_path="$(resolve_swift_parakeet_model_path 2>/dev/null || true)"
  if [[ -z "$model_path" ]]; then
    if [[ "$best_effort" == "1" ]]; then
      echo "Warmup: skipped (no local Parakeet model found)"
      return 0
    fi
    die "no local Parakeet model found. Expected under $DEFAULT_SWIFT_PARAKEET_MODELS_DIR or set swift_parakeet.model_path"
  fi

  result="$(swift_parakeet_warmup_cli 2>>"${TRANSCRIBE_LOG:-/dev/null}" || true)"
  if [[ -z "$result" ]]; then
    if [[ "$best_effort" == "1" ]]; then
      echo "Warmup: skipped (daemon/model preload unavailable)"
      return 0
    fi
    die "failed to warm up the swift_parakeet backend"
  fi

  maybe_prime_swift_parakeet_after_warmup

  IFS=$'\t' read -r model_name duration_ms message <<<"$result"
  echo "Warmup: ready (model=${model_name:-$(basename "$model_path")}, duration=${duration_ms:-0}ms)"
}

transcribe_audio() {
  local wav="$1"
  local _model_id="${2:-}"
  local language="${3:-en}"
  local _threads="${4:-2}"
  local flow="${5:-inline}"
  local requested_backend
  local txt=""
  local transcribe_rc=0

  maybe_trim_silence_inplace "$wav"
  maybe_pad_transcribe_tail_inplace "$wav"
  requested_backend="$(resolve_transcribe_backend)"
  DICTATE_LAST_BACKEND_ENGINE=""
  DICTATE_LAST_BACKEND_MODEL=""
  set +e
  txt="$(transcribe_swift_parakeet_dispatch_cli "$wav" "$language" "$flow" 2>>"${TRANSCRIBE_LOG:-/dev/null}")"
  transcribe_rc=$?
  set -e
  write_backend_runtime_cache "$requested_backend" "$requested_backend" "" "${DICTATE_LAST_BACKEND_ENGINE:-swift_parakeet}" "${DICTATE_LAST_BACKEND_MODEL:-}"
  [[ "$transcribe_rc" -eq 0 ]] || return "$transcribe_rc"
  printf "%s" "$txt"
}

maybe_trim_silence_inplace() {
  local wav="${1:-}"
  [[ -n "$wav" && -f "$wav" ]] || return 0

  if bool_is_on "${DICTATE_RUNTIME_SKIP_SILENCE_TRIM:-0}"; then
    return 0
  fi

  local enabled="${DICTATE_SILENCE_TRIM:-${CFG_AUDIO_SILENCE_TRIM:-0}}"
  bool_is_on "$enabled" || return 0

  command -v ffmpeg >/dev/null 2>&1 || return 0

  local mode="${DICTATE_SILENCE_TRIM_MODE:-${CFG_AUDIO_SILENCE_TRIM_MODE:-edges}}"
  local threshold_db="${DICTATE_SILENCE_THRESHOLD_DB:-${CFG_AUDIO_SILENCE_THRESHOLD_DB:--60}}"
  local min_ms="${DICTATE_SILENCE_MIN_MS:-${CFG_AUDIO_SILENCE_MIN_MS:-250}}"
  local keep_ms="${DICTATE_SILENCE_KEEP_MS:-${CFG_AUDIO_SILENCE_KEEP_MS:-50}}"

  local min_s keep_s threshold_amp
  min_s="$(awk "BEGIN { printf \"%.3f\", (${min_ms:-250})/1000 }")"
  keep_s="$(awk "BEGIN { printf \"%.3f\", (${keep_ms:-50})/1000 }")"
  threshold_amp="$(awk "BEGIN { printf \"%.6f\", 10^((${threshold_db:--60})/20) }")"

  local stop_periods="1"
  if [[ "$mode" == "all" ]]; then
    # Experimental: attempt to remove interior silences too (may harm cadence/accuracy).
    stop_periods="-1"
  fi

  local tmp="${wav}.trim.wav"
  rm -f "$tmp" 2>/dev/null || true

  if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
    printf "[%s] silence_trim: mode=%s threshold_db=%s threshold_amp=%s min_ms=%s keep_ms=%s\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$mode" "$threshold_db" "$threshold_amp" "$min_ms" "$keep_ms" \
      >>"$TRANSCRIBE_LOG" 2>/dev/null || true
  fi

  set +e
  ffmpeg -hide_banner -loglevel error -y \
    -i "$wav" \
    -af "silenceremove=start_periods=1:start_duration=${min_s}:start_threshold=${threshold_amp}:start_silence=${keep_s}:stop_periods=${stop_periods}:stop_duration=${min_s}:stop_threshold=${threshold_amp}:stop_silence=${keep_s}:detection=peak" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$tmp" >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1
  local rc=$?
  set -e

  if [[ "$rc" -ne 0 || ! -s "$tmp" ]]; then
    rm -f "$tmp" 2>/dev/null || true
    return 0
  fi

  mv -f "$tmp" "$wav" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 0
  }
}

maybe_pad_transcribe_tail_inplace() {
  local wav="${1:-}"
  [[ -n "$wav" && -f "$wav" ]] || return 0

  local tail_pad_ms="${DICTATE_TRANSCRIBE_TAIL_PAD_MS:-500}"
  [[ "$tail_pad_ms" =~ ^[0-9]+$ ]] || tail_pad_ms=500
  (( tail_pad_ms > 0 )) || return 0

  command -v ffmpeg >/dev/null 2>&1 || return 0

  local tail_pad_s
  tail_pad_s="$(awk "BEGIN { printf \"%.3f\", (${tail_pad_ms})/1000 }")"
  local tmp=""
  tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-tail-pad.XXXXXX.wav" 2>/dev/null || true)"
  [[ -n "$tmp" ]] || tmp="${wav}.tail.wav"

  if [[ -n "${TRANSCRIBE_LOG:-}" ]]; then
    printf "[%s] transcribe_tail_pad: ms=%s\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$tail_pad_ms" \
      >>"$TRANSCRIBE_LOG" 2>/dev/null || true
  fi

  set +e
  ffmpeg -hide_banner -loglevel error -y \
    -i "$wav" \
    -f lavfi -t "$tail_pad_s" -i "anullsrc=r=16000:cl=mono" \
    -filter_complex "[0:a][1:a]concat=n=2:v=0:a=1" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$tmp" >>"${TRANSCRIBE_LOG:-/dev/null}" 2>&1
  local rc=$?
  set -e

  if [[ "$rc" -ne 0 || ! -s "$tmp" ]]; then
    rm -f "$tmp" 2>/dev/null || true
    return 0
  fi

  mv -f "$tmp" "$wav" 2>/dev/null || {
    rm -f "$tmp" 2>/dev/null || true
    return 0
  }
}

if [[ "$SKIP_INITIAL_CONFIG_LOAD" != "1" ]]; then
  config_load
fi

# --- History Management -----------------------------------------------------

HISTORY_DIR="$DICTATE_CONFIG_DIR/history"
BENCH_FILE="$HISTORY_DIR/bench.tsv"

bench_field() {
  printf "%s" "${1:-}" | tr '\t\r\n' '   '
}

load_postprocess_obs_file() {
  local obs_file="${1:-}"
  [[ -n "$obs_file" && -f "$obs_file" ]] || return 0
  # Generated by postprocess_llm with shell-escaped values.
  # shellcheck disable=SC1090
  source "$obs_file" 2>/dev/null || true
}

append_bench_entry() {
  local flow="${1:-unknown}"
  local status="${2:-ok}"
  local model="${3:-unknown}"
  local mode="${4:-none}"
  local postprocess="${5:-0}"
  local raw_chars="${6:-0}"
  local out_chars="${7:-0}"
  local record_ms="${8:-0}"
  local transcribe_ms="${9:-0}"
  local clean_ms="${10:-0}"
  local postprocess_ms="${11:-0}"
  local paste_ms="${12:-0}"
  local total_ms="${13:-0}"
  local startup_total_ms="${14:-0}"
  local startup_audio_ms="${15:-0}"
  local startup_ffmpeg_live_ms="${16:-0}"
  local startup_target_ms="${17:-0}"
  local startup_audio_source="${18:-}"

  mkdir -p "$HISTORY_DIR" 2>/dev/null || return 0
  printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
    "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
    "$(bench_field "$flow")" \
    "$(bench_field "$status")" \
    "$(bench_field "$model")" \
    "$(bench_field "$mode")" \
    "$(bench_field "$postprocess")" \
    "$(bench_field "$raw_chars")" \
    "$(bench_field "$out_chars")" \
    "$(bench_field "$record_ms")" \
    "$(bench_field "$transcribe_ms")" \
    "$(bench_field "$clean_ms")" \
    "$(bench_field "$postprocess_ms")" \
    "$(bench_field "$paste_ms")" \
    "$(bench_field "$total_ms")" \
    "$(bench_field "$startup_total_ms")" \
    "$(bench_field "$startup_audio_ms")" \
    "$(bench_field "$startup_ffmpeg_live_ms")" \
    "$(bench_field "$startup_target_ms")" \
    "$(bench_field "$startup_audio_source")" >>"$BENCH_FILE" 2>/dev/null || true

  local max_rows rows
  max_rows="${DICTATE_BENCH_MAX_ROWS:-800}"
  if [[ "$max_rows" =~ ^[0-9]+$ ]] && (( max_rows > 0 )) && [[ -f "$BENCH_FILE" ]]; then
    rows="$(wc -l < "$BENCH_FILE" | tr -d ' ' || echo 0)"
    if [[ "$rows" =~ ^[0-9]+$ ]] && (( rows > max_rows )); then
      tail -n "$max_rows" "$BENCH_FILE" > "${BENCH_FILE}.tmp" 2>/dev/null || true
      mv -f "${BENCH_FILE}.tmp" "$BENCH_FILE" 2>/dev/null || true
    fi
  fi
}

bench() {
  local json_output="0"
  local args=()
  local filter_args=()
  local arg
  local usage="usage: tmux-whisper bench [N|all] [--json] [--flow inline|tmux] [--status STATUS] [--mode MODE] [--model MODEL] [--slow-startup-ms N] [--slow-startup-audio-ms N] [--slow-startup-ffmpeg-ms N] [--slow-total-ms N] | bench export [N|all] [--json] [filters] | bench clear"

  while [[ $# -gt 0 ]]; do
    arg="${1:-}"
    case "$arg" in
      --json)
        json_output="1"
        ;;
      --flow|--status|--mode|--model)
        shift
        [[ $# -gt 0 && -n "${1:-}" ]] || die "$usage"
        filter_args+=("${arg#--}=${1:-}")
        ;;
      --flow=*|--status=*|--mode=*|--model=*)
        filter_args+=("${arg#--}")
        ;;
      --slow-startup-ms|--slow-startup-total-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_total_ms=${1:-}")
        ;;
      --slow-startup-ms=*|--slow-startup-total-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_total_ms=${arg#*=}")
        ;;
      --slow-startup-audio-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_audio_ms=${1:-}")
        ;;
      --slow-startup-audio-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_audio_ms=${arg#*=}")
        ;;
      --slow-startup-ffmpeg-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_ffmpeg_live_ms=${1:-}")
        ;;
      --slow-startup-ffmpeg-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_ffmpeg_live_ms=${arg#*=}")
        ;;
      --slow-startup-target-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_target_ms=${1:-}")
        ;;
      --slow-startup-target-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_startup_target_ms=${arg#*=}")
        ;;
      --slow-total-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_total_ms=${1:-}")
        ;;
      --slow-total-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_total_ms=${arg#*=}")
        ;;
      --slow-transcribe-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_transcribe_ms=${1:-}")
        ;;
      --slow-transcribe-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_transcribe_ms=${arg#*=}")
        ;;
      --slow-paste-ms)
        shift
        [[ $# -gt 0 && "${1:-}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_paste_ms=${1:-}")
        ;;
      --slow-paste-ms=*)
        [[ "${arg#*=}" =~ ^[0-9]+$ ]] || die "$usage"
        filter_args+=("min_paste_ms=${arg#*=}")
        ;;
      --*)
        die "$usage"
        ;;
      *)
        args+=("$arg")
        ;;
    esac
    shift
  done

  local subcmd="show"
  local spec="30"
  case "${args[0]:-}" in
    "")
      ;;
    clear)
      [[ "$json_output" == "0" ]] || die "bench clear does not accept --json"
      [[ "${#filter_args[@]}" -eq 0 ]] || die "$usage"
      [[ "${#args[@]}" -eq 1 ]] || die "$usage"
      rm -f "$BENCH_FILE" 2>/dev/null || true
      echo "Bench data cleared."
      return 0
      ;;
    export)
      subcmd="export"
      [[ "${#args[@]}" -le 2 ]] || die "$usage"
      spec="${args[1]:-30}"
      if [[ "$spec" != "all" ]]; then
        [[ "$spec" =~ ^[0-9]+$ ]] || die "$usage"
        (( spec > 0 )) || die "$usage"
      fi
      ;;
    *)
      [[ "${#args[@]}" -eq 1 ]] || die "$usage"
      if [[ "${args[0]}" != "all" ]]; then
        [[ "${args[0]}" =~ ^[0-9]+$ ]] || die "$usage"
        (( ${args[0]} > 0 )) || die "$usage"
      fi
      spec="${args[0]}"
      ;;
  esac

  need python3
  python3 - "$BENCH_FILE" "$subcmd" "$spec" "$json_output" ${filter_args[@]+"${filter_args[@]}"} <<'PYEOF'
import collections
import json
import os
import statistics
import sys

path = os.path.expanduser(sys.argv[1])
subcmd = sys.argv[2]
spec = sys.argv[3]
json_output = sys.argv[4] == "1"
filter_args = sys.argv[5:]

FILTER_LABELS = {
    "flow": "flow",
    "status": "status",
    "mode": "mode",
    "model": "model",
    "min_record_ms": "record_ms",
    "min_transcribe_ms": "transcribe_ms",
    "min_paste_ms": "paste_ms",
    "min_total_ms": "total_ms",
    "min_startup_total_ms": "startup_total_ms",
    "min_startup_audio_ms": "startup_audio_ms",
    "min_startup_ffmpeg_live_ms": "startup_ffmpeg_live_ms",
    "min_startup_target_ms": "startup_target_ms",
}

filters = {
    "flow": None,
    "status": None,
    "mode": None,
    "model": None,
    "minimums": {},
}
for item in filter_args:
    if "=" not in item:
        continue
    key, value = item.split("=", 1)
    key = key.strip()
    value = value.strip()
    if key in {"flow", "status", "mode", "model"}:
        filters[key] = value
    elif key in FILTER_LABELS:
        try:
            filters["minimums"][FILTER_LABELS[key]] = int(value)
        except Exception:
            raise SystemExit(f"invalid bench filter: {key}={value}")

active_filters = {
    key: value
    for key, value in filters.items()
    if (isinstance(value, dict) and value) or (not isinstance(value, dict) and value is not None)
}

records = []
if os.path.isfile(path):
    with open(path, "r", encoding="utf-8", errors="replace") as fh:
        for line_number, line in enumerate(fh, start=1):
            parts = line.rstrip("\n").split("\t")
            if len(parts) < 14:
                continue
            ts, flow, status, model, mode, post, rawc, outc, rec, trn, cln, pps, pst, tot = parts[:14]
            startup_total = parts[14] if len(parts) > 14 else "0"
            startup_audio = parts[15] if len(parts) > 15 else "0"
            startup_live = parts[16] if len(parts) > 16 else "0"
            startup_target = parts[17] if len(parts) > 17 else "0"
            startup_source = parts[18] if len(parts) > 18 else ""

            def to_int(v: str) -> int:
                try:
                    return int(v)
                except Exception:
                    return 0

            records.append(
                {
                    "line_number": line_number,
                    "timestamp": ts,
                    "flow": flow,
                    "status": status,
                    "model": model,
                    "mode": mode,
                    "postprocess_enabled": post in {"1", "true", "on", "yes"},
                    "raw_chars": to_int(rawc),
                    "out_chars": to_int(outc),
                    "record_ms": to_int(rec),
                    "transcribe_ms": to_int(trn),
                    "clean_ms": to_int(cln),
                    "postprocess_ms": to_int(pps),
                    "paste_ms": to_int(pst),
                    "total_ms": to_int(tot),
                    "startup_total_ms": to_int(startup_total),
                    "startup_audio_ms": to_int(startup_audio),
                    "startup_ffmpeg_live_ms": to_int(startup_live),
                    "startup_target_ms": to_int(startup_target),
                    "startup_audio_source": startup_source,
                }
            )

def select_subset(rows, raw_spec):
    if raw_spec == "all":
        return list(rows)
    limit = int(raw_spec)
    if limit <= 0:
        limit = 1
    return rows[-limit:]

def matches_filters(row):
    for key in ("flow", "status", "mode", "model"):
        raw_value = filters.get(key)
        if raw_value is None:
            continue
        accepted = {part.strip() for part in raw_value.split(",") if part.strip()}
        if accepted and str(row.get(key, "")) not in accepted:
            return False
    for key, minimum in filters["minimums"].items():
        if int(row.get(key, 0) or 0) < minimum:
            return False
    return True

def percentile(values, pct):
    if not values:
        return 0
    vals = sorted(values)
    if len(vals) == 1:
        return vals[0]
    pos = (len(vals) - 1) * pct
    lo = int(pos)
    hi = min(lo + 1, len(vals) - 1)
    frac = pos - lo
    return int(round(vals[lo] * (1 - frac) + vals[hi] * frac))

def metric_summary(values):
    if not values:
        return {"n": 0, "median": 0, "p90": 0, "max": 0}
    return {
        "n": len(values),
        "median": int(statistics.median(values)),
        "p90": percentile(values, 0.90),
        "max": max(values),
    }

def fmt_stage(name, values):
    metric = metric_summary(values)
    if metric["n"] == 0:
        return f"{name}: n=0"
    return f"{name}: n={metric['n']} median={metric['median']}ms p90={metric['p90']}ms max={metric['max']}ms"

def export_entries(rows):
    newest_first = list(reversed(rows))
    entries = []
    for idx, row in enumerate(newest_first, start=1):
        item = dict(row)
        item["index"] = idx
        entries.append(item)
    return entries

matching_records = [row for row in records if matches_filters(row)]
subset = select_subset(matching_records, spec)
exported = export_entries(subset)

if subcmd == "export":
    if json_output:
        print(json.dumps(exported, indent=2, sort_keys=True))
        raise SystemExit(0)
    if not exported:
        print("No bench data yet.")
        raise SystemExit(0)
    for entry in exported:
        print(f"=== Bench {entry['index']} ===")
        print(f"Timestamp: {entry['timestamp']}")
        print(f"Flow: {entry['flow']}")
        print(f"Status: {entry['status']}")
        print(f"Model: {entry['model']}")
        print(f"Mode: {entry['mode']}")
        print(f"Postprocess: {'on' if entry['postprocess_enabled'] else 'off'}")
        print("")
        print("Metrics:")
        for key in (
            "record_ms",
            "transcribe_ms",
            "clean_ms",
            "postprocess_ms",
            "paste_ms",
            "total_ms",
            "raw_chars",
            "out_chars",
        ):
            print(f"  {key}: {entry[key]}")
        if (
            entry["startup_total_ms"] > 0
            or entry["startup_audio_ms"] > 0
            or entry["startup_ffmpeg_live_ms"] > 0
            or entry["startup_target_ms"] > 0
            or entry["startup_audio_source"]
        ):
            print("")
            print("Startup:")
            print(f"  startup_total_ms: {entry['startup_total_ms']}")
            print(f"  startup_audio_ms: {entry['startup_audio_ms']}")
            print(f"  startup_ffmpeg_live_ms: {entry['startup_ffmpeg_live_ms']}")
            print(f"  startup_target_ms: {entry['startup_target_ms']}")
            if entry["startup_audio_source"]:
                print(f"  startup_audio_source: {entry['startup_audio_source']}")
        print("")
    raise SystemExit(0)

flow_counts = collections.Counter(r["flow"] for r in subset)
status_counts = collections.Counter(r["status"] for r in subset)
latest = subset[-1] if subset else None

payload = {
    "command": "bench",
    "subcommand": "show",
    "source": path,
    "total_records": len(records),
    "filtered_records": len(matching_records),
    "subset_records": len(subset),
    "filters": active_filters,
    "counts": {
        "flows": {k: flow_counts[k] for k in sorted(flow_counts)},
        "statuses": {k: status_counts[k] for k in sorted(status_counts)},
    },
    "stages": {
        "record_ms": metric_summary([r["record_ms"] for r in subset if r["record_ms"] > 0]),
        "transcribe_ms": metric_summary([r["transcribe_ms"] for r in subset if r["transcribe_ms"] >= 0]),
        "clean_ms": metric_summary([r["clean_ms"] for r in subset if r["clean_ms"] >= 0]),
        "postprocess_ms": metric_summary([r["postprocess_ms"] for r in subset if r["postprocess_ms"] > 0]),
        "paste_ms": metric_summary([r["paste_ms"] for r in subset if r["paste_ms"] > 0]),
        "total_ms": metric_summary([r["total_ms"] for r in subset if r["total_ms"] > 0]),
    },
    "startup": {
        "available": any(
            r["startup_total_ms"] > 0
            or r["startup_audio_ms"] > 0
            or r["startup_ffmpeg_live_ms"] > 0
            or r["startup_target_ms"] > 0
            for r in subset
        ),
        "total_ms": metric_summary([r["startup_total_ms"] for r in subset if r["startup_total_ms"] > 0]),
        "audio_ms": metric_summary([r["startup_audio_ms"] for r in subset if r["startup_audio_ms"] > 0]),
        "ffmpeg_live_ms": metric_summary([r["startup_ffmpeg_live_ms"] for r in subset if r["startup_ffmpeg_live_ms"] > 0]),
        "target_ms": metric_summary([r["startup_target_ms"] for r in subset if r["startup_target_ms"] > 0]),
    },
    "latest": latest,
    "next_commands": [
        "tmux-whisper history sessions 5",
        "tmux-whisper logs tail transcribe --lines 40",
        "tmux-whisper status --preset compact",
    ],
}

if json_output:
    print(json.dumps(payload, indent=2, sort_keys=True))
    raise SystemExit(0)

if not records:
    print("No bench data yet.")
    print("Run a dictation first, then: tmux-whisper bench")
    raise SystemExit(0)

if active_filters:
    print(f"Tmux Whisper bench (last {len(subset)} of {len(matching_records)} matching runs; total {len(records)})")
else:
    print(f"Tmux Whisper bench (last {len(subset)} of {len(records)} runs)")
print(f"Source: {path}")
if active_filters:
    print("Filters:")
    for key in ("flow", "status", "mode", "model"):
        if filters.get(key) is not None:
            print(f"  {key}: {filters[key]}")
    for key, minimum in sorted(filters["minimums"].items()):
        print(f"  {key}: >= {minimum}ms")
print("")
print("Counts:")
flow_counts_text = ", ".join(f"{k}={v}" for k, v in sorted(flow_counts.items())) if flow_counts else "<none>"
status_counts_text = ", ".join(f"{k}={v}" for k, v in sorted(status_counts.items())) if status_counts else "<none>"
print("  by flow: " + flow_counts_text)
print("  by status: " + status_counts_text)

print("")
print("Stages:")
print("  " + fmt_stage("record", [r["record_ms"] for r in subset if r["record_ms"] > 0]))
print("  " + fmt_stage("transcribe", [r["transcribe_ms"] for r in subset if r["transcribe_ms"] >= 0]))
print("  " + fmt_stage("clean", [r["clean_ms"] for r in subset if r["clean_ms"] >= 0]))
print("  " + fmt_stage("postprocess", [r["postprocess_ms"] for r in subset if r["postprocess_ms"] > 0]))
print("  " + fmt_stage("paste", [r["paste_ms"] for r in subset if r["paste_ms"] > 0]))
print("  " + fmt_stage("total(stop->done)", [r["total_ms"] for r in subset if r["total_ms"] > 0]))

startup_total_vals = [r["startup_total_ms"] for r in subset if r["startup_total_ms"] > 0]
startup_audio_vals = [r["startup_audio_ms"] for r in subset if r["startup_audio_ms"] > 0]
startup_live_vals = [r["startup_ffmpeg_live_ms"] for r in subset if r["startup_ffmpeg_live_ms"] > 0]
startup_target_vals = [r["startup_target_ms"] for r in subset if r["startup_target_ms"] > 0]
if startup_total_vals or startup_audio_vals or startup_live_vals or startup_target_vals:
    print("")
    print("Startup readiness:")
    print("  " + fmt_stage("startup.total(invoke->ready)", startup_total_vals))
    print("  " + fmt_stage("startup.audio_resolve", startup_audio_vals))
    print("  " + fmt_stage("startup.ffmpeg_livecheck", startup_live_vals))
    print("  " + fmt_stage("startup.target_capture", startup_target_vals))

if latest is not None:
    print("")
    print("Latest:")
    print(
        "  "
        + f"{latest['timestamp']} flow={latest['flow']} status={latest['status']} "
        + f"model={latest['model']} mode={latest['mode']} postprocess={'on' if latest['postprocess_enabled'] else 'off'}"
    )
    print(
        (
            "  "
            + "record={record_ms}ms transcribe={transcribe_ms}ms clean={clean_ms}ms "
            + "postprocess={postprocess_ms}ms paste={paste_ms}ms total={total_ms}ms "
            + "raw_chars={raw_chars} out_chars={out_chars}"
        ).format(**latest)
    )
    if latest.get("startup_total_ms", 0) > 0:
        print(
            (
                "  "
                + "startup_total={startup_total_ms}ms startup_audio={startup_audio_ms}ms "
                + "startup_ffmpeg_live={startup_ffmpeg_live_ms}ms startup_target={startup_target_ms}ms "
                + "audio_source={startup_audio_source}"
            ).format(**latest)
        )

print("")
print("Next:")
print("  tmux-whisper history sessions 5")
print("  tmux-whisper logs tail transcribe --lines 40")
print("  tmux-whisper status --preset compact")
PYEOF
}

watch() {
  need python3

  local interval="2"
  local iterations=""
  local preset="default"

  while [[ $# -gt 0 ]]; do
    case "${1:-}" in
      --preset)
        shift
        [[ $# -gt 0 ]] || die "usage: tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N]"
        case "${1:-}" in
          default|compact)
            preset="${1:-default}"
            ;;
          *)
            die "usage: tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N]"
            ;;
        esac
        ;;
      --interval)
        shift
        [[ $# -gt 0 ]] || die "usage: tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N]"
        interval="${1:-}"
        ;;
      --iterations)
        shift
        [[ $# -gt 0 ]] || die "usage: tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N]"
        iterations="${1:-}"
        ;;
      *)
        die "usage: tmux-whisper watch [--preset compact] [--interval SECONDS] [--iterations N]"
        ;;
    esac
    shift
  done

  WATCH_INTERVAL="$interval" python3 - <<'PYEOF' >/dev/null || die "watch --interval expects a non-negative number of seconds"
import os
import sys

raw = os.environ.get("WATCH_INTERVAL", "").strip()
try:
    value = float(raw)
except Exception:
    raise SystemExit(1)

raise SystemExit(0 if value >= 0 else 1)
PYEOF

  if [[ -n "$iterations" ]]; then
    [[ "$iterations" =~ ^[0-9]+$ ]] || die "watch --iterations expects a positive integer"
    (( iterations > 0 )) || die "watch --iterations expects a positive integer"
  fi

  local interactive="0"
  [[ -t 1 ]] && interactive="1"

  local iteration=0
  while :; do
    iteration=$((iteration + 1))

    local status_json bench_json last_json history_file
    status_json="$(status --json 2>/dev/null || true)"
    bench_json="$(bench --json 2>/dev/null || true)"
    last_json=""
    history_file="$(history_entry_file_by_index 1 2>/dev/null || true)"
    if [[ -n "$history_file" && -f "$history_file" ]]; then
      last_json="$(show_last_history json 2>/dev/null || true)"
    fi

    WATCH_STATUS_JSON="$status_json" \
    WATCH_BENCH_JSON="$bench_json" \
    WATCH_LAST_JSON="$last_json" \
    WATCH_INTERVAL="$interval" \
    WATCH_ITERATION="$iteration" \
    WATCH_ITERATIONS="$iterations" \
    WATCH_INTERACTIVE="$interactive" \
    WATCH_PRESET="$preset" \
    python3 - <<'PYEOF'
import json
import os
import re
import sys
from datetime import datetime


def load_json_env(name: str):
    raw = os.environ.get(name, "")
    if not raw.strip():
        return None
    try:
        return json.loads(raw)
    except Exception:
        return None


def bool_flag(name: str) -> bool:
    return os.environ.get(name, "0") == "1"


def compact_text(value: str, limit: int = 120) -> str:
    text = re.sub(r"\s+", " ", value or "").strip()
    if len(text) <= limit:
        return text
    return text[: max(0, limit - 3)] + "..."


def format_ms_short(value) -> str:
    try:
        ms = int(value)
    except Exception:
        return "?"
    if ms < 1000:
        return f"{ms}ms"
    seconds = ms / 1000.0
    if seconds < 60:
        return f"{seconds:.1f}s"
    minutes = int(seconds // 60)
    rem = seconds - (minutes * 60)
    if minutes < 60:
        return f"{minutes}m {rem:04.1f}s"
    hours = int(minutes // 60)
    minutes = minutes % 60
    return f"{hours}h {minutes:02d}m"


def word_count(text: str) -> int:
    return len(re.findall(r"\b\w+\b", text or ""))


def fmt_counts(mapping) -> str:
    if not isinstance(mapping, dict) or not mapping:
        return "<none>"
    return ", ".join(f"{key}={mapping[key]}" for key in sorted(mapping))


def print_section(title: str):
    print(title)


def compact_runtime_label(payload) -> str:
    if not isinstance(payload, dict):
        return "idle"
    state = payload.get("state") or "idle"
    if state == "active":
        parts = ["active"]
        if payload.get("pid") is not None:
            parts.append(f"pid={payload['pid']}")
        if payload.get("age_seconds") is not None:
            parts.append(f"age={payload['age_seconds']}s")
        return ",".join(parts)
    if state == "stale":
        if payload.get("age_seconds") is not None:
            return f"stale,age={payload['age_seconds']}s"
        return "stale"
    return state


def build_more_detail_commands(summary_state, active_flow, last_entry, status_more_detail):
    if isinstance(status_more_detail, list):
        normalized = []
        for item in status_more_detail:
            text = str(item or "").strip()
            if text:
                normalized.append(text)
        if normalized:
            return normalized

    if summary_state == "recording":
        record_stream = "inline-record" if active_flow == "inline" else "record"
        return [
            "tmux-whisper stop",
            f"tmux-whisper logs follow {record_stream}",
            "tmux-whisper status --json",
        ]
    if summary_state == "processing":
        transcribe_stream = "inline-transcribe" if active_flow == "inline" else "transcribe"
        return [
            f"tmux-whisper logs follow {transcribe_stream}",
            "tmux-whisper last",
            "tmux-whisper bench",
            "tmux-whisper history sessions 5",
        ]
    if summary_state in {"attention", "not_ready"}:
        return [
            "tmux-whisper doctor",
            "tmux-whisper debug",
            "tmux-whisper config repair --dry-run",
        ]
    return [
        "tmux-whisper last" if isinstance(last_entry, dict) else "tmux-whisper history list 5",
        "tmux-whisper bench",
        "tmux-whisper logs tail transcribe --lines 20",
        "tmux-whisper history sessions 5",
    ]


status = load_json_env("WATCH_STATUS_JSON") or {}
bench = load_json_env("WATCH_BENCH_JSON") or {}
last_payload = load_json_env("WATCH_LAST_JSON")

summary = status.get("summary") if isinstance(status, dict) else {}
runtime = status.get("runtime") if isinstance(status, dict) else {}
effective = status.get("effective_settings") if isinstance(status, dict) else {}

iteration = os.environ.get("WATCH_ITERATION", "1").strip() or "1"
iterations = os.environ.get("WATCH_ITERATIONS", "").strip()
interactive = bool_flag("WATCH_INTERACTIVE")
interval = os.environ.get("WATCH_INTERVAL", "2").strip() or "2"
preset = os.environ.get("WATCH_PRESET", "default").strip() or "default"
snapshot_label = f"{iteration}/{iterations}" if iterations else iteration

if interactive:
    sys.stdout.write("\033[H\033[2J")
    sys.stdout.flush()
    print("Tmux Whisper watch")
else:
    print(f"=== Tmux Whisper watch snapshot {snapshot_label} ===")

updated = datetime.now().astimezone().strftime("%Y-%m-%d %H:%M:%S %Z")
print(f"Updated: {updated}")
print(f"Refresh: every {interval}s")
print(f"Snapshot: {snapshot_label}")
if preset != "default":
    print(f"Preset: {preset}")
if interactive:
    print("Press Ctrl-C to stop.")
print("")

backend_name = effective.get("backend") if isinstance(effective, dict) else None
backend_readiness = summary.get("backend_readiness") if isinstance(summary, dict) else None
inline_mode = (((effective.get("mode") or {}).get("inline") or {}).get("display_name")) if isinstance(effective, dict) else None
inline_mode_source = (((effective.get("mode") or {}).get("inline") or {}).get("source")) if isinstance(effective, dict) else None
tmux_mode = (((effective.get("mode") or {}).get("tmux") or {}).get("display_name")) if isinstance(effective, dict) else None
config_schema = (summary.get("config_schema") or {}) if isinstance(summary, dict) else {}
config_version = config_schema.get("version") or "unknown"
config_status = config_schema.get("status") or "unknown"
processing = runtime.get("processing_markers") if isinstance(runtime, dict) else {}
tmux_queue = runtime.get("tmux_queue") if isinstance(runtime, dict) else {}
last_entry = (last_payload or {}).get("entry") if isinstance(last_payload, dict) else None
active_flow = summary.get("active_flow")
commands = build_more_detail_commands(summary.get("state"), active_flow, last_entry, None)

if preset == "compact":
    print(
        "Summary: state={state} backend={backend} flow={flow} config={version}/{status}".format(
            state=summary.get("state", "unknown"),
            backend=backend_readiness or "unknown",
            flow=active_flow or "none",
            version=config_version,
            status=config_status,
        )
    )
    print(
        "Modes: inline={inline} [{source}], tmux={tmux}".format(
            inline=inline_mode or "?",
            source=inline_mode_source or "unknown",
            tmux=tmux_mode or "?",
        )
    )
    print(
        "Runtime: tmux={tmux} inline={inline} proc={live}/{total} stale={stale} queue={recording}/{processing}".format(
            tmux=compact_runtime_label(runtime.get("tmux")),
            inline=compact_runtime_label(runtime.get("inline")),
            live=(processing or {}).get("live", 0),
            total=(processing or {}).get("total", 0),
            stale=(processing or {}).get("stale", 0),
            recording=(tmux_queue or {}).get("recording", 0),
            processing=(tmux_queue or {}).get("processing", 0),
        )
    )
    print(f"Headline: {summary.get('headline', 'Status unavailable.')}")
    if isinstance(last_entry, dict):
        compact_last = [
            f"{last_entry.get('mode', '?')} @ {last_entry.get('app', '?')}",
        ]
        if last_entry.get("timestamp"):
            compact_last.append(str(last_entry["timestamp"]))
        metrics = last_entry.get("metrics") if isinstance(last_entry.get("metrics"), dict) else {}
        if metrics.get("total_ms") is not None:
            compact_last.append(f"total={format_ms_short(metrics.get('total_ms'))}")
        if metrics.get("transcribe_ms") is not None:
            compact_last.append(f"transcribe={format_ms_short(metrics.get('transcribe_ms'))}")
        compact_last.append(f"preview={compact_text(str(last_entry.get('processed') or last_entry.get('raw') or ''), 80) or '<empty>'}")
        print("Last: " + " ".join(compact_last))
    else:
        print("Last: none")
    total_records = bench.get("total_records", 0) if isinstance(bench, dict) else 0
    subset_records = bench.get("subset_records", 0) if isinstance(bench, dict) else 0
    if not total_records:
        print("Bench: none")
    else:
        latest = bench.get("latest") if isinstance(bench, dict) else {}
        bench_bits = [f"window={subset_records}/{total_records}"]
        if isinstance(latest, dict) and latest:
            latest_bits = [str(latest.get("flow", "?")), str(latest.get("status", "?"))]
            if latest.get("mode"):
                latest_bits.append(f"mode={latest['mode']}")
            latest_bits.append(f"total={format_ms_short(latest.get('total_ms', 0))}")
            latest_bits.append(f"transcribe={format_ms_short(latest.get('transcribe_ms', 0))}")
            if latest.get("paste_ms") is not None:
                latest_bits.append(f"paste={format_ms_short(latest.get('paste_ms', 0))}")
            bench_bits.append("latest=" + " ".join(latest_bits))
        print("Bench: " + " ".join(bench_bits))
    print("More: " + " | ".join(commands))
    raise SystemExit(0)

print_section("Summary")
print(f"  state: {summary.get('state', 'unknown')}")
print(f"  headline: {summary.get('headline', 'Status unavailable.')}")
if backend_name or backend_readiness:
    print(f"  backend: {(backend_name or 'unknown')} ({backend_readiness or 'unknown'})")
print(
    "  modes: inline={inline} [{source}], tmux={tmux}".format(
        inline=inline_mode or "?",
        source=inline_mode_source or "unknown",
        tmux=tmux_mode or "?",
    )
)
print(f"  config: {config_version} ({config_status})")
active_flow = summary.get("active_flow")
print(f"  active_flow: {active_flow or 'none'}")
print(f"  next_action: {summary.get('next_action', 'n/a')}")
print("")


def render_runtime_line(label: str, payload):
    if not isinstance(payload, dict):
        print(f"  {label}: unavailable")
        return
    state = payload.get("state") or "idle"
    pieces = [state]
    if payload.get("pid") is not None:
        pieces.append(f"pid={payload['pid']}")
    if payload.get("age_seconds") is not None:
        pieces.append(f"age={payload['age_seconds']}s")
    if payload.get("display_target"):
        pieces.append(f"target={payload['display_target']}")
    if payload.get("model"):
        pieces.append(f"model={payload['model']}")
    print(f"  {label}: " + " ".join(pieces))


print_section("Runtime")
render_runtime_line("tmux", runtime.get("tmux"))
render_runtime_line("inline", runtime.get("inline"))
print(
    "  processing: live={live} stale={stale}".format(
        live=(processing or {}).get("live", 0),
        stale=(processing or {}).get("stale", 0),
    )
)
print(
    "  tmux_queue: recording={recording} processing={processing}".format(
        recording=(tmux_queue or {}).get("recording", 0),
        processing=(tmux_queue or {}).get("processing", 0),
    )
)
print("")

print_section("Latest dictation")
if not isinstance(last_entry, dict):
    print("  No history entries yet.")
else:
    raw = str(last_entry.get("raw", "") or "")
    processed = str(last_entry.get("processed", "") or "")
    metrics = last_entry.get("metrics")
    if not isinstance(metrics, dict):
        metrics = {}
    print(
        "  mode/app: {mode} @ {app}".format(
            mode=last_entry.get("mode", "?") or "?",
            app=last_entry.get("app", "?") or "?",
        )
    )
    if last_entry.get("timestamp"):
        print(f"  timestamp: {last_entry['timestamp']}")
    print(f"  words: raw={word_count(raw)} processed={word_count(processed)}")
    metric_bits = []
    if metrics.get("record_ms") is not None:
        metric_bits.append(f"capture={format_ms_short(metrics.get('record_ms'))}")
    if metrics.get("total_ms") is not None:
        metric_bits.append(f"total={format_ms_short(metrics.get('total_ms'))}")
    if metrics.get("transcribe_ms") is not None:
        metric_bits.append(f"transcribe={format_ms_short(metrics.get('transcribe_ms'))}")
    if metrics.get("paste_ms") is not None:
        metric_bits.append(f"paste={format_ms_short(metrics.get('paste_ms'))}")
    if metric_bits:
        print("  timings: " + " ".join(metric_bits))
    preview = compact_text(processed or raw)
    print(f"  preview: {preview or '<empty>'}")
print("")

print_section("Bench")
total_records = bench.get("total_records", 0) if isinstance(bench, dict) else 0
subset_records = bench.get("subset_records", 0) if isinstance(bench, dict) else 0
if not total_records:
    print("  No bench data yet.")
else:
    print(f"  window: last {subset_records} of {total_records}")
    latest = bench.get("latest") if isinstance(bench, dict) else {}
    if isinstance(latest, dict) and latest:
        latest_parts = [
            latest.get("flow", "?"),
            latest.get("status", "?"),
            f"total={format_ms_short(latest.get('total_ms', 0))}",
            f"transcribe={format_ms_short(latest.get('transcribe_ms', 0))}",
            f"paste={format_ms_short(latest.get('paste_ms', 0))}",
        ]
        if latest.get("mode"):
            latest_parts.insert(2, f"mode={latest['mode']}")
        print("  latest: " + " ".join(str(part) for part in latest_parts if part))
    stages = bench.get("stages") if isinstance(bench, dict) else {}
    startup = bench.get("startup") if isinstance(bench, dict) else {}
    median_parts = []
    startup_total = (startup.get("total_ms") or {}).get("median") if isinstance(startup, dict) else None
    if startup_total:
        median_parts.append(f"startup={format_ms_short(startup_total)}")
    transcribe_median = (stages.get("transcribe_ms") or {}).get("median") if isinstance(stages, dict) else None
    if transcribe_median is not None and (stages.get("transcribe_ms") or {}).get("n", 0) > 0:
        median_parts.append(f"transcribe={format_ms_short(transcribe_median)}")
    total_median = (stages.get("total_ms") or {}).get("median") if isinstance(stages, dict) else None
    if total_median is not None and (stages.get("total_ms") or {}).get("n", 0) > 0:
        median_parts.append(f"total={format_ms_short(total_median)}")
    if median_parts:
        print("  medians: " + " ".join(median_parts))
    counts = bench.get("counts") if isinstance(bench, dict) else {}
    print(
        "  counts: flows[{flows}] statuses[{statuses}]".format(
            flows=fmt_counts((counts or {}).get("flows")),
            statuses=fmt_counts((counts or {}).get("statuses")),
        )
    )
print("")

print_section("More detail")
for command in commands:
    print(f"  {command}")
PYEOF

    if [[ -n "$iterations" && "$iteration" -ge "$iterations" ]]; then
      break
    fi

    sleep "$interval"
  done
}

bench_matrix() {
  local rounds_arg="${1:-}"
  local phrase_arg="${2:-}"
  local rounds="1"

  if [[ -n "$rounds_arg" ]]; then
    [[ "$rounds_arg" =~ ^[0-9]+$ ]] || die "usage: tmux-whisper bench-matrix [N] [phrase_file]"
    (( rounds_arg > 0 )) || die "usage: tmux-whisper bench-matrix [N] [phrase_file]"
    rounds="$rounds_arg"
  fi

  local mode="${DICTATE_BENCH_MATRIX_MODE:-code}"
  mode="$(canonical_mode_name "$mode")"
  if [[ ! -d "$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$mode")" ]]; then
    mode="code"
  fi

  local phrase_src=""
  local -a phrases=()
  if [[ -n "$phrase_arg" ]]; then
    phrase_src="$(expand_path "$phrase_arg")"
    [[ -f "$phrase_src" ]] || die "phrase file not found: $phrase_src"
    local line trimmed phrase_text
    while IFS= read -r line || [[ -n "$line" ]]; do
      trimmed="$(printf "%s" "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      [[ -z "$trimmed" ]] && continue
      [[ "$trimmed" == \#* ]] && continue
      phrase_text="$trimmed"
      if [[ "$trimmed" == *$'\t'* ]]; then
        # Optional phrase-file format: label<TAB>phrase text
        phrase_text="${trimmed#*$'\t'}"
        phrase_text="$(printf "%s" "$phrase_text" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      fi
      [[ -n "$phrase_text" ]] || continue
      phrases+=("$phrase_text")
    done <"$phrase_src"
  else
    phrase_src="<built-in>"
    phrases=(
      "health lag can you check the logs and send an update"
      "my app is called dot dictation tool and codex should stay capitalized"
      "colour behaviour and organise should stay in british spelling"
      "please summarise this in two short paragraphs and keep it concise"
      "i need a follow up pr for cleanup after this bench matrix run"
      "switch swiftbar off then on and confirm the plugin state"
    )
  fi

  (( ${#phrases[@]} > 0 )) || die "no benchmark phrases found: $phrase_src"

  local models_raw="${DICTATE_BENCH_MATRIX_MODELS:-fast,smart,qwen,gpt}"
  models_raw="$(printf "%s" "$models_raw" | tr ',' ' ')"
  local -a llm_models=()
  local token resolved existing seen
  for token in $models_raw; do
    case "$token" in
      fast|8b) resolved="llama3.1-8b" ;;
      smart|70b) resolved="llama-3.3-70b" ;;
      qwen|32b) resolved="qwen-3-32b" ;;
      gpt|oss) resolved="gpt-oss-120b" ;;
      *) resolved="$token" ;;
    esac
    [[ -n "$resolved" ]] || continue
    seen="0"
    if [[ "${#llm_models[@]}" -gt 0 ]]; then
      for existing in "${llm_models[@]}"; do
        if [[ "$existing" == "$resolved" ]]; then
          seen="1"
          break
        fi
      done
    fi
    [[ "$seen" == "1" ]] || llm_models+=("$resolved")
  done
  if [[ "${#llm_models[@]}" -eq 0 ]]; then
    llm_models=("${CFG_POSTPROCESS_LLM:-gpt-oss-120b}")
  fi

  local postprocess_available="0"
  [[ -n "${CEREBRAS_API_KEY:-}" ]] && postprocess_available="1"

  local total_combos="2"
  if [[ "$postprocess_available" == "1" ]]; then
    total_combos=$((2 + ${#llm_models[@]} * 2))
  fi

  local results_file
  results_file="$(mktemp "${TMPDIR:-/tmp}/dictate-bench-matrix.XXXXXX")" || die "failed to create bench-matrix temporary file"

  local clean_enabled="${DICTATE_CLEAN:-0}"
  local repeats_level="${DICTATE_REPEATS_LEVEL:-${CFG_CLEAN_REPEATS_LEVEL:-1}}"
  local progress_enabled="${DICTATE_BENCH_MATRIX_PROGRESS:-1}"

  local combo_idx=0
  local post_flag vocab_flag iter model phrase txt
  local model_label total_ms clean_ms post_ms vocab_ms
  local budget_profile_obs budget_words_obs budget_max_tokens_obs budget_chunk_words_obs budget_chunk_count_obs
  local stage_started_ms flow_started_ms run_repeats
  local input_norm output_norm changed
  local -a model_candidates=()

  for post_flag in 0 1; do
    if [[ "$post_flag" == "1" && "$postprocess_available" != "1" ]]; then
      continue
    fi

    if [[ "$post_flag" == "1" ]]; then
      model_candidates=("${llm_models[@]}")
    else
      model_candidates=("-")
    fi

    for vocab_flag in 0 1; do
      for model in "${model_candidates[@]}"; do
        combo_idx=$((combo_idx + 1))
        if bool_is_on "$progress_enabled"; then
          echo "bench-matrix: combo $combo_idx/$total_combos (model=$model post=$post_flag vocab=$vocab_flag)"
        fi

        for ((iter = 1; iter <= rounds; iter++)); do
          for phrase in "${phrases[@]}"; do
            flow_started_ms="$(now_ms)"
            budget_profile_obs=""
            budget_words_obs="0"
            budget_max_tokens_obs="0"
            budget_chunk_words_obs="0"
            budget_chunk_count_obs="0"
            stage_started_ms="$(now_ms)"
            txt="$(printf "%s" "$phrase" | sanitize_transcript_artifacts)"
            if [[ "$clean_enabled" == "1" ]]; then
              run_repeats="1"
              if [[ "$post_flag" == "1" ]] && ! bool_is_on "${DICTATE_REPEATS_WITH_POSTPROCESS:-0}"; then
                run_repeats="0"
              fi
              txt="$(printf "%s" "$txt" | clean_fillers)"
              if [[ "$run_repeats" == "1" && "$repeats_level" != "0" ]]; then
                txt="$(printf "%s" "$txt" | clean_repeats "$repeats_level")"
              fi
            fi
            clean_ms=$(( $(now_ms) - stage_started_ms ))

            post_ms=0
            if [[ "$post_flag" == "1" ]]; then
              local bench_obs_file=""
              stage_started_ms="$(now_ms)"
              bench_obs_file="$(mktemp "${TMPDIR:-/tmp}/dictate-bench-obs.XXXXXX" 2>/dev/null || true)"
              if [[ -n "$bench_obs_file" ]]; then
                txt="$(DICTATE_FORCE_MODE="$mode" DICTATE_LLM_MODEL="$model" DICTATE_POSTPROCESS_OBS_FILE="$bench_obs_file" postprocess_llm "$txt" "")"
                load_postprocess_obs_file "$bench_obs_file"
                rm -f "$bench_obs_file" 2>/dev/null || true
              else
                txt="$(DICTATE_FORCE_MODE="$mode" DICTATE_LLM_MODEL="$model" postprocess_llm "$txt" "")"
              fi
              txt="$(printf "%s" "$txt" | auto_paragraphs "$mode")"
              post_ms=$(( $(now_ms) - stage_started_ms ))
              budget_profile_obs="${DICTATE_LAST_POSTPROCESS_BUDGET_PROFILE:-}"
              budget_words_obs="${DICTATE_LAST_POSTPROCESS_BUDGET_WORD_COUNT:-0}"
              budget_max_tokens_obs="${DICTATE_LAST_POSTPROCESS_BUDGET_MAX_TOKENS:-0}"
              budget_chunk_words_obs="${DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_WORDS:-0}"
              budget_chunk_count_obs="${DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT:-0}"
            fi

            vocab_ms=0
            if [[ "$vocab_flag" == "1" ]]; then
              stage_started_ms="$(now_ms)"
              txt="$(printf "%s" "$txt" | apply_vocab_corrections "$mode")"
              vocab_ms=$(( $(now_ms) - stage_started_ms ))
            fi

            txt="$(printf "%s" "$txt" | normalize_british_spelling)"
            total_ms=$(( $(now_ms) - flow_started_ms ))

            input_norm="$(printf "%s" "$phrase" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
            output_norm="$(printf "%s" "$txt" | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
            changed="0"
            [[ "$output_norm" != "$input_norm" ]] && changed="1"

            model_label="$model"
            [[ "$post_flag" == "0" ]] && model_label="-"
            printf '%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\t%s\n' \
              "$model_label" "$post_flag" "$vocab_flag" "$total_ms" "$clean_ms" "$post_ms" "$vocab_ms" "$changed" \
              "$(bench_field "$budget_profile_obs")" "$(bench_field "$budget_words_obs")" "$(bench_field "$budget_max_tokens_obs")" "$(bench_field "$budget_chunk_words_obs")" "$(bench_field "$budget_chunk_count_obs")" >>"$results_file"
          done
        done
      done
    done
  done

  need python3
  python3 - "$results_file" "$mode" "$phrase_src" "${#phrases[@]}" "$rounds" "$postprocess_available" <<'PYEOF'
import collections, statistics, sys

path = sys.argv[1]
mode = sys.argv[2]
phrase_src = sys.argv[3]
phrase_count = int(sys.argv[4])
rounds = int(sys.argv[5])
post_available = sys.argv[6] == "1"

rows = []
with open(path, "r", encoding="utf-8", errors="replace") as fh:
    for line in fh:
        parts = line.rstrip("\n").split("\t")
        if len(parts) < 8:
            continue
        model, post, vocab, total_ms, clean_ms, post_ms, vocab_ms, changed = parts[:8]
        budget_profile = parts[8] if len(parts) > 8 else ""
        budget_words = parts[9] if len(parts) > 9 else "0"
        budget_max_tokens = parts[10] if len(parts) > 10 else "0"
        budget_chunk_words = parts[11] if len(parts) > 11 else "0"
        budget_chunk_count = parts[12] if len(parts) > 12 else "0"

        def to_int(v):
            try:
                return int(v)
            except Exception:
                return 0

        rows.append(
            {
                "model": model,
                "post": post,
                "vocab": vocab,
                "total_ms": to_int(total_ms),
                "clean_ms": to_int(clean_ms),
                "post_ms": to_int(post_ms),
                "vocab_ms": to_int(vocab_ms),
                "changed": 1 if changed == "1" else 0,
                "budget_profile": budget_profile or "",
                "budget_words": to_int(budget_words),
                "budget_max_tokens": to_int(budget_max_tokens),
                "budget_chunk_words": to_int(budget_chunk_words),
                "budget_chunk_count": to_int(budget_chunk_count),
            }
        )

if not rows:
    print("No bench-matrix samples produced.")
    raise SystemExit(0)

def percentile(values, pct):
    if not values:
        return 0
    vals = sorted(values)
    if len(vals) == 1:
        return vals[0]
    pos = (len(vals) - 1) * pct
    lo = int(pos)
    hi = min(lo + 1, len(vals) - 1)
    frac = pos - lo
    return int(round(vals[lo] * (1 - frac) + vals[hi] * frac))

groups = collections.defaultdict(list)
for row in rows:
    groups[(row["model"], row["post"], row["vocab"])].append(row)

def sort_key(item):
    model, post, vocab = item[0]
    post_val = 1 if post == "1" else 0
    vocab_val = 1 if vocab == "1" else 0
    model_val = model if model != "-" else ""
    return (post_val, model_val, vocab_val)

print("Tmux Whisper bench-matrix")
print(f"Mode: {mode}")
print(f"Phrases: {phrase_count} (source: {phrase_src})")
print(f"Rounds: {rounds}")
print(f"Samples: {len(rows)}")
if not post_available:
    print("Note: postprocess=on combos skipped (CEREBRAS_API_KEY not set).")
print("")
print("llm_model          postproc vocab n   changed(n) total(ms) med/p90/max  clean med  postproc med  vocab med")

for (model, post, vocab), bucket in sorted(groups.items(), key=sort_key):
    totals = [r["total_ms"] for r in bucket]
    cleans = [r["clean_ms"] for r in bucket]
    posts = [r["post_ms"] for r in bucket if r["post_ms"] > 0]
    vocabs = [r["vocab_ms"] for r in bucket if r["vocab_ms"] > 0]
    changed = sum(r["changed"] for r in bucket)
    n = len(bucket)

    model_label = "(n/a)" if model == "-" else model
    post_label = "on" if post == "1" else "off"
    vocab_label = "on" if vocab == "1" else "off"
    total_cell = f"{int(statistics.median(totals))}/{percentile(totals, 0.90)}/{max(totals)}"
    clean_med = int(statistics.median(cleans)) if cleans else 0
    post_med = int(statistics.median(posts)) if posts else 0
    vocab_med = int(statistics.median(vocabs)) if vocabs else 0
    changed_cell = f"{changed}/{n}"

    print(
        f"{model_label:<18} {post_label:<8} {vocab_label:<5} {n:<3} {changed_cell:<8} "
        f"{total_cell:<20} {clean_med:<9} {post_med:<12} {vocab_med:<9}"
    )

post_budget_rows = [r for r in rows if r["post"] == "1" and r.get("budget_profile")]
if post_budget_rows:
    print("")
    print("Budget auto observability (postprocess rows)")
    profile_counts = collections.Counter(r["budget_profile"] for r in post_budget_rows if r.get("budget_profile"))
    if profile_counts:
        print("  profile counts: " + ", ".join(f"{k}={v}" for k, v in sorted(profile_counts.items())))

    def metric_line(name, key):
        vals = [int(r.get(key, 0)) for r in post_budget_rows if int(r.get(key, 0)) > 0]
        if not vals:
            return f"  {name}: n=0"
        return (
            f"  {name}: n={len(vals)} "
            f"median={int(statistics.median(vals))} "
            f"p90={percentile(vals, 0.90)} max={max(vals)}"
        )

    print(metric_line("word_count", "budget_words"))
    print(metric_line("max_tokens", "budget_max_tokens"))
    print(metric_line("chunk_words", "budget_chunk_words"))
    print(metric_line("chunk_count", "budget_chunk_count"))
PYEOF

  rm -f "$results_file" 2>/dev/null || true
}

# LLM post-processing via Cerebras API
postprocess_llm() {
  local input="$1"
  local target_app="${2:-}"
  local obs_file="${DICTATE_POSTPROCESS_OBS_FILE:-}"

  if [[ -n "$obs_file" ]]; then
    : >"$obs_file" 2>/dev/null || true
  fi

  # Per-run observability snapshot (consumed by save_history/history stats).
  DICTATE_LAST_POSTPROCESS_BUDGET_OBS_ACTIVE="0"
  DICTATE_LAST_POSTPROCESS_BUDGET_PROFILE=""
  DICTATE_LAST_POSTPROCESS_BUDGET_THRESHOLD=""
  DICTATE_LAST_POSTPROCESS_BUDGET_WORD_COUNT=""
  DICTATE_LAST_POSTPROCESS_BUDGET_MAX_TOKENS=""
  DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_WORDS=""
  DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT=""
  DICTATE_LAST_POSTPROCESS_BUDGET_LLM_MODEL=""
  
  if [[ -z "${CEREBRAS_API_KEY:-}" ]]; then
    echo "$input"
    return 0
  fi

  write_postprocess_obs_file() {
    [[ -n "$obs_file" ]] || return 0
    {
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_OBS_ACTIVE=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_OBS_ACTIVE:-0}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_PROFILE=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_PROFILE:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_THRESHOLD=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_THRESHOLD:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_WORD_COUNT=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_WORD_COUNT:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_MAX_TOKENS=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_MAX_TOKENS:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_WORDS=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_WORDS:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT:-}"
      printf 'DICTATE_LAST_POSTPROCESS_BUDGET_LLM_MODEL=%q\n' "${DICTATE_LAST_POSTPROCESS_BUDGET_LLM_MODEL:-}"
    } >"$obs_file" 2>/dev/null || true
  }
  
  local current_mode
  current_mode="$(get_current_mode "$target_app")"
  local current_mode_key
  current_mode_key="$(mode_override_key "$current_mode")"
  local budget_profile_key
  
  lookup_override() {
    local list="${1:-}"
    local key="${2:-}"
    [[ -n "$list" && -n "$key" ]] || return 1
    local IFS=';'
    read -r -a pairs <<<"$list"
    local pair
    for pair in "${pairs[@]}"; do
      [[ "$pair" == "$key="* ]] && { echo "${pair#*=}"; return 0; }
    done
    return 1
  }

  lookup_override_for_mode() {
    local list="${1:-}"
    local key="${2:-}"
    lookup_override "$list" "$key" 2>/dev/null || true
  }

  budget_word_count_for_input() {
    local text="${1:-}"
    local word_count
    word_count="$(printf '%s' "$text" | wc -w | tr -d '[:space:]')"
    [[ "$word_count" =~ ^[0-9]+$ ]] || word_count="0"
    echo "$word_count"
  }

  budget_profile_for_input() {
    local text="${1:-}"
    local threshold="${DICTATE_LLM_BUDGET_LONG_WORDS_THRESHOLD:-${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-120}}"
    local word_count
    [[ "$threshold" =~ ^[0-9]+$ ]] || threshold="120"
    word_count="$(budget_word_count_for_input "$text")"
    if [[ "$word_count" -ge "$threshold" ]]; then
      echo "long"
    else
      echo "short"
    fi
  }

  resolve_budget_override() {
    local list="${1:-}"
    local mode_key="${2:-}"
    local budget_key="${3:-}"
    local val=""
    # Preserve custom mode-specific budget overrides if users define them.
    if [[ -n "$mode_key" && "$mode_key" != "short" && "$mode_key" != "long" ]]; then
      val="$(lookup_override_for_mode "$list" "$mode_key" 2>/dev/null || true)"
      [[ -n "$val" ]] && { echo "$val"; return 0; }
    fi
    lookup_override_for_mode "$list" "$budget_key" 2>/dev/null || true
  }

  resolve_budget_numeric_auto() {
    local list="${1:-}"
    local mode_key="${2:-}"
    local global_val="${3:-}"
    local text="${4:-}"
    local threshold="${DICTATE_LLM_BUDGET_LONG_WORDS_THRESHOLD:-${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-120}}"
    local mode_val short_val long_val fallback_key fallback_val
    local word_count delta scaled min_val max_val

    if [[ -n "$mode_key" && "$mode_key" != "short" && "$mode_key" != "long" ]]; then
      mode_val="$(lookup_override_for_mode "$list" "$mode_key" 2>/dev/null || true)"
      if [[ -n "$mode_val" ]]; then
        echo "$mode_val"
        return 0
      fi
    fi

    short_val="$(lookup_override_for_mode "$list" "short" 2>/dev/null || true)"
    long_val="$(lookup_override_for_mode "$list" "long" 2>/dev/null || true)"
    [[ "$threshold" =~ ^[0-9]+$ ]] || threshold="120"
    word_count="$(budget_word_count_for_input "$text")"

    if [[ "$short_val" =~ ^[0-9]+$ && "$long_val" =~ ^[0-9]+$ && "$threshold" -gt 0 ]]; then
      if [[ "$word_count" -ge "$threshold" ]]; then
        echo "$long_val"
        return 0
      fi
      if [[ "$word_count" -le 0 ]]; then
        echo "$short_val"
        return 0
      fi
      delta=$(( long_val - short_val ))
      scaled=$(( short_val + (delta * word_count) / threshold ))
      if [[ "$short_val" -le "$long_val" ]]; then
        min_val="$short_val"; max_val="$long_val"
      else
        min_val="$long_val"; max_val="$short_val"
      fi
      [[ "$scaled" -lt "$min_val" ]] && scaled="$min_val"
      [[ "$scaled" -gt "$max_val" ]] && scaled="$max_val"
      echo "$scaled"
      return 0
    fi

    if [[ "$word_count" -ge "$threshold" ]]; then
      fallback_key="long"
    else
      fallback_key="short"
    fi
    fallback_val="$(lookup_override_for_mode "$list" "$fallback_key" 2>/dev/null || true)"
    [[ -n "$fallback_val" ]] && echo "$fallback_val" || echo "$global_val"
  }

  local llm_model="llama3.1-8b"
  [[ -n "${CFG_POSTPROCESS_LLM:-}" ]] && llm_model="$CFG_POSTPROCESS_LLM"
  budget_profile_key="$(budget_profile_for_input "$input")"
  local budget_word_count budget_threshold
  budget_word_count="$(budget_word_count_for_input "$input")"
  budget_threshold="${DICTATE_LLM_BUDGET_LONG_WORDS_THRESHOLD:-${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-120}}"
  [[ "$budget_threshold" =~ ^[0-9]+$ ]] || budget_threshold="120"
  if [[ -n "${DICTATE_LLM_MODEL:-}" ]]; then
    llm_model="$DICTATE_LLM_MODEL"
  else
    local llm_override=""
    llm_override="$(lookup_override_for_mode "${CFG_POSTPROCESS_MODE_LLM_OVERRIDES:-}" "$current_mode_key" 2>/dev/null || true)"
    if [[ -z "$llm_override" ]]; then
      llm_override="$(lookup_override_for_mode "${CFG_POSTPROCESS_BUDGET_PROFILE_LLM_OVERRIDES:-}" "$budget_profile_key" 2>/dev/null || true)"
    fi
    [[ -n "$llm_override" ]] && llm_model="$llm_override"
  fi

  local system_prompt
  system_prompt="$(build_mode_prompt "$current_mode")"

  local max_tokens=""
  local chunk_words=""
  if [[ -n "${DICTATE_LLM_MAX_TOKENS:-}" ]]; then
    max_tokens="$DICTATE_LLM_MAX_TOKENS"
  else
    max_tokens="$(resolve_budget_numeric_auto "${CFG_POSTPROCESS_BUDGET_PROFILE_MAX_TOKENS_OVERRIDES:-}" "$current_mode_key" "${CFG_POSTPROCESS_MAX_TOKENS:-}" "$input" 2>/dev/null || true)"
    [[ -z "$max_tokens" ]] && max_tokens="${CFG_POSTPROCESS_MAX_TOKENS:-}"
  fi

  if [[ -n "${DICTATE_LLM_CHUNK_WORDS:-}" ]]; then
    chunk_words="$DICTATE_LLM_CHUNK_WORDS"
  else
    chunk_words="$(resolve_budget_numeric_auto "${CFG_POSTPROCESS_BUDGET_PROFILE_CHUNK_WORDS_OVERRIDES:-}" "$current_mode_key" "${CFG_POSTPROCESS_CHUNK_WORDS:-}" "$input" 2>/dev/null || true)"
    [[ -z "$chunk_words" ]] && chunk_words="${CFG_POSTPROCESS_CHUNK_WORDS:-}"
  fi
  [[ -z "$chunk_words" ]] && chunk_words="0"

  DICTATE_LAST_POSTPROCESS_BUDGET_OBS_ACTIVE="1"
  DICTATE_LAST_POSTPROCESS_BUDGET_PROFILE="$budget_profile_key"
  DICTATE_LAST_POSTPROCESS_BUDGET_THRESHOLD="$budget_threshold"
  DICTATE_LAST_POSTPROCESS_BUDGET_WORD_COUNT="$budget_word_count"
  DICTATE_LAST_POSTPROCESS_BUDGET_MAX_TOKENS="${max_tokens:-}"
  DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_WORDS="${chunk_words:-}"
  DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT="1"
  DICTATE_LAST_POSTPROCESS_BUDGET_LLM_MODEL="${llm_model:-}"

  maybe_reject_llm_output() {
    local input_chunk="$1"
    local output_text="$2"
    local mode="$3"

    local in_trim out_trim
    in_trim="$(printf '%s' "$input_chunk" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
    out_trim="$(printf '%s' "$output_text" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"

    case "$(mode_override_key "$mode")" in
      code)
        # Guardrail: in code mode, we want cleaned instructions, not generated artefacts.
        if [[ ! "$in_trim" =~ ^[\\{\\[] ]] && [[ "$out_trim" =~ ^[\\{\\[] ]]; then
          if printf '%s' "$out_trim" | grep -Eq '"prompt"[[:space:]]*:'; then
            echo "$input_chunk"
            return 0
          fi
        fi
        if [[ "$out_trim" == '```'* && "$in_trim" != '```'* ]]; then
          echo "$input_chunk"
          return 0
        fi
        ;;
    esac

    echo "$output_text"
  }

  request_llm() {
    local chunk="$1"
    local escaped_input escaped_prompt
    escaped_input="$(printf '%s' "$chunk" | jq -Rs .)"
    escaped_prompt="$(printf '%s' "$system_prompt" | jq -Rs .)"

    local timeout="${DICTATE_LLM_TIMEOUT:-20}"
    local response=""
    local curl_rc=0
    local max_tokens_json=""
    if [[ -n "$max_tokens" ]]; then
      max_tokens_json=", \"max_tokens\": ${max_tokens}"
    fi
    set +e
    response="$(curl -sS --fail-with-body --connect-timeout 3 --max-time "$timeout" https://api.cerebras.ai/v1/chat/completions \
      -H "Authorization: Bearer $CEREBRAS_API_KEY" \
      -H "Content-Type: application/json" \
      -d '{
        "model": "'"$llm_model"'",
        "messages": [
          {"role": "system", "content": '"$escaped_prompt"'},
          {"role": "user", "content": '"$escaped_input"'}
        ],
        "temperature": 0.0'"$max_tokens_json"'
      }' 2>&1)"
    curl_rc=$?
    set -e
    if [[ "$curl_rc" -ne 0 ]]; then
      if keep_logs_enabled; then
        printf "[%s] LLM request failed (curl=%s, timeout=%s, mode=%s, model=%s)\n%s\n\n" \
          "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$curl_rc" "$timeout" "$current_mode" "$llm_model" "$response" \
          >>"$TMPDIR/whisper-dictate.llm.log" 2>/dev/null || true
      fi
      echo "$chunk"
      return 0
    fi

    local result
    result="$(printf '%s' "$response" | jq -r '.choices[0].message.content // empty' 2>/dev/null)"

    if [[ -n "$result" && "$result" != "null" ]]; then
      result="$(maybe_reject_llm_output "$chunk" "$result" "$current_mode")"
      echo "$result"
      return 0
    fi

    local api_error=""
    api_error="$(printf '%s' "$response" | jq -r '.error.message // .error // empty' 2>/dev/null)"
    if [[ -n "$api_error" ]]; then
      if keep_logs_enabled; then
        printf "[%s] LLM api error (mode=%s, model=%s): %s\n\n" \
          "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$current_mode" "$llm_model" "$api_error" \
          >>"$TMPDIR/whisper-dictate.llm.log" 2>/dev/null || true
      fi
      echo "$chunk"
      return 0
    fi
    if keep_logs_enabled; then
      printf "[%s] LLM response parse/empty (mode=%s, model=%s)\n%s\n\n" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$current_mode" "$llm_model" "$response" \
        >>"$TMPDIR/whisper-dictate.llm.log" 2>/dev/null || true
    fi
    echo "$chunk"
  }

  if [[ "$chunk_words" =~ ^[0-9]+$ && "$chunk_words" -gt 0 ]]; then
    local chunks
    chunks="$(
      python3 - "$chunk_words" <<'PYEOF'
import re, sys
max_words = int(sys.argv[1])
text = sys.stdin.read()
text = re.sub(r"\s+", " ", text).strip()
if not text:
    print("")
    raise SystemExit(0)
sentences = re.split(r'(?<=[.!?])\s+', text)
chunks = []
cur = []
count = 0
for s in sentences:
    w = len(re.findall(r"\b\w+\b", s))
    if count + w > max_words and cur:
        chunks.append(" ".join(cur).strip())
        cur = [s]
        count = w
    else:
        cur.append(s)
        count += w
if cur:
    chunks.append(" ".join(cur).strip())
print("\n<<DICTATE_CHUNK>>\n".join(chunks))
PYEOF
    <<<"$input")"
    if [[ -n "$chunks" ]]; then
      IFS=$'\n' read -r -d '' -a chunk_list < <(printf '%s' "$chunks" | awk 'BEGIN{RS="<<DICTATE_CHUNK>>"; ORS="\0"} {print}')
      local output="" first="1"
      local chunk_count_used="0"
      for c in "${chunk_list[@]}"; do
        c="$(printf "%s" "$c" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
        [[ -z "$c" ]] && continue
        chunk_count_used=$((chunk_count_used + 1))
        local part
        part="$(request_llm "$c")"
        if [[ "$first" == "1" ]]; then
          output="$part"
          first="0"
        else
          output="${output}"$'\n\n'"$part"
        fi
      done
      if [[ "$chunk_count_used" =~ ^[0-9]+$ && "$chunk_count_used" -gt 0 ]]; then
        DICTATE_LAST_POSTPROCESS_BUDGET_CHUNK_COUNT="$chunk_count_used"
      fi
      write_postprocess_obs_file
      echo "$output"
      return 0
    fi
  fi

  write_postprocess_obs_file
  request_llm "$input"
}

devices() {
  need ffmpeg
  local json_output="0"
  case "${1:-}" in
    "") ;;
    --json) json_output="1" ;;
    *) die "usage: tmux-whisper devices [--json]" ;;
  esac

  # ffmpeg prints an expected "Error opening input" after listing devices; hide that noise.
  # On some macOS setups, device enumeration can fail entirely (e.g., missing Microphone permission).
  local out trimmed
  out="$(ffmpeg -hide_banner -f avfoundation -list_devices true -i "" 2>&1 || true)"
  trimmed="$(printf "%s\n" "$out" | awk '/Error opening input/ { exit } { print }' || true)"

  if [[ "$json_output" == "1" ]]; then
    DEVICES_LISTING_RAW="$trimmed" DEVICES_FULL_RAW="$out" python3 - <<'PYEOF'
import json
import os
import re

listing = os.environ.get("DEVICES_LISTING_RAW", "")
full_raw = os.environ.get("DEVICES_FULL_RAW", "")
devices = []
in_audio = False

for line in listing.splitlines():
    if "AVFoundation audio devices:" in line:
        in_audio = True
        continue
    if "AVFoundation video devices:" in line:
        in_audio = False
        continue
    if not in_audio:
        continue
    match = re.search(r"\[(\d+)\]\s+(.*)$", line)
    if not match:
        continue
    devices.append({
        "index": int(match.group(1)),
        "name": match.group(2),
    })

hint = None
if not devices and "Input/output error" in full_raw:
    hint = "On macOS, grant Microphone permission to your terminal app (System Settings -> Privacy & Security -> Microphone), then rerun: tmux-whisper devices"

print(json.dumps({
    "command": "devices",
    "platform": "macos",
    "count": len(devices),
    "devices": devices,
    "permission_hint": hint,
}, indent=2, sort_keys=True))
PYEOF
    return 0
  fi

  printf "%s\n" "$trimmed"

  # If no indices were printed, show a hint for the common macOS failure mode.
  if ! printf "%s\n" "$trimmed" | grep -Eq '\[[0-9]+\]'; then
    if printf "%s\n" "$out" | grep -q "Input/output error"; then
      echo ""
      echo "No devices listed (ffmpeg: Input/output error)."
      echo "Tip: On macOS, grant Microphone permission to your terminal app (System Settings → Privacy & Security → Microphone), then rerun: tmux-whisper devices"
    fi
  fi
}

sleep_ms() {
  local ms="${1:-0}"
  if [[ -z "$ms" || ! "$ms" =~ ^[0-9]+$ ]]; then
    ms=0
  fi
  if (( ms <= 0 )); then
    return 0
  fi
  local sec=$((ms / 1000))
  local rem=$((ms % 1000))
  sleep "${sec}.$(printf '%03d' "$rem")"
}

bool_is_on() {
  local raw="${1:-}"
  local v
  v="$(printf "%s" "$raw" | tr '[:upper:]' '[:lower:]')"
  case "$v" in
    1|true|yes|on) return 0 ;;
    *) return 1 ;;
  esac
}

tmux_pane_child_command() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || return 0

  local pane_pid=""
  pane_pid="$(tmux display-message -p -t "$pane" '#{pane_pid}' 2>/dev/null || true)"
  if [[ -z "$pane_pid" || ! "$pane_pid" =~ ^[0-9]+$ ]]; then
    return 0
  fi

  local child_pid=""
  child_pid="$(/usr/bin/pgrep -P "$pane_pid" 2>/dev/null | head -n 1 || true)"
  if [[ -z "$child_pid" || ! "$child_pid" =~ ^[0-9]+$ ]]; then
    return 0
  fi

  /bin/ps -p "$child_pid" -o command= 2>/dev/null | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' || true
}

tmux_pane_tty_name() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || return 0

  local tty=""
  tty="$(tmux display-message -p -t "$pane" '#{pane_tty}' 2>/dev/null || true)"
  tty="$(printf "%s" "$tty" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  tty="${tty#/dev/}"
  tty="${tty##*/}"

  [[ -n "$tty" && "$tty" != "??" ]] || return 0
  printf "%s" "$tty"
}

tmux_pane_foreground_command() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || return 0

  local tty=""
  tty="$(tmux_pane_tty_name "$pane")"
  [[ -n "$tty" ]] || return 0

  # Use terminal foreground process group (tpgid) to find the active program in the pane.
  # This is more reliable than "first child of shell" when the shell has background jobs.
  local tpgid=""
  tpgid="$(/bin/ps -t "$tty" -o tpgid= 2>/dev/null | awk 'NF { print $1; exit }' || true)"
  if [[ -z "$tpgid" || ! "$tpgid" =~ ^[0-9]+$ || "$tpgid" == "0" ]]; then
    return 0
  fi

  /bin/ps -p "$tpgid" -o command= 2>/dev/null | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//' || true
}

tmux_should_use_codex_send() {
  local pane_cmd="${1:-}"
  local child_cmd="${2:-}"

  case "$pane_cmd" in
    codex*) return 0 ;;
  esac
  local exe="" arg1=""
  exe="$(printf "%s" "$child_cmd" | awk '{print $1}' || true)"
  arg1="$(printf "%s" "$child_cmd" | awk '{print $2}' || true)"
  case "$exe" in
    codex|*/codex) return 0 ;;
  esac
  # Handle shebang wrappers where the interpreter is first (node/python) and the script path is arg1.
  case "$arg1" in
    codex|*/codex) return 0 ;;
  esac

  return 1
}

tmux_short_path() {
  local p="${1:-}"
  [[ -n "$p" ]] || return 0
  p="${p%/}"
  [[ -z "$p" ]] && { echo "/"; return 0; }
  local base parent
  base="$(basename "$p")"
  parent="$(basename "$(dirname "$p")")"
  if [[ "$parent" == "/" || "$parent" == "." || "$parent" == "$base" ]]; then
    echo "$base"
  else
    echo "$parent/$base"
  fi
}

tmux_describe_pane() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || return 0
  local label="$pane"
  local title path
  title="$(tmux display-message -p -t "$pane" '#{pane_title}' 2>/dev/null || true)"
  path="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"
  path="$(tmux_short_path "$path")"
  [[ -n "$title" ]] && label="$label · $title"
  [[ -n "$path" ]] && label="$label · $path"
  echo "$label"
}

tmux_pane_cwd_label() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || { echo "target"; return 0; }
  local path title
  path="$(tmux display-message -p -t "$pane" '#{pane_current_path}' 2>/dev/null || true)"
  title="$(tmux display-message -p -t "$pane" '#{pane_title}' 2>/dev/null || true)"
  if [[ -n "$path" ]]; then
    path="${path%/}"
    [[ -z "$path" ]] && { echo "/"; return 0; }
    basename "$path"
    return 0
  fi
  if [[ -n "$title" ]]; then
    echo "$title"
    return 0
  fi
  echo "target"
}

tmux_resolve_invoking_pane() {
  # Prefer TMUX_PANE from the invoking shell; this is the most precise origin pane.
  if [[ -n "${TMUX_PANE:-}" ]]; then
    if tmux display-message -p -t "$TMUX_PANE" '#{pane_id}' >/dev/null 2>&1; then
      printf "%s" "$TMUX_PANE"
      return 0
    fi
  fi

  if [[ -n "${TMUX:-}" ]]; then
    local active_pane=""
    active_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
    if [[ -n "$active_pane" ]] && tmux display-message -p -t "$active_pane" '#{pane_id}' >/dev/null 2>&1; then
      printf "%s" "$active_pane"
      return 0
    fi
  fi

  # Only use explicit env override as a final fallback.
  if [[ -n "${DICTATE_TARGET_PANE:-}" ]]; then
    if tmux display-message -p -t "$DICTATE_TARGET_PANE" '#{pane_id}' >/dev/null 2>&1; then
      printf "%s" "$DICTATE_TARGET_PANE"
      return 0
    fi
  fi

  return 1
}

tmux_pane_exists() {
  local pane="${1:-}"
  [[ -n "$pane" ]] || return 1
  tmux display-message -p -t "$pane" '#{pane_id}' >/dev/null 2>&1
}

tmux_autosend_after_paste() {
  local pane="${1:-}"
  local pane_cmd="" pane_fg="" pane_child="" send_mode=""
  local send_delay_ms="${DICTATE_TMUX_SEND_DELAY_MS:-90}"
  local codex_tab_delay_ms="${DICTATE_TMUX_CODEX_TAB_DELAY_MS:-35}"
  local effective_key="Enter"

  pane_cmd="$(tmux display-message -p -t "$pane" '#{pane_current_command}' 2>/dev/null || true)"
  pane_fg="$(tmux_pane_foreground_command "$pane")"
  pane_child=""
  if [[ -z "$pane_fg" ]]; then
    pane_child="$(tmux_pane_child_command "$pane")"
  fi
  send_mode="${DICTATE_TMUX_SEND_MODE:-${CFG_TMUX_SEND_MODE:-auto}}"
  send_mode="$(printf "%s" "$send_mode" | tr '[:upper:]' '[:lower:]' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  case "$send_mode" in
    auto|enter|codex) ;;
    *) send_mode="auto" ;;
  esac

  if [[ "$send_mode" == "auto" ]]; then
    # Prefer tmux foreground command for routing; child-process matching is a fallback.
    case "$pane_cmd" in
      codex*) send_mode="codex" ;;
      *)
        if tmux_should_use_codex_send "" "$pane_fg"; then
          send_mode="codex"
        elif tmux_should_use_codex_send "" "$pane_child"; then
          send_mode="codex"
        else
          send_mode="enter"
        fi
        ;;
    esac
  fi

  sleep_ms "$send_delay_ms"

  case "$send_mode" in
    codex)
      # Codex UI: Tab queues message, Enter confirms send.
      tmux send-keys -t "$pane" C-i
      sleep_ms "$codex_tab_delay_ms"
      tmux send-keys -t "$pane" Enter
      effective_key="C-i+Enter"
      ;;
    enter|*)
      # Enter-only send path.
      tmux send-keys -t "$pane" Enter
      ;;
  esac

  if keep_logs_enabled; then
    echo "[autosend] pane=$pane mode=$send_mode key=$effective_key pane_cmd=${pane_cmd:-<none>} fg_cmd=${pane_fg:-<none>} child_cmd=${pane_child:-<none>}" >&2
  fi
}

resolve_tmux_postprocess_requested() {
  # tmux postprocess is controlled by tmux-specific config/env.
  # Do not let DICTATE_POSTPROCESS override tmux behavior.
  local do_postprocess="${DICTATE_TMUX_POSTPROCESS:-${CFG_TMUX_POSTPROCESS:-${CFG_POSTPROCESS_ENABLED:-0}}}"
  if bool_is_on "$do_postprocess"; then
    echo "1"
  else
    echo "0"
  fi
}

resolve_tmux_postprocess_effective() {
  local requested
  requested="$(resolve_tmux_postprocess_requested)"
  if [[ "$requested" == "1" && -n "${CEREBRAS_API_KEY:-}" ]]; then
    echo "1"
  else
    echo "0"
  fi
}

start() {
  need ffmpeg
  need tmux

  local model_id
  model_id="$(current_transcribe_model_label)"
  local startup_started_ms startup_audio_ms startup_ffmpeg_live_ms startup_total_ms startup_audio_source
  startup_started_ms="$(now_ms)"
  startup_audio_ms=0
  startup_ffmpeg_live_ms=0
  startup_total_ms=0
  startup_audio_source="(none)"
  recording_resolve_audio_context "tmux" "0"
  local audio_index="$RECORDING_AUDIO_INDEX"
  local preferred_audio_name="$RECORDING_PREFERRED_AUDIO_NAME"
  local audio_cache_note="$RECORDING_AUDIO_CACHE_NOTE"
  startup_audio_ms="$RECORDING_AUDIO_MS"
  startup_audio_source="$RECORDING_AUDIO_SOURCE"

  if [[ -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    if kill -0 "${pid:-0}" 2>/dev/null; then
      die "already recording (pid=$pid). Run: tmux-whisper stop"
    fi
    rm -f "$STATE_FILE"
  fi

  local target_pane
  target_pane="$(tmux_resolve_invoking_pane || true)"
  if [[ -z "$target_pane" ]]; then
    die "not running inside tmux and DICTATE_TARGET_PANE is not set. Start tmux and run tmux-whisper from the target pane, set DICTATE_TARGET_PANE, or use: tmux-whisper inline"
  fi

  # Track tmux job for queue display.
  # Use ffmpeg pid (not this shell pid) so stale recording markers self-clean correctly.
  local job_id job_file
  job_id="tmux-$(date +%s)-$$"
  mkdir -p "$TMUX_JOBS_DIR" 2>/dev/null || true
  job_file="$TMUX_JOBS_DIR/$job_id"

  local wav
  wav="$TMPDIR/whisper-dictate-$$.wav"
  rm -f "$wav" 2>/dev/null || true

  # Record in background until 'tmux-whisper stop' sends SIGINT.
  : >"$RECORD_LOG" 2>/dev/null || true
  log_audio_cache_note_if_any "${audio_cache_note:-}" "$RECORD_LOG"
  local ffmpeg_live_started_ms
  ffmpeg_live_started_ms="$(now_ms)"
  local pid
  local spawned="0"
  local retry_allowed="0"

  if [[ -z "${DICTATE_AUDIO_INDEX:-}" && -n "$preferred_audio_name" ]]; then
    retry_allowed="1"
  fi

  while :; do
    ffmpeg \
      -hide_banner -nostdin -loglevel error \
      -f avfoundation -i ":${audio_index}" \
      -af "aresample=async=1000:first_pts=0" \
      -ac 1 -ar 16000 -c:a pcm_s16le \
      "$wav" >>"$RECORD_LOG" 2>&1 &
    pid="$!"
    spawned="1"

    # If ffmpeg fails immediately (common: missing mic permission), surface it now.
    sleep 0.2
    if kill -0 "$pid" 2>/dev/null; then
      break
    fi

    if [[ "$retry_allowed" == "1" ]]; then
      retry_allowed="0"
      clear_audio_index_cache
      if recording_retry_audio_index "$preferred_audio_name"; then
        audio_index="$RECORDING_AUDIO_INDEX"
        startup_audio_ms="$RECORDING_AUDIO_MS"
        startup_audio_source="$RECORDING_AUDIO_SOURCE"
        log_audio_cache_note_if_any "${RECORDING_AUDIO_CACHE_NOTE:-}" "$RECORD_LOG"
        continue
      fi
    fi

    rm -f "$wav" 2>/dev/null || true
    die "recording failed to start (ffmpeg exited). Check $RECORD_LOG and ensure your terminal app has Microphone permission (System Settings → Privacy & Security → Microphone)."
  done
  if [[ "$spawned" == "1" ]]; then
    startup_ffmpeg_live_ms=$(( $(now_ms) - ffmpeg_live_started_ms ))
  fi

  {
    echo "id=$job_id"
    echo "status=recording"
    echo "pane=$target_pane"
    echo "pid=$pid"
    echo "started_at=$(date +%s)"
  } >"$job_file" 2>/dev/null || true

  # Store state as shell-safe assignments.
  local record_started_ms
  record_started_ms="$(now_ms)"
  startup_total_ms=$(( record_started_ms - startup_started_ms ))
  (( startup_total_ms < 0 )) && startup_total_ms=0
  printf 'pid=%q\nwav=%q\ntarget_pane=%q\nmodel_id=%q\nlanguage=%q\njob_id=%q\nrecord_started_ms=%q\nstartup_total_ms=%q\nstartup_audio_ms=%q\nstartup_ffmpeg_live_ms=%q\nstartup_target_ms=%q\nstartup_audio_source=%q\n' \
    "$pid" "$wav" "$target_pane" "$model_id" "${DICTATE_LANGUAGE:-en}" "$job_id" "$record_started_ms" \
    "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "0" "$startup_audio_source" >"$STATE_FILE"

  local target_label
  target_label="$(tmux_pane_cwd_label "$target_pane")"
  echo "🎙️ RECORDING → ${target_label:-target}"
}

stop() {
  need tmux

  [[ -f "$STATE_FILE" ]] || die "not recording. Run: tmux-whisper start"

  # shellcheck disable=SC1090
  . "$STATE_FILE"
  local state_record_started_ms="${record_started_ms:-}"
  local startup_total_ms="${startup_total_ms:-0}"
  local startup_audio_ms="${startup_audio_ms:-0}"
  local startup_ffmpeg_live_ms="${startup_ffmpeg_live_ms:-0}"
  local startup_target_ms="${startup_target_ms:-0}"
  local startup_audio_source="${startup_audio_source:-}"
  local stop_requested_ms
  stop_requested_ms="$(now_ms)"
  rm -f "$STATE_FILE"

  [[ -n "${pid:-}" && -n "${wav:-}" && -n "${target_pane:-}" && -n "${model_id:-}" ]] || die "state file invalid; try: tmux-whisper start"
  local job_id="${job_id:-}"
  local record_ms="0"
  if [[ -n "$state_record_started_ms" && "$state_record_started_ms" =~ ^[0-9]+$ ]]; then
    record_ms=$((stop_requested_ms - state_record_started_ms))
    (( record_ms < 0 )) && record_ms=0
  fi

  # Stop recording.
  terminate_recording_pid "$pid" "$(resolve_stop_grace_ms "${DICTATE_STOP_GRACE_MS:-}" "700")" "$RECORD_LOG"

  local do_enter do_copy
  do_enter="${DICTATE_ENTER:-}"
  if [[ -z "$do_enter" ]]; then
    do_enter="${DICTATE_TMUX_AUTOSEND:-${CFG_TMUX_AUTOSEND:-1}}"
  fi
  do_copy="${DICTATE_COPY:-1}"
  if [[ "$do_copy" != "0" ]]; then
    need pbcopy
  fi

  # Update tmux job status → processing
  local job_file=""
  if [[ -n "$job_id" ]]; then
    job_file="$TMUX_JOBS_DIR/$job_id"
    mkdir -p "$TMUX_JOBS_DIR" 2>/dev/null || true
    {
      echo "id=$job_id"
      echo "status=processing"
      echo "pane=$target_pane"
      echo "pid=$$"
      echo "updated_at=$(date +%s)"
    } >"$job_file" 2>/dev/null || true
  fi

  (
    trap '' HUP
    set -euo pipefail
    trap '[[ -n "${job_file:-}" ]] && rm -f "$job_file" 2>/dev/null || true' EXIT

    local success="0"
    local transcribe_ms=0 clean_ms=0 postprocess_ms=0 paste_ms=0 total_ms=0
    local stage_started_ms flow_started_ms
    flow_started_ms="$(now_ms)"
    local do_process_sound="${DICTATE_TMUX_PROCESS_SOUND:-${CFG_TMUX_PROCESS_SOUND:-0}}"
    if [[ "$do_process_sound" == "1" ]]; then
      play_sound process
    fi

    # LLM post-processing if enabled (Cerebras API)
    # Tmux mode defaults to code mode unless explicitly configured.
    local do_postprocess
    do_postprocess="$(resolve_tmux_postprocess_effective)"
    local tmux_mode="${DICTATE_TMUX_MODE:-${CFG_TMUX_MODE:-code}}"
    tmux_mode="$(canonical_mode_name "$tmux_mode")"
    if ! mode_exists "$tmux_mode" || ! mode_allows_flow "$tmux_mode" "tmux"; then
      tmux_mode="$(first_mode_for_flow "tmux")"
    fi

    local txt
    local transcribe_rc=0
    local runtime_skip_silence_trim="0"
    if [[ "$do_postprocess" == "1" ]] && ! bool_is_on "${DICTATE_TRIM_WITH_POSTPROCESS:-0}"; then
      runtime_skip_silence_trim="1"
    fi
    stage_started_ms="$(now_ms)"
    set +e
    txt="$(DICTATE_RUNTIME_SKIP_SILENCE_TRIM="$runtime_skip_silence_trim" transcribe_audio "$wav" "$model_id" "${language:-en}" "" "tmux")"
    transcribe_rc=$?
    set -e
    transcribe_ms=$(( $(now_ms) - stage_started_ms ))
    if [[ "$transcribe_rc" -ne 0 ]]; then
      echo "[tmux-async] transcribe failed rc=$transcribe_rc"
      rm -f "$wav" 2>/dev/null || true
      total_ms=$(( $(now_ms) - flow_started_ms ))
      append_bench_entry "tmux" "transcribe_failed" "$model_id" "$tmux_mode" "$do_postprocess" "0" "0" "$record_ms" "$transcribe_ms" "0" "0" "0" "$total_ms" \
        "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
      exit 1
    fi
    stage_started_ms="$(now_ms)"
    txt="$(printf "%s" "$txt" | sanitize_transcript_artifacts)"
    # Clean filler words / stutters (regex-based, fast)
    if [[ "${DICTATE_CLEAN:-0}" == "1" ]]; then
      local run_repeats="1"
      if [[ "$do_postprocess" == "1" ]] && ! bool_is_on "${DICTATE_REPEATS_WITH_POSTPROCESS:-0}"; then
        run_repeats="0"
      fi
      txt="$(printf "%s" "$txt" | clean_fillers)"
      if [[ "$run_repeats" == "1" ]]; then
        local repeats_level="${DICTATE_REPEATS_LEVEL:-${CFG_CLEAN_REPEATS_LEVEL:-1}}"
        if [[ "$repeats_level" != "0" ]]; then
          txt="$(printf "%s" "$txt" | clean_repeats "$repeats_level")"
        fi
      fi
    fi
    clean_ms=$(( $(now_ms) - stage_started_ms ))
    if [[ -z "${txt//[[:space:]]/}" ]]; then
      rm -f "$wav"
      total_ms=$(( $(now_ms) - flow_started_ms ))
      append_bench_entry "tmux" "no_speech" "$model_id" "$tmux_mode" "$do_postprocess" "0" "0" "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" \
        "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
      if keep_logs_enabled; then
        echo "[transcribe] empty after artifact cleanup; skipping paste/send" >>"$TRANSCRIBE_LOG"
      fi
      exit 0
    fi

    # Save raw transcript for history
    local raw_txt="$txt"

    if [[ "$do_postprocess" == "1" ]]; then
      stage_started_ms="$(now_ms)"
      # Signal processing for SwiftBar
      local proc_file="/tmp/dictate-processing/tmux-$$"
      mkdir -p /tmp/dictate-processing
      touch "$proc_file"

      # Force tmux mode (default: code)
      local tmux_postprocess_obs_file=""
      tmux_postprocess_obs_file="$(mktemp "${TMPDIR:-/tmp}/dictate-tmux-postprocess-obs.XXXXXX" 2>/dev/null || true)"
      if [[ -n "$tmux_postprocess_obs_file" ]]; then
        txt="$(DICTATE_FORCE_MODE="$tmux_mode" DICTATE_POSTPROCESS_OBS_FILE="$tmux_postprocess_obs_file" postprocess_llm "$txt" "Ghostty")"
        load_postprocess_obs_file "$tmux_postprocess_obs_file"
        rm -f "$tmux_postprocess_obs_file" 2>/dev/null || true
      else
        txt="$(DICTATE_FORCE_MODE="$tmux_mode" postprocess_llm "$txt" "Ghostty")"
      fi
      rm -f "$proc_file"
      # Signal "just processed" for SwiftBar
      touch /tmp/dictate-just-processed
      postprocess_ms=$(( $(now_ms) - stage_started_ms ))
    elif bool_is_on "${DICTATE_VOCAB_CLEAN:-1}"; then
      txt="$(printf "%s" "$txt" | apply_vocab_corrections "$tmux_mode")"
    fi

    txt="$(printf "%s" "$txt" | apply_mode_cleanup "$tmux_mode")"

    txt="$(printf "%s" "$txt" | normalize_british_spelling)"

    stage_started_ms="$(now_ms)"
    if [[ "$do_copy" != "0" ]]; then
      printf "%s" "$txt" | pbcopy
    fi

    local paste_target="${DICTATE_TMUX_PASTE_TARGET:-${CFG_TMUX_PASTE_TARGET:-origin}}"
    local dest_pane="$target_pane"
    if [[ "$paste_target" == "current" ]]; then
      local current_pane=""
      current_pane="$(tmux_resolve_invoking_pane || true)"
      if tmux_pane_exists "$current_pane"; then
        dest_pane="$current_pane"
      fi
    elif ! tmux_pane_exists "$dest_pane"; then
      local fallback_pane=""
      fallback_pane="$(tmux_resolve_invoking_pane || true)"
      if tmux_pane_exists "$fallback_pane"; then
        dest_pane="$fallback_pane"
      fi
    fi
    tmux set-buffer -b whisper_dictate -- "$txt"
    # -p: bracketed paste (when supported/requested by the app)
    # -r: preserve LF (avoid converting newlines to CR/"Enter")
    tmux paste-buffer -p -r -t "$dest_pane" -b whisper_dictate
    if [[ "$do_enter" != "0" ]]; then
      tmux_autosend_after_paste "$dest_pane"
    fi
    tmux delete-buffer -b whisper_dictate >/dev/null 2>&1 || true
    paste_ms=$(( $(now_ms) - stage_started_ms ))

    rm -f "$wav"

    total_ms=$(( $(now_ms) - flow_started_ms ))
    local raw_chars="${#raw_txt}"
    local out_chars="${#txt}"
    # Save to history (includes metrics and postprocess budget observability when available)
    save_history "$raw_txt" "$txt" "$tmux_mode" "tmux" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms"
    append_bench_entry "tmux" "ok" "$model_id" "$tmux_mode" "$do_postprocess" "$raw_chars" "$out_chars" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"

    # Sound when done
    play_sound stop

    success="1"
    if [[ "$success" == "1" ]] && ! keep_logs_enabled; then
      rm -f "$RECORD_LOG" "$TRANSCRIBE_LOG" 2>/dev/null || true
    fi
  ) >"$TRANSCRIBE_LOG" 2>&1 &

  local target_label
  target_label="$(tmux_pane_cwd_label "$target_pane")"
  echo "⏹️ STOPPED → transcribing → ${target_label:-target}"
}

# Cancel recording: stop without transcribing or pasting
cancel() {
  local state_file="${1:-$STATE_FILE}"
  local inline_state="$INLINE_STATE_FILE"
  local cancel_stop_grace_ms
  cancel_stop_grace_ms="$(resolve_stop_grace_ms "${DICTATE_STOP_GRACE_MS:-}" "700")"
  local cancel_record_log="$RECORD_LOG"
  
  # Check tmux state first, then inline
  local found=""
  if [[ -f "$state_file" ]]; then
    found="$state_file"
  elif [[ -f "$inline_state" ]]; then
    found="$inline_state"
    cancel_stop_grace_ms="$(resolve_inline_stop_grace_ms)"
    cancel_record_log="$TMPDIR/whisper-dictate-inline.record.log"
  fi
  
  if [[ -z "$found" ]]; then
    echo "Not recording (nothing to cancel)"
    return 0
  fi
  
  # shellcheck disable=SC1090
  . "$found"
  rm -f "$found"

  # Remove tmux job file if present
  if [[ -n "${job_id:-}" ]]; then
    rm -f "$TMUX_JOBS_DIR/$job_id" 2>/dev/null || true
  fi
  
  # Stop recording process
  if [[ -n "${pid:-}" ]]; then
    terminate_recording_pid "$pid" "$cancel_stop_grace_ms" "$cancel_record_log" "${control_fifo:-}" "${control_keeper_pid:-}"
  fi
  
  # Remove wav file without transcribing
  if [[ -n "${wav:-}" && -f "$wav" ]]; then
    rm -f "$wav"
  fi
  
  # Clear any processing markers
  rm -f /tmp/dictate-processing/* 2>/dev/null || true
  
  # Set cancel flag for SwiftBar (shows cancel icon briefly)
  touch /tmp/dictate-cancelled.flag
  
  play_sound cancel  # audible feedback that we cancelled
  echo "🚫 CANCELLED (recording discarded)"
}

inline_paste_via_osascript() {
  osascript -e 'tell application "System Events" to keystroke "v" using command down'
}

inline_send_key_via_osascript() {
  local send_mode="${1:-enter}"
  send_mode="$(normalize_inline_send_mode "$send_mode")"
  case "$send_mode" in
    ctrl_j)
      osascript -e 'tell application "System Events" to keystroke "j" using control down'
      ;;
    cmd_enter)
      osascript -e 'tell application "System Events" to key code 36 using command down'
      ;;
    *)
      osascript -e 'tell application "System Events" to key code 36'
      ;;
  esac
}

process_inline_recording() {
  local wav="$1"
  local target_app="${2:-}"
  local model_id="${3:-}"
  local record_ms="${4:-0}"
  local startup_total_ms="${5:-0}"
  local startup_audio_ms="${6:-0}"
  local startup_ffmpeg_live_ms="${7:-0}"
  local startup_target_ms="${8:-0}"
  local startup_audio_source="${9:-}"
  local inline_session_id="${10:-}"
  local stop_grace_ms="${11:-}"
  local processing_marker_owner="${12:-self}"

  need ffmpeg

  local inline_proc_file=""
  if [[ "$processing_marker_owner" == "external" && -n "$inline_session_id" ]]; then
    trap 'processing_marker_stop_by_session "$inline_session_id"; trap - RETURN' RETURN
  else
    processing_marker_start "inline" "$inline_session_id" 2>/dev/null || true
    inline_proc_file="$PROCESSING_MARKER_FILE"
    trap 'processing_marker_stop "$inline_proc_file"; trap - RETURN' RETURN
  fi

  local do_postprocess="${DICTATE_POSTPROCESS:-}"
  [[ -z "$do_postprocess" ]] && do_postprocess="${CFG_POSTPROCESS_ENABLED:-0}"
  if bool_is_on "$do_postprocess" && [[ -n "${CEREBRAS_API_KEY:-}" ]]; then
    do_postprocess="1"
  else
    do_postprocess="0"
  fi
  local detected_mode="none"
  local flow_started_ms
  local transcribe_ms=0 clean_ms=0 postprocess_ms=0 paste_ms=0 total_ms=0
  local stage_started_ms
  local paste_target
  paste_target="$(normalize_inline_paste_target "${DICTATE_INLINE_PASTE_TARGET:-${CFG_INLINE_PASTE_TARGET:-restore}}")"
  local record_log
  record_log="$TMPDIR/whisper-dictate-inline.record.log"
  local transcribe_log
  transcribe_log="$TMPDIR/whisper-dictate-inline.transcribe.log"
  local archive_prefix=""
  archive_prefix="$(inline_archive_prefix "$inline_session_id" 2>/dev/null || true)"
  local capture_wav_ms capture_wav_bytes capture_gap_to_record_ms capture_gap_to_record_plus_grace_ms
  capture_wav_ms=""
  capture_wav_bytes=""
  capture_gap_to_record_ms=""
  capture_gap_to_record_plus_grace_ms=""
  if [[ -s "$wav" ]]; then
    capture_wav_ms="$(audio_duration_ms "$wav" 2>/dev/null || true)"
    capture_wav_bytes="$(file_size_bytes "$wav" 2>/dev/null || true)"
    if [[ "$capture_wav_ms" =~ ^[0-9]+$ && "$record_ms" =~ ^[0-9]+$ ]]; then
      capture_gap_to_record_ms=$(( capture_wav_ms - record_ms ))
      if [[ "$stop_grace_ms" =~ ^[0-9]+$ ]]; then
        capture_gap_to_record_plus_grace_ms=$(( capture_wav_ms - record_ms - stop_grace_ms ))
      fi
    fi
  fi
  INLINE_STOP_GRACE_MS="$stop_grace_ms"
  INLINE_CAPTURE_WAV_MS="$capture_wav_ms"
  INLINE_CAPTURE_WAV_BYTES="$capture_wav_bytes"
  INLINE_CAPTURE_GAP_TO_RECORD_MS="$capture_gap_to_record_ms"
  INLINE_CAPTURE_GAP_TO_RECORD_PLUS_GRACE_MS="$capture_gap_to_record_plus_grace_ms"

  if keep_logs_enabled; then
    printf "[%s] inline_capture_snapshot: record_ms=%s stop_grace_ms=%s capture_wav_ms=%s capture_wav_bytes=%s gap_to_record_ms=%s gap_to_record_plus_grace_ms=%s\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$record_ms" "$stop_grace_ms" "${capture_wav_ms:-unknown}" "${capture_wav_bytes:-unknown}" \
      "${capture_gap_to_record_ms:-unknown}" "${capture_gap_to_record_plus_grace_ms:-unknown}" \
      >>"$record_log" 2>/dev/null || true
  fi

  local now_ms_value
  now_ms_value="$(now_ms)"
  flow_started_ms=$(( now_ms_value - record_ms ))
  if (( flow_started_ms < 0 )); then
    flow_started_ms="$now_ms_value"
  fi

  if [[ ! -s "$wav" ]]; then
    local hint=""
    if [[ -s "$record_log" ]]; then
      hint="$(tail -n 2 "$record_log" | tr '\n' ' ' | sed -E 's/[[:space:]]+/ /g; s/^ //; s/ $//')"
    fi
    if [[ -n "$hint" ]]; then
      echo "Recording failed ($hint)"
    else
      echo "No audio recorded"
    fi
    echo "Tip: On macOS, grant Microphone permission to your terminal app (System Settings → Privacy & Security → Microphone), then run: tmux-whisper devices"
    echo "Log: $record_log"
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "record_failed" "$model_id" "$detected_mode" "$do_postprocess" "0" "0" "$record_ms" "0" "0" "0" "0" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "record_failed" \
      "$record_ms" "0" "0" "0" "0" "$total_ms" "$inline_session_id"
    return 1
  fi
  if ! keep_logs_enabled; then
    rm -f "$record_log" 2>/dev/null || true
  fi

  local txt
  : >"$transcribe_log" 2>/dev/null || true
  local TRANSCRIBE_LOG="$transcribe_log"
  
  echo "⏳ Transcribing..."
  
  local whisper_rc=0
  local runtime_skip_silence_trim="0"
  if [[ "$do_postprocess" == "1" ]] && ! bool_is_on "${DICTATE_TRIM_WITH_POSTPROCESS:-0}"; then
    runtime_skip_silence_trim="1"
  fi
  stage_started_ms="$(now_ms)"
  set +e
  txt="$(DICTATE_RUNTIME_SKIP_SILENCE_TRIM="$runtime_skip_silence_trim" transcribe_audio "$wav" "$model_id" "${DICTATE_LANGUAGE:-en}" "" "inline")"
  whisper_rc=$?
  set -e
  transcribe_ms=$(( $(now_ms) - stage_started_ms ))
  if [[ "$whisper_rc" -ne 0 ]]; then
    echo "Transcription failed (backend exit $whisper_rc)"
    echo "Log: $transcribe_log"
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "transcribe_failed" "$model_id" "$detected_mode" "$do_postprocess" "0" "0" "$record_ms" "$transcribe_ms" "0" "0" "0" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "transcribe_failed" \
      "$record_ms" "$transcribe_ms" "0" "0" "0" "$total_ms" "$inline_session_id"
    return 1
  fi
  
  stage_started_ms="$(now_ms)"
  txt="$(printf "%s" "$txt" | sanitize_transcript_artifacts)"
  # Clean filler words / stutters if enabled (regex-based, fast)
  if [[ "${DICTATE_CLEAN:-0}" == "1" ]]; then
    local run_repeats="1"
    if [[ "$do_postprocess" == "1" ]] && ! bool_is_on "${DICTATE_REPEATS_WITH_POSTPROCESS:-0}"; then
      run_repeats="0"
    fi
    txt="$(printf "%s" "$txt" | clean_fillers)"
    if [[ "$run_repeats" == "1" ]]; then
      local repeats_level="${DICTATE_REPEATS_LEVEL:-${CFG_CLEAN_REPEATS_LEVEL:-1}}"
      if [[ "$repeats_level" != "0" ]]; then
        txt="$(printf "%s" "$txt" | clean_repeats "$repeats_level")"
      fi
    fi
  fi
  clean_ms=$(( $(now_ms) - stage_started_ms ))

  if [[ -z "${txt//[[:space:]]/}" ]]; then
    echo "No speech detected"
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "no_speech" "$model_id" "$detected_mode" "$do_postprocess" "0" "0" "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "no_speech" \
      "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" "$inline_session_id"
    return 1
  fi

  # Save raw transcript for history
  local raw_txt="$txt"
  detected_mode="$(get_current_mode "$target_app")"
  if ! mode_exists "$detected_mode" || ! mode_allows_flow "$detected_mode" "inline"; then
    detected_mode="$(default_inline_mode)"
  fi

  if ! inline_session_is_current "$inline_session_id"; then
    echo "Skipping stale inline result because a newer recording started."
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "superseded" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    local history_app="${target_app:-current}"
    ( save_history "$raw_txt" "$txt" "$detected_mode" "${history_app:-unknown}" "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" ) >/dev/null 2>&1 &
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "superseded_pre_postprocess" \
      "$record_ms" "$transcribe_ms" "$clean_ms" "0" "0" "$total_ms" "$inline_session_id"
    return 0
  fi

  if [[ "$do_postprocess" == "1" ]]; then
    stage_started_ms="$(now_ms)"
    echo "🤖 Post-processing ($detected_mode mode)..."

    local inline_postprocess_obs_file=""
    inline_postprocess_obs_file="$(mktemp "${TMPDIR:-/tmp}/dictate-inline-postprocess-obs.XXXXXX" 2>/dev/null || true)"
    if [[ -n "$inline_postprocess_obs_file" ]]; then
      txt="$(DICTATE_FORCE_MODE="$detected_mode" DICTATE_POSTPROCESS_OBS_FILE="$inline_postprocess_obs_file" postprocess_llm "$txt" "$target_app")"
      load_postprocess_obs_file "$inline_postprocess_obs_file"
      rm -f "$inline_postprocess_obs_file" 2>/dev/null || true
    else
      txt="$(DICTATE_FORCE_MODE="$detected_mode" postprocess_llm "$txt" "$target_app")"
    fi
    postprocess_ms=$(( $(now_ms) - stage_started_ms ))
  elif bool_is_on "${DICTATE_VOCAB_CLEAN:-1}"; then
    txt="$(printf "%s" "$txt" | apply_vocab_corrections "$detected_mode")"
  fi

  txt="$(printf "%s" "$txt" | apply_mode_cleanup "$detected_mode")"

  txt="$(printf "%s" "$txt" | normalize_british_spelling)"

  if ! inline_session_is_current "$inline_session_id"; then
    echo "Skipping stale inline result because a newer recording started."
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "superseded" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "0" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    local history_app="${target_app:-current}"
    ( save_history "$raw_txt" "$txt" "$detected_mode" "${history_app:-unknown}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "0" "$total_ms" ) >/dev/null 2>&1 &
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "superseded_post_postprocess" \
      "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "0" "$total_ms" "$inline_session_id"
    return 0
  fi
  
  stage_started_ms="$(now_ms)"
  # Copy to clipboard
  if ! printf "%s" "$txt" | pbcopy; then
    echo "Clipboard copy failed (pbcopy)."
    echo "Text:"
    echo "$txt"
    paste_ms=$(( $(now_ms) - stage_started_ms ))
    total_ms=$(( $(now_ms) - flow_started_ms ))
    append_bench_entry "inline" "clipboard_failed" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
    archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "clipboard_failed" \
      "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" "$inline_session_id"
    return 1
  fi
  
  # Determine paste target based on config/env
  # "restore/origin" = use app from recording start (target_app captured at start)
  # "current" = paste to whatever is frontmost now
  local activate_delay_ms="${DICTATE_INLINE_ACTIVATE_DELAY_MS:-90}"
  local send_delay_default_ms="35"
  local send_delay_ms="${DICTATE_INLINE_SEND_DELAY_MS:-$send_delay_default_ms}"
  local inline_send_mode
  inline_send_mode="$(normalize_inline_send_mode "${DICTATE_INLINE_SEND_MODE:-${CFG_INLINE_SEND_MODE:-enter}}")"
  [[ "$activate_delay_ms" =~ ^[0-9]+$ ]] || activate_delay_ms=90
  [[ "$send_delay_ms" =~ ^[0-9]+$ ]] || send_delay_ms="$send_delay_default_ms"

  # Auto-send (press Enter) unless disabled via env or config file
  local do_autosend="${DICTATE_AUTOSEND:-}"
  [[ -z "$do_autosend" ]] && do_autosend="${CFG_INLINE_AUTOSEND:-}"
  # Default to ON if not set
  [[ -z "$do_autosend" ]] && do_autosend="1"

  # Activate target app (best effort), then paste.
  # NOTE: `target_app` is the *process name* (e.g. "wezterm-gui"), which may not
  # match the app name for `tell application "X"`. Setting frontmost via System
  # Events works reliably with process names.
  local osa_err=""
  if [[ "$paste_target" == "restore" && -n "$target_app" ]]; then
    local target_app_escaped="${target_app//\"/\\\"}"
    if ! osa_err="$(osascript -e "tell application \"System Events\" to set frontmost of process \"$target_app_escaped\" to true" 2>&1)"; then
      echo "Warning: couldn't activate target app process: $target_app"
      [[ -n "$osa_err" ]] && echo "AppleScript: $osa_err"
    fi
    if (( activate_delay_ms > 0 )); then
      sleep_ms "$activate_delay_ms"
    fi
  fi

  if [[ "$do_autosend" == "1" ]]; then
    if ! osa_err="$(inline_paste_via_osascript 2>&1)"; then
      echo "Paste/send failed (text is on clipboard)."
      echo "Fix: System Settings → Privacy & Security → Accessibility → enable your terminal (WezTerm), and Automation → allow it to control System Events."
      [[ -n "$osa_err" ]] && echo "AppleScript: $osa_err"
      paste_ms=$(( $(now_ms) - stage_started_ms ))
      total_ms=$(( $(now_ms) - flow_started_ms ))
      append_bench_entry "inline" "autosend_failed" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
        "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
      archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "autosend_failed_paste" \
        "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" "$inline_session_id"
      return 1
    fi
    sleep_ms "$send_delay_ms"
    if ! osa_err="$(inline_send_key_via_osascript "$inline_send_mode" 2>&1)"; then
      echo "Paste/send failed (text is on clipboard)."
      echo "Fix: System Settings → Privacy & Security → Accessibility → enable your terminal (WezTerm), and Automation → allow it to control System Events."
      [[ -n "$osa_err" ]] && echo "AppleScript: $osa_err"
      paste_ms=$(( $(now_ms) - stage_started_ms ))
      total_ms=$(( $(now_ms) - flow_started_ms ))
      append_bench_entry "inline" "autosend_failed" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
        "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
      archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "autosend_failed_send" \
        "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" "$inline_session_id"
      return 1
    fi
    echo "✅ Sent ($(inline_send_mode_desc "$inline_send_mode"))"
  else
    if ! osa_err="$(inline_paste_via_osascript 2>&1)"; then
      echo "Paste failed (text is on clipboard)."
      echo "Fix: System Settings → Privacy & Security → Accessibility → enable your terminal (WezTerm), and Automation → allow it to control System Events."
      [[ -n "$osa_err" ]] && echo "AppleScript: $osa_err"
      paste_ms=$(( $(now_ms) - stage_started_ms ))
      total_ms=$(( $(now_ms) - flow_started_ms ))
      append_bench_entry "inline" "paste_failed" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
        "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"
      archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "paste_failed" \
        "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" "$inline_session_id"
      return 1
    fi
    echo "✅ Pasted (no Enter)"
  fi

  paste_ms=$(( $(now_ms) - stage_started_ms ))
  total_ms=$(( $(now_ms) - flow_started_ms ))
  append_bench_entry "inline" "ok" "$model_id" "$detected_mode" "$do_postprocess" "${#raw_txt}" "${#txt}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" \
    "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source"

  signal_just_processed
  play_sound stop

  archive_inline_debug_artifacts "$archive_prefix" "$wav" "$record_log" "$transcribe_log" "ok" \
    "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" "$inline_session_id"

  # Save history asynchronously so paste/send latency is not blocked by JSON + file I/O.
  local history_app="${target_app:-current}"
  ( save_history "$raw_txt" "$txt" "$detected_mode" "${history_app:-unknown}" "$record_ms" "$transcribe_ms" "$clean_ms" "$postprocess_ms" "$paste_ms" "$total_ms" ) >/dev/null 2>&1 &
}

inline_start() {
  need ffmpeg

  [[ ! -f "$INLINE_STATE_FILE" ]] || die "already recording. Run: tmux-whisper inline stop"

  local model_id
  model_id="$(current_transcribe_model_label)"
  local inline_session_id
  inline_session_id="$(generate_inline_session_id)"
  write_inline_latest_session "$inline_session_id"
  local startup_started_ms startup_total_ms startup_audio_ms startup_target_ms startup_ffmpeg_live_ms startup_audio_source
  startup_started_ms="$(now_ms)"
  startup_total_ms=0
  startup_audio_ms=0
  startup_target_ms=0
  startup_ffmpeg_live_ms=0
  startup_audio_source="(none)"
  local paste_target
  paste_target="$(normalize_inline_paste_target "${DICTATE_INLINE_PASTE_TARGET:-${CFG_INLINE_PASTE_TARGET:-restore}}")"
  recording_resolve_audio_context "inline" "1"
  local audio_index="$RECORDING_AUDIO_INDEX"
  local preferred_audio_name="$RECORDING_PREFERRED_AUDIO_NAME"
  local audio_cache_note="$RECORDING_AUDIO_CACHE_NOTE"
  local audio_selector="$RECORDING_AUDIO_SELECTOR"
  local audio_selector_kind="$RECORDING_AUDIO_SELECTOR_KIND"
  startup_audio_ms="$RECORDING_AUDIO_MS"
  startup_audio_source="$RECORDING_AUDIO_SOURCE"

  local target_app="${DICTATE_TARGET_APP:-}"
  if [[ "$paste_target" == "restore" && -z "$target_app" ]]; then
    local stage_started_ms
    stage_started_ms="$(now_ms)"
    target_app="$(osascript -e 'tell application "System Events" to get name of first process whose frontmost is true' 2>/dev/null || echo "Ghostty")"
    startup_target_ms=$(( $(now_ms) - stage_started_ms ))
  fi

  local wav
  wav="/tmp/dictate-inline-$$.wav"
  local record_log
  record_log="$TMPDIR/whisper-dictate-inline.record.log"
  : >"$record_log" 2>/dev/null || true
  log_audio_cache_note_if_any "${audio_cache_note:-}" "$record_log"

  local ffmpeg_started_ms record_started_ms pid attempt live_ok
  local control_fifo control_keeper_pid
  control_fifo=""
  control_keeper_pid=""
  ffmpeg_started_ms="$(now_ms)"
  local retry_allowed
  retry_allowed="0"
  if [[ -z "${DICTATE_AUDIO_INDEX:-}" && -n "$preferred_audio_name" ]]; then
    retry_allowed="1"
  fi

  while :; do
    control_fifo=""
    control_keeper_pid=""
    if start_recording_control_fifo "${TMPDIR:-/tmp}/dictate-inline-$$" 2>/dev/null; then
      control_fifo="$RECORDING_CONTROL_FIFO"
      control_keeper_pid="$RECORDING_CONTROL_KEEPER_PID"
    fi

    if [[ -n "$control_fifo" && -p "$control_fifo" ]]; then
      ffmpeg -hide_banner -loglevel error \
        -f avfoundation -i ":${audio_selector}" \
        -af "aresample=async=1000:first_pts=0" \
        -ac 1 -ar 16000 -c:a pcm_s16le \
        "$wav" <"$control_fifo" >>"$record_log" 2>&1 &
    else
      ffmpeg -hide_banner -nostdin -loglevel error \
        -f avfoundation -i ":${audio_selector}" \
        -af "aresample=async=1000:first_pts=0" \
        -ac 1 -ar 16000 -c:a pcm_s16le \
        "$wav" >>"$record_log" 2>&1 &
    fi
    pid=$!
    record_started_ms="$(now_ms)"
    startup_total_ms=$(( record_started_ms - startup_started_ms ))
    (( startup_total_ms < 0 )) && startup_total_ms=0

    live_ok="0"
    for attempt in {1..8}; do
      if kill -0 "$pid" 2>/dev/null; then
        live_ok="1"
        break
      fi
      sleep 0.02
    done
    startup_ffmpeg_live_ms=$(( $(now_ms) - ffmpeg_started_ms ))

    if [[ "$live_ok" == "1" ]]; then
      if keep_logs_enabled; then
        printf "[%s] inline_start: pid=%s record_started_ms=%s startup_ffmpeg_live_ms=%s selector=%s audio_source=%s wav=%q control_fifo=%q\n" \
          "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$pid" "$record_started_ms" "$startup_ffmpeg_live_ms" \
          "$audio_selector_kind" "$startup_audio_source" "$wav" "${control_fifo:-}" >>"$record_log" 2>/dev/null || true
      fi
      break
    fi

    cleanup_recording_control_fifo "$control_fifo" "$control_keeper_pid"
    control_fifo=""
    control_keeper_pid=""

    if [[ "$retry_allowed" == "1" ]]; then
      retry_allowed="0"
      if recording_retry_audio_index "$preferred_audio_name"; then
        audio_index="$RECORDING_AUDIO_INDEX"
        audio_selector="$RECORDING_AUDIO_SELECTOR"
        audio_selector_kind="$RECORDING_AUDIO_SELECTOR_KIND"
        startup_audio_ms="$RECORDING_AUDIO_MS"
        startup_audio_source="$RECORDING_AUDIO_SOURCE"
        log_audio_cache_note_if_any "${RECORDING_AUDIO_CACHE_NOTE:-}" "$record_log"
        continue
      fi
    fi

    break
  done

  if [[ "$live_ok" != "1" ]]; then
    cleanup_recording_control_fifo "$control_fifo" "$control_keeper_pid"
    rm -f "$wav" 2>/dev/null || true
    local hint=""
    hint="$(recording_log_tail_hint "$record_log")"
    if [[ -n "$hint" ]]; then
      die "recording failed ($hint)"
    fi
    die "recording failed (ffmpeg exited immediately)"
  fi

  printf 'pid=%q\nwav=%q\ntarget_app=%q\nmodel_id=%q\nrecord_started_ms=%q\nstartup_total_ms=%q\nstartup_audio_ms=%q\nstartup_ffmpeg_live_ms=%q\nstartup_target_ms=%q\nstartup_audio_source=%q\ninline_session_id=%q\ncontrol_fifo=%q\ncontrol_keeper_pid=%q\n' \
    "$pid" "$wav" "$target_app" "$model_id" "$record_started_ms" \
    "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "${startup_audio_source};selector=${audio_selector_kind}" "$inline_session_id" \
    "${control_fifo:-}" "${control_keeper_pid:-}" >"$INLINE_STATE_FILE"

  maybe_warmup_swift_parakeet_in_background

  play_sound start
  echo "🎙️ RECORDING → inline"
}

inline_stop() {
  [[ -f "$INLINE_STATE_FILE" ]] || die "not recording. Run: tmux-whisper inline start"

  # shellcheck disable=SC1090
  . "$INLINE_STATE_FILE"
  local state_record_started_ms="${record_started_ms:-}"
  local startup_total_ms="${startup_total_ms:-0}"
  local startup_audio_ms="${startup_audio_ms:-0}"
  local startup_ffmpeg_live_ms="${startup_ffmpeg_live_ms:-0}"
  local startup_target_ms="${startup_target_ms:-0}"
  local startup_audio_source="${startup_audio_source:-}"
  local stop_requested_ms
  stop_requested_ms="$(now_ms)"

  [[ -n "${pid:-}" && -n "${wav:-}" ]] || die "state file invalid; try: tmux-whisper inline start"
  local record_ms="0"
  if [[ -n "$state_record_started_ms" && "$state_record_started_ms" =~ ^[0-9]+$ ]]; then
    record_ms=$((stop_requested_ms - state_record_started_ms))
    (( record_ms < 0 )) && record_ms=0
  fi

  local inline_pending_proc_file=""
  processing_marker_start "inline" "${inline_session_id:-}" "$$" 2>/dev/null || true
  inline_pending_proc_file="$PROCESSING_MARKER_FILE"
  rm -f "$INLINE_STATE_FILE"

  local inline_record_log inline_process_sound
  inline_record_log="$TMPDIR/whisper-dictate-inline.record.log"
  inline_process_sound="${DICTATE_INLINE_PROCESS_SOUND:-${CFG_INLINE_PROCESS_SOUND:-1}}"
  local inline_stop_grace_ms
  inline_stop_grace_ms="$(resolve_inline_stop_grace_ms)"
  if keep_logs_enabled; then
    printf "[%s] inline_stop_request: pid=%s record_ms=%s stop_grace_ms=%s wav=%q\n" \
      "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" "$pid" "$record_ms" "$inline_stop_grace_ms" "$wav" \
      >>"$inline_record_log" 2>/dev/null || true
  fi
  if [[ "$inline_process_sound" == "1" ]]; then
    if keep_logs_enabled; then
      printf "[%s] inline_process_sound: immediate_on_stop\n" \
        "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" >>"$inline_record_log" 2>/dev/null || true
    fi
    play_sound process
  fi

  terminate_recording_pid "$pid" "$inline_stop_grace_ms" "$inline_record_log" "${control_fifo:-}" "${control_keeper_pid:-}"

  local inline_bg_pid
  (
    trap '' HUP
    set -euo pipefail
    process_inline_recording "$wav" "${target_app:-}" "$model_id" "$record_ms" \
      "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source" "${inline_session_id:-}" "$inline_stop_grace_ms" "external"
  ) >"$TMPDIR/whisper-dictate-inline.transcribe.log" 2>&1 &
  inline_bg_pid="$!"
  processing_marker_start "inline" "${inline_session_id:-}" "$inline_bg_pid" 2>/dev/null || true
  processing_marker_stop "$inline_pending_proc_file"

  echo "⏹️ STOPPED → transcribing → inline"
}

inline_toggle() {
  if [[ -f "$INLINE_STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$INLINE_STATE_FILE"
    if kill -0 "${pid:-0}" 2>/dev/null; then
      inline_stop
    else
      rm -f "$INLINE_STATE_FILE" "${wav:-}" 2>/dev/null || true
      inline_start
    fi
  else
    inline_start
  fi
}

# Inline mode: foreground recording, no tmux required
inline() {
  need ffmpeg

  local model_id
  model_id="$(current_transcribe_model_label)"
  local inline_session_id
  inline_session_id="$(generate_inline_session_id)"
  write_inline_latest_session "$inline_session_id"
  local startup_started_ms startup_total_ms startup_audio_ms startup_target_ms startup_ffmpeg_live_ms startup_audio_source
  startup_started_ms="$(now_ms)"
  startup_total_ms=0
  startup_audio_ms=0
  startup_target_ms=0
  startup_ffmpeg_live_ms=0
  startup_audio_source="(none)"
  local paste_target
  paste_target="$(normalize_inline_paste_target "${DICTATE_INLINE_PASTE_TARGET:-${CFG_INLINE_PASTE_TARGET:-restore}}")"

  recording_resolve_audio_context "inline" "0"
  local audio_selector="$RECORDING_AUDIO_SELECTOR"
  local audio_cache_note="$RECORDING_AUDIO_CACHE_NOTE"
  startup_audio_ms="$RECORDING_AUDIO_MS"
  startup_audio_source="$RECORDING_AUDIO_SOURCE"

  local target_app="${DICTATE_TARGET_APP:-}"
  if [[ "$paste_target" == "restore" && -z "$target_app" ]]; then
    local stage_started_ms
    stage_started_ms="$(now_ms)"
    target_app="$(osascript -e 'tell application "System Events" to get name of first process whose frontmost is true' 2>/dev/null || echo "Ghostty")"
    startup_target_ms=$(( $(now_ms) - stage_started_ms ))
  fi

  local wav
  wav="/tmp/dictate-inline-$$.wav"
  local record_log
  record_log="$TMPDIR/whisper-dictate-inline.record.log"

  echo "🎙️ Recording... (Ctrl+C to stop)"

  local record_started_ms
  record_started_ms="$(now_ms)"
  startup_total_ms=$(( record_started_ms - startup_started_ms ))
  (( startup_total_ms < 0 )) && startup_total_ms=0
  maybe_warmup_swift_parakeet_in_background
  local ffmpeg_pid=""
  local inline_interrupted="0"
  local inline_stop_grace_ms
  inline_stop_grace_ms="$(resolve_inline_stop_grace_ms)"
  : >"$record_log" 2>/dev/null || true
  log_audio_cache_note_if_any "${audio_cache_note:-}" "$record_log"
  ffmpeg -hide_banner -nostdin -loglevel error \
    -f avfoundation -i ":${audio_selector}" \
    -af "aresample=async=1000:first_pts=0" \
    -ac 1 -ar 16000 -c:a pcm_s16le \
    "$wav" >>"$record_log" 2>&1 &
  ffmpeg_pid="$!"
  trap 'inline_interrupted=1; echo ""; terminate_recording_pid "$ffmpeg_pid" "$inline_stop_grace_ms" "$record_log"' INT TERM
  wait "$ffmpeg_pid" || true
  trap - INT TERM

  local record_ms
  record_ms=$(( $(now_ms) - record_started_ms ))
  (( record_ms < 0 )) && record_ms=0

  process_inline_recording "$wav" "$target_app" "$model_id" "$record_ms" \
    "$startup_total_ms" "$startup_audio_ms" "$startup_ffmpeg_live_ms" "$startup_target_ms" "$startup_audio_source" "$inline_session_id" "$inline_stop_grace_ms"
}

toggle() {
  if [[ -f "$STATE_FILE" ]]; then
    # shellcheck disable=SC1090
    . "$STATE_FILE"
    if kill -0 "${pid:-0}" 2>/dev/null; then
      stop
    else
      # Stale state, clean up and start fresh
      rm -f "$STATE_FILE" "$wav" 2>/dev/null
      start
    fi
  else
    start
  fi
}

set_postprocess() {
  local val="${1:-}"
  case "$val" in
    on|1)
      config_set "postprocess.enabled" "bool" "true"
      config_load
      echo "Post-processing: ON (Cerebras)"
      echo "Mode prompt: active when postprocess runs"
      ;;
    off|0)
      config_set "postprocess.enabled" "bool" "false"
      config_load
      echo "Post-processing: OFF"
      echo "Mode prompt: inactive (postprocess OFF)"
      ;;
    "")
      if [[ "${CFG_POSTPROCESS_ENABLED:-0}" == "1" ]]; then
        echo "Post-processing: ON"
        echo "Mode prompt: active when postprocess runs"
      else
        echo "Post-processing: OFF"
        echo "Mode prompt: inactive (postprocess OFF)"
      fi
      ;;
    *) die "unknown value: $val (use: on, off)" ;;
  esac
}

set_keep_logs() {
  local val="${1:-}"
  case "$val" in
    on|1|true)
      config_set "debug.keep_logs" "bool" "true"
      config_load
      echo "keep_logs: ON"
      ;;
    off|0|false)
      config_set "debug.keep_logs" "bool" "false"
      config_load
      echo "keep_logs: OFF"
      ;;
    "")
      if keep_logs_enabled; then
        echo "keep_logs: ON"
      else
        echo "keep_logs: OFF"
      fi
      echo "Env override: DICTATE_KEEP_LOGS=${DICTATE_KEEP_LOGS:-<unset>}"
      ;;
    *)
      die "usage: tmux-whisper keep-logs [on|off]"
      ;;
  esac
}

set_silence_trim() {
  local val="${1:-show}"
  case "$val" in
    on|1|true)
      config_set "audio.silence_trim" "bool" "true"
      config_load
      echo "silence_trim: ON"
      ;;
    off|0|false)
      config_set "audio.silence_trim" "bool" "false"
      config_load
      echo "silence_trim: OFF"
      ;;
    toggle)
      if [[ "${CFG_AUDIO_SILENCE_TRIM:-0}" == "1" ]]; then
        config_set "audio.silence_trim" "bool" "false"
      else
        config_set "audio.silence_trim" "bool" "true"
      fi
      config_load
      [[ "${CFG_AUDIO_SILENCE_TRIM:-0}" == "1" ]] && echo "silence_trim: ON" || echo "silence_trim: OFF"
      ;;
    show|"")
      [[ "${CFG_AUDIO_SILENCE_TRIM:-0}" == "1" ]] && echo "silence_trim: ON" || echo "silence_trim: OFF"
      echo "mode: ${CFG_AUDIO_SILENCE_TRIM_MODE:-edges}"
      echo "threshold_db: ${CFG_AUDIO_SILENCE_THRESHOLD_DB:--60}"
      echo "min_ms: ${CFG_AUDIO_SILENCE_MIN_MS:-250}"
      echo "keep_ms: ${CFG_AUDIO_SILENCE_KEEP_MS:-50}"
      ;;
    *)
      die "usage: tmux-whisper silence-trim [on|off|toggle|show]"
      ;;
  esac
}

set_repeats_level() {
  local val="${1:-show}"
  case "$val" in
    0|1|2)
      config_set "clean.repeats_level" "int" "$val"
      config_load
      echo "repeats_level: ${CFG_CLEAN_REPEATS_LEVEL:-1}"
      ;;
    off)
      config_set "clean.repeats_level" "int" "0"
      config_load
      echo "repeats_level: ${CFG_CLEAN_REPEATS_LEVEL:-0}"
      ;;
    toggle)
      local current="${CFG_CLEAN_REPEATS_LEVEL:-1}"
      local next="1"
      case "$current" in
        0) next="1" ;;
        1) next="2" ;;
        *) next="0" ;;
      esac
      config_set "clean.repeats_level" "int" "$next"
      config_load
      echo "repeats_level: ${CFG_CLEAN_REPEATS_LEVEL:-$next}"
      ;;
    show|"")
      echo "repeats_level: ${CFG_CLEAN_REPEATS_LEVEL:-1}"
      echo "  0 = off"
      echo "  1 = dedupe repeated words"
      echo "  2 = dedupe repeated words + short phrases"
      ;;
    *)
      die "usage: tmux-whisper repeats [0|1|2|off|toggle|show]"
      ;;
  esac
}

set_autosend() {
  local val="${1:-}"
  case "$val" in
    on|1)  config_set "inline.autosend" "bool" "true";  config_load; echo "Auto-send: ON (paste + send key)" ;;
    off|0) config_set "inline.autosend" "bool" "false"; config_load; echo "Auto-send: OFF (paste only)" ;;
    "")
      [[ "${CFG_INLINE_AUTOSEND:-1}" == "1" ]] && echo "Auto-send: ON" || echo "Auto-send: OFF"
      echo ""
      echo "Note: Applies to inline mode only. Use: tmux-whisper tmux autosend on|off"
      ;;
    *) die "unknown value: $val (use: on, off)" ;;
  esac
}

set_inline_process_sound() {
  local val="${1:-}"
  case "$val" in
    on|1)  config_set "inline.process_sound" "bool" "true";  config_load; echo "inline process_sound: ON" ;;
    off|0) config_set "inline.process_sound" "bool" "false"; config_load; echo "inline process_sound: OFF" ;;
    "")
      [[ "${CFG_INLINE_PROCESS_SOUND:-1}" == "1" ]] && echo "inline process_sound: ON" || echo "inline process_sound: OFF"
      ;;
    *) die "unknown value: $val (use: on, off)" ;;
  esac
}

normalize_inline_paste_target() {
  local val="${1:-restore}"
  case "$val" in
    current) echo "current" ;;
    origin|restore|"") echo "restore" ;;
    *) echo "restore" ;;
  esac
}

normalize_inline_send_mode() {
  local val="${1:-enter}"
  case "$val" in
    enter|"") echo "enter" ;;
    ctrl_j|ctrl-j|ctrlj|ctrl+j) echo "ctrl_j" ;;
    cmd_enter|cmd-enter|cmdenter|cmd+enter) echo "cmd_enter" ;;
    *) echo "enter" ;;
  esac
}

inline_send_mode_label() {
  local norm
  norm="$(normalize_inline_send_mode "${1:-enter}")"
  case "$norm" in
    ctrl_j) echo "ctrl_j" ;;
    cmd_enter) echo "cmd_enter" ;;
    *) echo "enter" ;;
  esac
}

inline_send_mode_desc() {
  local norm
  norm="$(normalize_inline_send_mode "${1:-enter}")"
  case "$norm" in
    ctrl_j) echo "Ctrl+J" ;;
    cmd_enter) echo "Cmd+Enter" ;;
    *) echo "Enter" ;;
  esac
}

inline_paste_target_label() {
  local norm
  norm="$(normalize_inline_paste_target "${1:-restore}")"
  if [[ "$norm" == "current" ]]; then
    echo "current"
  else
    echo "origin"
  fi
}

set_paste_target() {
  local val="${1:-}"
  case "$val" in
    origin|restore) config_set "inline.paste_target" "string" "restore"; config_load; echo "Paste target: ORIGIN (app from recording start)" ;;
    current) config_set "inline.paste_target" "string" "current"; config_load; echo "Paste target: CURRENT (wherever you are now)" ;;
    "")
      local current_raw="${DICTATE_INLINE_PASTE_TARGET:-${CFG_INLINE_PASTE_TARGET:-restore}}"
      local current
      current="$(inline_paste_target_label "$current_raw")"
      echo "Paste target: $current"
      echo ""
      echo "Options:"
      echo "  origin  - paste to app that was frontmost when recording started (alias: restore)"
      echo "  current - paste to whatever app is frontmost when recording stops"
      ;;
    *) die "unknown value: $val (use: origin, current, restore)" ;;
  esac
}

set_inline_send_mode() {
  local val="${1:-}"
  case "$val" in
    enter)
      config_set "inline.send_mode" "string" "enter"
      config_load
      echo "Inline send mode: Enter"
      ;;
    ctrl_j|ctrl-j|ctrlj|ctrl+j)
      config_set "inline.send_mode" "string" "ctrl_j"
      config_load
      echo "Inline send mode: Ctrl+J"
      ;;
    cmd_enter|cmd-enter|cmdenter|cmd+enter)
      config_set "inline.send_mode" "string" "cmd_enter"
      config_load
      echo "Inline send mode: Cmd+Enter"
      ;;
    "")
      local current_raw="${DICTATE_INLINE_SEND_MODE:-${CFG_INLINE_SEND_MODE:-enter}}"
      local current
      current="$(inline_send_mode_label "$current_raw")"
      echo "Inline send mode: $current ($(inline_send_mode_desc "$current_raw"))"
      echo ""
      echo "Options:"
      echo "  enter     - autosend with Enter"
      echo "  ctrl_j    - autosend with Ctrl+J (often needed in Claude Code)"
      echo "  cmd_enter - autosend with Cmd+Enter"
      ;;
    *)
      die "unknown value: $val (use: enter, ctrl_j, cmd_enter)"
      ;;
  esac
}

manage_tmux() {
  local sub="${1:-}"
  local val="${2:-}"
  local tmux_mode_current
  local tmux_send_mode_current
  tmux_mode_current="$(canonical_mode_name "${CFG_TMUX_MODE:-code}")"
  if ! mode_exists "$tmux_mode_current" || ! mode_allows_flow "$tmux_mode_current" "tmux"; then
    tmux_mode_current="$(first_mode_for_flow "tmux")"
  fi
  tmux_send_mode_current="${CFG_TMUX_SEND_MODE:-auto}"
  case "$tmux_send_mode_current" in
    auto|enter|codex) ;;
    *) tmux_send_mode_current="auto" ;;
  esac

  case "$sub" in
    ""|show)
      echo "tmux defaults:"
      [[ "${CFG_TMUX_AUTOSEND:-1}" == "1" ]] && echo "  autosend: ON" || echo "  autosend: OFF"
      echo "  target: ${CFG_TMUX_PASTE_TARGET:-origin}"
      [[ "${CFG_TMUX_POSTPROCESS:-0}" == "1" ]] && echo "  postprocess: ON" || echo "  postprocess: OFF"
      [[ "${CFG_TMUX_PROCESS_SOUND:-0}" == "1" ]] && echo "  process_sound: ON" || echo "  process_sound: OFF"
      echo "  send_mode: $tmux_send_mode_current"
      echo "  mode: $(mode_display_name "$tmux_mode_current")"
      if [[ "${CFG_TMUX_POSTPROCESS:-0}" == "1" ]]; then
        echo "  mode_prompt: active when tmux postprocess runs"
      else
        echo "  mode_prompt: inactive (tmux postprocess OFF)"
      fi
      ;;
    autosend)
      case "$val" in
        on|1)  config_set "tmux.autosend" "bool" "true";  config_load; echo "tmux autosend: ON (paste + Enter)" ;;
        off|0) config_set "tmux.autosend" "bool" "false"; config_load; echo "tmux autosend: OFF (paste only)" ;;
        "")
          [[ "${CFG_TMUX_AUTOSEND:-1}" == "1" ]] && echo "tmux autosend: ON" || echo "tmux autosend: OFF"
          ;;
        *) die "unknown value: $val (use: on, off)" ;;
      esac
      ;;
    target)
      case "$val" in
        origin) config_set "tmux.paste_target" "string" "origin"; config_load; echo "tmux target: origin (pane where recording started)" ;;
        current) config_set "tmux.paste_target" "string" "current"; config_load; echo "tmux target: current (pane at stop time)" ;;
        "")
          local current="${CFG_TMUX_PASTE_TARGET:-origin}"
          echo "tmux target: $current"
          if [[ -n "${TMUX:-}" ]]; then
            local active_pane active_label
            active_pane="$(tmux display-message -p '#{pane_id}' 2>/dev/null || true)"
            if [[ -n "$active_pane" ]]; then
              active_label="$(tmux_describe_pane "$active_pane")"
              echo "active pane: ${active_label:-$active_pane}"
            fi
          fi
          echo ""
          echo "Options:"
          echo "  origin  - paste to pane where recording started"
          echo "  current - paste to whatever pane is active at stop"
          ;;
        *) die "unknown value: $val (use: origin, current)" ;;
      esac
      ;;
    postprocess)
      case "$val" in
        on|1)
          config_set "tmux.postprocess" "bool" "true"
          config_load
          echo "tmux postprocess: ON"
          echo "tmux mode prompt: active when postprocess runs"
          ;;
        off|0)
          config_set "tmux.postprocess" "bool" "false"
          config_load
          echo "tmux postprocess: OFF"
          echo "tmux mode prompt: inactive (tmux postprocess OFF)"
          ;;
        "")
          if [[ "${CFG_TMUX_POSTPROCESS:-0}" == "1" ]]; then
            echo "tmux postprocess: ON"
            echo "tmux mode prompt: active when postprocess runs"
          else
            echo "tmux postprocess: OFF"
            echo "tmux mode prompt: inactive (tmux postprocess OFF)"
          fi
          ;;
        *) die "unknown value: $val (use: on, off)" ;;
      esac
      ;;
    process-sound|process_sound|processsound)
      case "$val" in
        on|1)  config_set "tmux.process_sound" "bool" "true";  config_load; echo "tmux process_sound: ON" ;;
        off|0) config_set "tmux.process_sound" "bool" "false"; config_load; echo "tmux process_sound: OFF" ;;
        "")
          [[ "${CFG_TMUX_PROCESS_SOUND:-0}" == "1" ]] && echo "tmux process_sound: ON" || echo "tmux process_sound: OFF"
          ;;
        *) die "unknown value: $val (use: on, off)" ;;
      esac
      ;;
    send-mode|send_mode|sendmode)
      case "$val" in
        auto|enter|codex)
          config_set "tmux.send_mode" "string" "$val"
          config_load
          echo "tmux send_mode: $val"
          ;;
        "")
          local current_send_mode="${CFG_TMUX_SEND_MODE:-auto}"
          case "$current_send_mode" in
            auto|enter|codex) ;;
            *) current_send_mode="auto" ;;
          esac
          echo "tmux send_mode: $current_send_mode"
          echo ""
          echo "Options:"
          echo "  auto   - detect Codex (Tab+Enter), otherwise Enter"
          echo "  enter  - always send Enter"
          echo "  codex  - always send Tab+Enter"
          ;;
        *) die "unknown value: $val (use: auto, enter, codex)" ;;
      esac
      ;;
    mode)
      if [[ -z "$val" ]]; then
        echo "tmux mode: $(mode_display_name "$tmux_mode_current")"
        echo ""
        echo "Available:"
        local mode_name listed_any="0"
        while IFS= read -r mode_name; do
          [[ -n "$mode_name" ]] || continue
          listed_any="1"
          echo "  $(mode_display_name "$mode_name")"
        done < <(list_modes "tmux")
        [[ "$listed_any" == "1" ]] || echo "  (none)"
      else
        local canonical
        canonical="$(canonical_mode_name "$val")"
        mode_exists "$canonical" || die "unknown tmux mode: $val"
        mode_allows_flow "$canonical" "tmux" || die "mode '$val' is not enabled for tmux flow"
        config_set "tmux.mode" "string" "$canonical"
        config_load
        echo "tmux mode: $(mode_display_name "$canonical")"
      fi
      ;;
    *)
      die "usage: tmux-whisper tmux [autosend|target|postprocess|process-sound|send-mode|mode] [value]"
      ;;
  esac
}

set_llm() {
  local a1="${1:-}"
  local a2="${2:-}"

  lookup_override() {
    local list="${1:-}"
    local key="${2:-}"
    [[ -n "$list" && -n "$key" ]] || return 1
    local IFS=';'
    read -r -a pairs <<<"$list"
    local pair
    for pair in "${pairs[@]}"; do
      [[ "$pair" == "$key="* ]] && { echo "${pair#*=}"; return 0; }
    done
    return 1
  }

  lookup_override_for_mode() {
    local list="${1:-}"
    local key="${2:-}"
    lookup_override "$list" "$key" 2>/dev/null || true
  }

  resolve_llm_alias() {
    local name="${1:-}"
    case "$name" in
      fast|8b) echo "llama3.1-8b" ;;
      smart|70b) echo "llama-3.3-70b" ;;
      qwen|32b) echo "qwen-3-32b" ;;
      gpt|oss) echo "gpt-oss-120b" ;;
      *) echo "$name" ;;
    esac
  }

  if [[ -n "$a1" && -z "$a2" && -d "$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$a1")" ]]; then
    local mode
    mode="$(canonical_mode_name "$a1")"
    local mode_key
    mode_key="$(mode_override_key "$mode")"
    local override=""
    override="$(lookup_override_for_mode "${CFG_POSTPROCESS_MODE_LLM_OVERRIDES:-}" "$mode_key" 2>/dev/null || true)"
    if [[ -n "$override" ]]; then
      echo "LLM override for mode '$mode': $override"
    else
      echo "LLM override for mode '$mode': (none; uses global ${CFG_POSTPROCESS_LLM:-llama3.1-8b})"
    fi
    echo ""
    echo "Set with:"
    echo "  tmux-whisper llm $mode fast|smart|qwen|gpt"
    return 0
  fi

  if [[ -n "$a1" && -n "$a2" && -d "$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$a1")" ]]; then
    local mode
    mode="$(canonical_mode_name "$a1")"
    local mode_key
    mode_key="$(mode_override_key "$mode")"
    local model_id
    model_id="$(resolve_llm_alias "$a2")"
    config_set "postprocess.mode_llm_overrides.${mode_key}" "string" "$model_id"
    config_load
    echo "LLM override set for mode '$mode': $model_id"
    return 0
  fi

  local name="$a1"
  case "$name" in
    fast|8b)   config_set "postprocess.llm" "string" "llama3.1-8b";  config_load; echo "LLM set: llama3.1-8b (fast)" ;;
    smart|70b) config_set "postprocess.llm" "string" "llama-3.3-70b"; config_load; echo "LLM set: llama-3.3-70b (smart)" ;;
    qwen|32b)  config_set "postprocess.llm" "string" "qwen-3-32b";     config_load; echo "LLM set: qwen-3-32b (balanced)" ;;
    gpt|oss)   config_set "postprocess.llm" "string" "gpt-oss-120b";   config_load; echo "LLM set: gpt-oss-120b (fastest+smart)" ;;
    "")
      local current="llama3.1-8b"
      [[ -n "${CFG_POSTPROCESS_LLM:-}" ]] && current="$CFG_POSTPROCESS_LLM"
      echo "Current LLM: $current"
      echo ""
      echo "Available:"
      echo "  fast  (llama3.1-8b)   - ~2200 t/s, simple cleanup"
      echo "  smart (llama-3.3-70b) - ~2100 t/s, better understanding"
      echo "  qwen  (qwen-3-32b)    - ~2600 t/s, balanced"
      echo "  gpt   (gpt-oss-120b)  - ~3000 t/s, fastest + 120B params"
      echo ""
      echo "Per-mode override:"
      echo "  tmux-whisper llm <mode> <llm>   (e.g., tmux-whisper llm code smart)"
      ;;
    *) die "unknown LLM: $name (use: fast, smart, qwen, gpt, or: tmux-whisper llm <mode> <llm>)" ;;
  esac
}

set_budget() {
  local a1="${1:-}"
  local a2="${2:-}"
  local a3="${3:-}"

  lookup_override() {
    local list="${1:-}"
    local key="${2:-}"
    [[ -n "$list" && -n "$key" ]] || return 1
    local IFS=';'
    read -r -a pairs <<<"$list"
    local pair
    for pair in "${pairs[@]}"; do
      [[ "$pair" == "$key="* ]] && { echo "${pair#*=}"; return 0; }
    done
    return 1
  }

  lookup_override_for_mode() {
    local list="${1:-}"
    local key="${2:-}"
    lookup_override "$list" "$key" 2>/dev/null || true
  }

  resolve_llm_alias() {
    local name="${1:-}"
    case "$name" in
      fast|8b) echo "llama3.1-8b" ;;
      smart|70b) echo "llama-3.3-70b" ;;
      qwen|32b) echo "qwen-3-32b" ;;
      gpt|oss) echo "gpt-oss-120b" ;;
      *) echo "$name" ;;
    esac
  }

  show_one_budget_profile() {
    local profile="${1:-short}"
    local profile_key
    profile_key="$(mode_override_key "$profile")"

    local llm_override max_override chunk_override
    llm_override="$(lookup_override_for_mode "${CFG_POSTPROCESS_BUDGET_PROFILE_LLM_OVERRIDES:-}" "$profile_key" 2>/dev/null || true)"
    max_override="$(lookup_override_for_mode "${CFG_POSTPROCESS_BUDGET_PROFILE_MAX_TOKENS_OVERRIDES:-}" "$profile_key" 2>/dev/null || true)"
    chunk_override="$(lookup_override_for_mode "${CFG_POSTPROCESS_BUDGET_PROFILE_CHUNK_WORDS_OVERRIDES:-}" "$profile_key" 2>/dev/null || true)"

    local llm_effective max_effective chunk_effective
    llm_effective="${llm_override:-${CFG_POSTPROCESS_LLM:-llama3.1-8b}}"
    max_effective="${max_override:-${CFG_POSTPROCESS_MAX_TOKENS:-}}"
    chunk_effective="${chunk_override:-${CFG_POSTPROCESS_CHUNK_WORDS:-}}"

    echo "$profile budget profile:"
    echo "  llm: ${llm_effective}${llm_override:+ (override)}"
    [[ -n "$max_effective" ]] && echo "  max_tokens: ${max_effective}${max_override:+ (override)}" || echo "  max_tokens: <unset>"
    [[ -n "$chunk_effective" ]] && echo "  chunk_words: ${chunk_effective}${chunk_override:+ (override)}" || echo "  chunk_words: <unset>"
  }

  if [[ -z "$a1" ]]; then
    echo "Postprocess budget profiles"
    echo ""
    echo "Global defaults:"
    echo "  llm: ${CFG_POSTPROCESS_LLM:-llama3.1-8b}"
    [[ -n "${CFG_POSTPROCESS_MAX_TOKENS:-}" ]] && echo "  max_tokens: ${CFG_POSTPROCESS_MAX_TOKENS}" || echo "  max_tokens: <unset>"
    [[ -n "${CFG_POSTPROCESS_CHUNK_WORDS:-}" ]] && echo "  chunk_words: ${CFG_POSTPROCESS_CHUNK_WORDS}" || echo "  chunk_words: <unset>"
    echo "  auto_long_words_threshold: ${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-120}"
    echo "  auto_numeric_sizing: dynamic (max_tokens/chunk_words interpolate short->long by transcript words; clamp at threshold)"
    echo ""
    show_one_budget_profile "short"
    echo ""
    show_one_budget_profile "long"
    echo ""
    echo "Set overrides:"
    echo "  tmux-whisper budget short llm gpt"
    echo "  tmux-whisper budget short max_tokens 2000"
    echo "  tmux-whisper budget long chunk_words 1000"
    echo "  tmux-whisper budget threshold 120"
    return 0
  fi

  if [[ "$a1" == "threshold" ]]; then
    if [[ -z "$a2" ]]; then
      echo "budget auto_long_words_threshold: ${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-120}"
      echo ""
      echo "Set with:"
      echo "  tmux-whisper budget threshold <words>"
      return 0
    fi
    [[ "$a2" =~ ^[0-9]+$ ]] || die "usage: tmux-whisper budget threshold <words>"
    [[ "$a2" -gt 0 ]] || die "threshold must be > 0"
    config_set "postprocess.budget_long_words_threshold" "int" "$a2"
    config_load
    echo "budget auto_long_words_threshold: ${CFG_POSTPROCESS_BUDGET_LONG_WORDS_THRESHOLD:-$a2}"
    return 0
  fi

  local profile
  profile="$(canonical_mode_name "$a1")"
  case "$profile" in
    short|long) ;;
    *) die "usage: tmux-whisper budget [short|long|threshold] [llm|max_tokens|chunk_words|clear|<words>] [value]" ;;
  esac
  local profile_key
  profile_key="$(mode_override_key "$profile")"

  if [[ -z "$a2" ]]; then
    show_one_budget_profile "$profile"
    echo ""
    echo "Set overrides:"
    echo "  tmux-whisper budget $profile llm gpt|smart|qwen|fast|<model>"
    echo "  tmux-whisper budget $profile max_tokens <n>"
    echo "  tmux-whisper budget $profile chunk_words <n>"
    echo "  tmux-whisper budget $profile clear"
    return 0
  fi

  case "$a2" in
    llm)
      [[ -n "$a3" ]] || die "usage: tmux-whisper budget $profile llm <model|fast|smart|qwen|gpt>"
      local llm_id
      llm_id="$(resolve_llm_alias "$a3")"
      config_set "postprocess.budget_profiles.${profile_key}.llm" "string" "$llm_id"
      config_load
      echo "$profile budget profile llm: $llm_id"
      ;;
    max_tokens|chunk_words)
      [[ -n "$a3" ]] || die "usage: tmux-whisper budget $profile $a2 <n>"
      [[ "$a3" =~ ^[0-9]+$ ]] || die "$a2 must be a positive integer"
      [[ "$a3" -gt 0 ]] || die "$a2 must be > 0"
      config_set "postprocess.budget_profiles.${profile_key}.${a2}" "int" "$a3"
      config_load
      echo "$profile budget profile $a2: $a3"
      ;;
    clear|reset)
      config_set "postprocess.budget_profiles.${profile_key}.llm" "string" ""
      config_set "postprocess.budget_profiles.${profile_key}.max_tokens" "int" ""
      config_set "postprocess.budget_profiles.${profile_key}.chunk_words" "int" ""
      config_load
      echo "$profile budget profile overrides cleared (now using global defaults)."
      ;;
    *)
      die "usage: tmux-whisper budget [short|long|threshold] [llm|max_tokens|chunk_words|clear|<words>] [value]"
      ;;
  esac
}

set_device() {
  local a1="${1:-}"
  local a2="${2:-}"
  shift 2>/dev/null || true

  case "$a1" in
    "")
      local configured_source
      configured_source="$(normalize_audio_source "${CFG_AUDIO_SOURCE:-auto}")"
      echo "Device selection (source-aware):"
      echo "  source: $configured_source"
      echo "  named device (source=name): ${CFG_AUDIO_DEVICE_NAME:-<none>}"
      echo "  mac hint: ${CFG_AUDIO_MAC_NAME:-<none>}"
      echo "  iphone hint: ${CFG_AUDIO_IPHONE_NAME:-<none>}"
      echo "  fallback index: ${CFG_AUDIO_DEVICE_INDEX:-<none>}"
      local detect_meta resolved_idx resolved_src _resolved_ms _cache_note
      detect_meta="$(detect_audio_index 2>/dev/null || true)"
      IFS=$'\t' read -r resolved_idx resolved_src _resolved_ms _cache_note <<<"$detect_meta"
      echo "  resolved now: ${resolved_idx:-<none>} (${resolved_src:-not found})"
      echo ""
      echo "Available devices:"
      devices
      echo ""
      echo "Quick source commands:"
      echo "  tmux-whisper device auto"
      echo "  tmux-whisper device external"
      echo "  tmux-whisper device mac"
      echo "  tmux-whisper device iphone"
      echo "  tmux-whisper device name \"MacBook Air Microphone\""
      echo "  tmux-whisper device iphone-name \"Rico's iPhone\""
      ;;
    auto|external|mac|iphone)
      config_set "audio.source" "string" "$(normalize_audio_source "$a1")"
      config_set "audio.device_index" "int" ""
      clear_audio_index_cache
      config_load
      echo "Device source set: ${CFG_AUDIO_SOURCE:-auto}"
      ;;
    source)
      [[ -n "$a2" ]] || die "usage: tmux-whisper device source <auto|external|mac|iphone|name>"
      local src_raw src_norm
      src_raw="$(printf "%s" "$a2" | tr '[:upper:]' '[:lower:]' | tr -d '[:space:]')"
      case "$src_raw" in
        auto|external|mac|iphone|name) ;;
        *) die "usage: tmux-whisper device source <auto|external|mac|iphone|name>" ;;
      esac
      src_norm="$(normalize_audio_source "$src_raw")"
      config_set "audio.source" "string" "$src_norm"
      config_set "audio.device_index" "int" ""
      clear_audio_index_cache
      config_load
      echo "Device source set: ${CFG_AUDIO_SOURCE:-$src_norm}"
      ;;
    name)
      local name="${*:-}"
      [[ -n "$name" ]] || die "usage: tmux-whisper device name \"<substring>\""
      config_set "audio.source" "string" "name"
      config_set "audio.device_name" "string" "$name"
      local detected=""
      detected="$(DICTATE_AUDIO_SOURCE="name" DICTATE_AUDIO_NAME="$name" detect_audio_index 2>/dev/null | awk -F'\t' 'NR==1{print $1}' || true)"
      if [[ -n "$detected" ]]; then
        config_set "audio.device_index" "int" "$detected"
        write_audio_index_cache "source=name;preferred=${name};mac=${CFG_AUDIO_MAC_NAME:-${CFG_AUDIO_DEVICE_NAME:-MacBook Air Microphone}};iphone=${CFG_AUDIO_IPHONE_NAME:-}" "$detected" "$name" "name"
      else
        config_set "audio.device_index" "int" ""
        clear_audio_index_cache
      fi
      config_load
      echo "Device source set: name (\"${CFG_AUDIO_DEVICE_NAME:-}\")"
      [[ -n "$detected" ]] && echo "Fallback index: $detected"
      ;;
    mac-name)
      local mac_name="${*:-}"
      [[ -n "$mac_name" ]] || die "usage: tmux-whisper device mac-name \"<substring>\""
      config_set "audio.mac_name" "string" "$mac_name"
      clear_audio_index_cache
      config_load
      echo "Mac source hint set: ${CFG_AUDIO_MAC_NAME:-$mac_name}"
      ;;
    iphone-name|phone-name)
      local iphone_name="${*:-}"
      [[ -n "$iphone_name" ]] || die "usage: tmux-whisper device iphone-name \"<substring>\""
      config_set "audio.iphone_name" "string" "$iphone_name"
      clear_audio_index_cache
      config_load
      echo "iPhone source hint set: ${CFG_AUDIO_IPHONE_NAME:-$iphone_name}"
      ;;
    index)
      [[ -n "$a2" ]] || die "usage: tmux-whisper device index <n>"
      [[ "$a2" =~ ^[0-9]+$ ]] || die "invalid device index: $a2 (must be a number)"
      config_set "audio.device_index" "int" "$a2"
      clear_audio_index_cache
      config_load
      echo "Device pinned: index $a2"
      echo "Note: indices can change when devices connect/disconnect; prefer: tmux-whisper device name \"...\""
      ;;
    *)
      if [[ "$a1" =~ ^[0-9]+$ ]]; then
        local name=""
        name="$(detect_audio_name_by_index "$a1" 2>/dev/null || true)"
        if [[ -n "$name" ]]; then
          config_set "audio.source" "string" "name"
          config_set "audio.device_name" "string" "$name"
        fi
        config_set "audio.device_index" "int" "$a1"
        if [[ -n "$name" ]]; then
          write_audio_index_cache "source=name;preferred=${name};mac=${CFG_AUDIO_MAC_NAME:-${CFG_AUDIO_DEVICE_NAME:-MacBook Air Microphone}};iphone=${CFG_AUDIO_IPHONE_NAME:-}" "$a1" "$name" "name"
        else
          clear_audio_index_cache
        fi
        config_load
        if [[ -n "$name" ]]; then
          echo "Device set: $a1 ($name)"
          echo "Note: Tmux Whisper will prefer the name; index is only a fallback."
        else
          echo "Device set: $a1"
          echo "Note: couldn't resolve a name for index $a1; index may change between boots/devices."
        fi
      else
        die "usage: tmux-whisper device [<index>|index <n>|auto|external|mac|iphone|source <...>|name \"<substring>\"|mac-name \"<substring>\"|iphone-name \"<substring>\"]"
      fi
      ;;
  esac
}

VOCAB_FILE="$DICTATE_CONFIG_DIR/vocab"

normalize_vocab_entry() {
  local entry="${1:-}"
  entry="$(printf "%s" "$entry" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [[ -n "$entry" ]] || return 1
  [[ "$entry" == \#* ]] && return 1

  local left="" right=""
  if [[ "$entry" == *"::"* ]]; then
    left="${entry%%::*}"
    right="${entry#*::}"
  elif [[ "$entry" == *"->"* ]]; then
    left="${entry%%->*}"
    right="${entry#*->}"
  elif [[ "$entry" == *"→"* ]]; then
    left="${entry%%→*}"
    right="${entry#*→}"
  else
    return 2
  fi

  left="$(printf "%s" "$left" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  right="$(printf "%s" "$right" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
  [[ -n "$left" && -n "$right" ]] || return 2
  printf "%s → %s" "$left" "$right"
}

append_vocab_entry() {
  local raw="${1:-}"
  local vocab_file="${2:-$VOCAB_FILE}"
  local normalized=""
  normalized="$(normalize_vocab_entry "$raw" 2>/dev/null || true)"
  [[ -n "$normalized" ]] || return 2
  mkdir -p "$(dirname "$vocab_file")"
  touch "$vocab_file"
  if grep -Fxq "$normalized" "$vocab_file" 2>/dev/null; then
    return 1
  fi
  printf "%s\n" "$normalized" >>"$vocab_file"
  return 0
}

import_vocab_stream() {
  local invalid_log="${1:-}"
  local vocab_file="${2:-$VOCAB_FILE}"
  local added=0 dup=0 invalid=0
  local line norm rc line_num=0
  [[ -n "$invalid_log" ]] && : >"$invalid_log"
  while IFS= read -r line || [[ -n "$line" ]]; do
    line_num=$((line_num + 1))
    norm="$(normalize_vocab_entry "$line" 2>/dev/null || true)"
    if [[ -z "$norm" ]]; then
      # Ignore blanks/comments silently; count malformed non-empty entries.
      line="$(printf "%s" "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      if [[ -n "$line" && "$line" != \#* ]]; then
        invalid=$((invalid + 1))
        if [[ -n "$invalid_log" ]]; then
          printf "%s\t%s\n" "$line_num" "$line" >>"$invalid_log"
        fi
      fi
      continue
    fi
    append_vocab_entry "$norm" "$vocab_file"
    rc=$?
    case "$rc" in
      0) added=$((added + 1)) ;;
      1) dup=$((dup + 1)) ;;
      *) invalid=$((invalid + 1)) ;;
    esac
  done
  echo "$added $dup $invalid"
}

build_vocab_snapshot() {
  local src="${1:-}"
  local out="${2:-}"
  local invalid_log="${3:-}"
  [[ -n "$src" && -n "$out" ]] || return 2

  local kept=0 dup=0 invalid=0
  local line norm line_num=0 trimmed
  : >"$out"
  [[ -n "$invalid_log" ]] && : >"$invalid_log"

  while IFS= read -r line || [[ -n "$line" ]]; do
    line_num=$((line_num + 1))
    norm="$(normalize_vocab_entry "$line" 2>/dev/null || true)"
    if [[ -z "$norm" ]]; then
      trimmed="$(printf "%s" "$line" | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      if [[ -n "$trimmed" && "$trimmed" != \#* ]]; then
        invalid=$((invalid + 1))
        if [[ -n "$invalid_log" ]]; then
          printf "%s\t%s\n" "$line_num" "$trimmed" >>"$invalid_log"
        fi
      fi
      continue
    fi
    if grep -Fxq "$norm" "$out" 2>/dev/null; then
      dup=$((dup + 1))
      continue
    fi
    printf "%s\n" "$norm" >>"$out"
    kept=$((kept + 1))
  done <"$src"

  echo "$kept $dup $invalid"
}

prepare_vocab_work_file() {
  local work_file="${1:-}"
  [[ -n "$work_file" ]] || return 1
  if [[ -f "$VOCAB_FILE" ]]; then
    cp "$VOCAB_FILE" "$work_file"
  else
    : >"$work_file"
  fi
}

make_vocab_backup() {
  local src="${1:-}"
  [[ -f "$src" ]] || return 1
  local backup="${src}.bak.$(date +%Y%m%d-%H%M%S)"
  cp "$src" "$backup"
  printf "%s\n" "$backup"
}

show_vocab_invalid_preview() {
  local invalid_log="${1:-}"
  local limit="${2:-5}"
  [[ -s "$invalid_log" ]] || return 0
  echo "Invalid entries (first ${limit}):"
  awk -F'\t' -v max="$limit" 'NR <= max { printf "  - line %s: %s\n", $1, $2 }' "$invalid_log"
  echo "Tip: expected format wrong::right (also accepts wrong -> right or wrong → right)"
}

manage_vocab() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true
  
  case "$subcmd" in
    add)
      [[ "$#" -gt 0 ]] || die "usage: tmux-whisper vocab add \"wrong::right\" [\"a::b\" ...]"
      local token part
      local added=0 dup=0 invalid=0
      for token in "$@"; do
        local IFS=';'
        # Allow semicolon-separated batch in one argument.
        read -r -a _parts <<<"$token"
        for part in "${_parts[@]}"; do
          if append_vocab_entry "$part"; then
            added=$((added + 1))
          else
            case "$?" in
              1) dup=$((dup + 1)) ;;
              *) invalid=$((invalid + 1)) ;;
            esac
          fi
        done
      done
      echo "Vocab add: added=$added duplicate=$dup invalid=$invalid"
      if [[ "$invalid" -gt 0 ]]; then
        echo "Tip: use format wrong::right (also accepts wrong -> right or wrong → right)"
      fi
      return 0
      ;;
    import)
      local dry_run=0
      if [[ "${1:-}" == "--dry-run" ]]; then
        dry_run=1
        shift
      fi
      local src="${1:-}"
      [[ -n "$src" ]] || die "usage: tmux-whisper vocab import <file>"
      src="$(expand_path "$src")"
      [[ -f "$src" ]] || die "file not found: $src"
      local stats added dup invalid invalid_tmp work_file backup
      invalid_tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-import-invalid.XXXXXX")"
      work_file="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-import.XXXXXX")"
      prepare_vocab_work_file "$work_file"
      stats="$(import_vocab_stream "$invalid_tmp" "$work_file" < "$src")"
      added="$(printf "%s" "$stats" | awk "{print \$1}")"
      dup="$(printf "%s" "$stats" | awk "{print \$2}")"
      invalid="$(printf "%s" "$stats" | awk "{print \$3}")"
      [[ -n "$added" ]] || added=0
      [[ -n "$dup" ]] || dup=0
      [[ -n "$invalid" ]] || invalid=0
      backup=""
      if [[ "$dry_run" != "1" && "$added" -gt 0 ]]; then
        mkdir -p "$(dirname "$VOCAB_FILE")"
        if [[ -f "$VOCAB_FILE" ]]; then
          backup="$(make_vocab_backup "$VOCAB_FILE" || true)"
        fi
        mv -f "$work_file" "$VOCAB_FILE"
      else
        rm -f "$work_file"
      fi
      if [[ "$dry_run" == "1" ]]; then
        echo "Vocab import dry-run ($src): added=$added duplicate=$dup invalid=$invalid"
      else
        echo "Vocab import ($src): added=$added duplicate=$dup invalid=$invalid"
      fi
      if [[ -n "$backup" ]]; then
        echo "Backup: $backup"
      fi
      if [[ "$invalid" -gt 0 ]]; then
        show_vocab_invalid_preview "$invalid_tmp" 5
      fi
      rm -f "$invalid_tmp"
      ;;
    export)
      local dst="${1:-}"
      [[ -n "$dst" ]] || die "usage: tmux-whisper vocab export <file>"
      [[ -f "$VOCAB_FILE" ]] || die "no custom vocab file: $VOCAB_FILE"
      dst="$(expand_path "$dst")"
      mkdir -p "$(dirname "$dst")"

      local tmp invalid_tmp stats kept dup invalid backup
      tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-export.XXXXXX")"
      invalid_tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-export-invalid.XXXXXX")"
      stats="$(build_vocab_snapshot "$VOCAB_FILE" "$tmp" "$invalid_tmp")"
      kept="$(printf "%s" "$stats" | awk "{print \$1}")"
      dup="$(printf "%s" "$stats" | awk "{print \$2}")"
      invalid="$(printf "%s" "$stats" | awk "{print \$3}")"
      [[ -n "$kept" ]] || kept=0
      [[ -n "$dup" ]] || dup=0
      [[ -n "$invalid" ]] || invalid=0

      backup=""
      if [[ -f "$dst" ]]; then
        backup="${dst}.bak.$(date +%Y%m%d-%H%M%S)"
        cp "$dst" "$backup"
      fi
      mv -f "$tmp" "$dst"
      echo "Vocab export ($dst): entries=$kept duplicate_skipped=$dup invalid_skipped=$invalid"
      if [[ -n "$backup" ]]; then
        echo "Backup: $backup"
      fi
      if [[ "$invalid" -gt 0 ]]; then
        show_vocab_invalid_preview "$invalid_tmp" 5
      fi
      rm -f "$invalid_tmp"
      ;;
    clipboard|clip|paste)
      need pbpaste
      local dry_run=0
      if [[ "${1:-}" == "--dry-run" ]]; then
        dry_run=1
        shift
      fi
      local clip
      clip="$(pbpaste)"
      [[ -n "${clip//[[:space:]]/}" ]] || die "clipboard is empty"
      local stats added dup invalid invalid_tmp work_file backup
      invalid_tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-clipboard-invalid.XXXXXX")"
      work_file="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-clipboard.XXXXXX")"
      prepare_vocab_work_file "$work_file"
      stats="$(printf "%s\n" "$clip" | import_vocab_stream "$invalid_tmp" "$work_file")"
      added="$(printf "%s" "$stats" | awk "{print \$1}")"
      dup="$(printf "%s" "$stats" | awk "{print \$2}")"
      invalid="$(printf "%s" "$stats" | awk "{print \$3}")"
      [[ -n "$added" ]] || added=0
      [[ -n "$dup" ]] || dup=0
      [[ -n "$invalid" ]] || invalid=0
      backup=""
      if [[ "$dry_run" != "1" && "$added" -gt 0 ]]; then
        mkdir -p "$(dirname "$VOCAB_FILE")"
        if [[ -f "$VOCAB_FILE" ]]; then
          backup="$(make_vocab_backup "$VOCAB_FILE" || true)"
        fi
        mv -f "$work_file" "$VOCAB_FILE"
      else
        rm -f "$work_file"
      fi
      if [[ "$dry_run" == "1" ]]; then
        echo "Vocab clipboard import dry-run: added=$added duplicate=$dup invalid=$invalid"
      else
        echo "Vocab clipboard import: added=$added duplicate=$dup invalid=$invalid"
      fi
      if [[ -n "$backup" ]]; then
        echo "Backup: $backup"
      fi
      if [[ "$invalid" -gt 0 ]]; then
        show_vocab_invalid_preview "$invalid_tmp" 5
      fi
      rm -f "$invalid_tmp"
      ;;
    dedupe|clean)
      if [[ ! -f "$VOCAB_FILE" ]]; then
        echo "No custom vocab file"
        return 0
      fi
      local before after tmp invalid_tmp stats kept dup invalid backup
      before="$(wc -l < "$VOCAB_FILE" | tr -d ' ')"
      tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab.XXXXXX")"
      invalid_tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-dedupe-invalid.XXXXXX")"
      stats="$(build_vocab_snapshot "$VOCAB_FILE" "$tmp" "$invalid_tmp")"
      kept="$(printf "%s" "$stats" | awk "{print \$1}")"
      dup="$(printf "%s" "$stats" | awk "{print \$2}")"
      invalid="$(printf "%s" "$stats" | awk "{print \$3}")"
      [[ -n "$kept" ]] || kept=0
      [[ -n "$dup" ]] || dup=0
      [[ -n "$invalid" ]] || invalid=0
      backup="${VOCAB_FILE}.bak.$(date +%Y%m%d-%H%M%S)"
      cp "$VOCAB_FILE" "$backup"
      mv -f "$tmp" "$VOCAB_FILE"
      after="$(wc -l < "$VOCAB_FILE" | tr -d ' ')"
      echo "Vocab dedupe: $before -> $after entries (duplicate_removed=$dup invalid_removed=$invalid)"
      echo "Backup: $backup"
      if [[ "$invalid" -gt 0 ]]; then
        show_vocab_invalid_preview "$invalid_tmp" 5
      fi
      rm -f "$invalid_tmp"
      ;;
    edit)
      mkdir -p "$(dirname "$VOCAB_FILE")"
      touch "$VOCAB_FILE"
      ${EDITOR:-nvim} "$VOCAB_FILE"
      ;;
    rm|remove)
      local dry_run=0 use_regex=0
      while [[ "$#" -gt 0 ]]; do
        case "$1" in
          --dry-run) dry_run=1 ;;
          --regex) use_regex=1 ;;
          --) shift; break ;;
          *) break ;;
        esac
        shift
      done
      local pattern="$*"
      if [[ -z "$pattern" ]]; then
        die "usage: tmux-whisper vocab rm [--dry-run] [--regex] \"pattern\""
      fi
      if [[ ! -f "$VOCAB_FILE" ]]; then
        echo "No custom vocab file"
        return 0
      fi
      local before after removed tmp backup match_mode
      before="$(wc -l < "$VOCAB_FILE" | tr -d ' ')"
      tmp="$(mktemp "${TMPDIR:-/tmp}/dictate-vocab-rm.XXXXXX")"
      if [[ "$use_regex" == "1" ]]; then
        match_mode="regex"
        local grep_rc=0
        if grep -v -- "$pattern" "$VOCAB_FILE" >"$tmp"; then
          grep_rc=0
        else
          grep_rc=$?
          case "$grep_rc" in
            1) : ;;
            2)
              rm -f "$tmp"
              die "invalid regex pattern: $pattern"
              ;;
          esac
        fi
      else
        match_mode="literal"
        grep -F -v -- "$pattern" "$VOCAB_FILE" >"$tmp" || true
      fi
      after="$(wc -l < "$tmp" | tr -d ' ')"
      removed=$((before - after))
      backup=""
      if [[ "$removed" -gt 0 && "$dry_run" != "1" ]]; then
        backup="$(make_vocab_backup "$VOCAB_FILE" || true)"
        mv -f "$tmp" "$VOCAB_FILE"
      else
        rm -f "$tmp"
      fi
      if [[ "$dry_run" == "1" ]]; then
        echo "Vocab rm dry-run: removed=$removed match=$match_mode pattern=$pattern"
      else
        echo "Vocab rm: removed=$removed match=$match_mode pattern=$pattern"
      fi
      if [[ -n "$backup" ]]; then
        echo "Backup: $backup"
      fi
      ;;
    "")
      if [[ -f "$VOCAB_FILE" ]]; then
        echo "Custom corrections (~/.config/dictate/vocab):"
        echo ""
        nl -ba "$VOCAB_FILE"
        echo ""
        echo "$(wc -l < "$VOCAB_FILE" | tr -d ' ') entries"
        echo ""
        echo "Commands:"
        echo "  tmux-whisper vocab add \"wrong::right\" [\"a::b\" ...]"
        echo "  tmux-whisper vocab import [--dry-run] <file>"
        echo "  tmux-whisper vocab export <file>"
        echo "  tmux-whisper vocab clipboard [--dry-run]"
        echo "  tmux-whisper vocab dedupe"
        echo "  tmux-whisper vocab rm [--dry-run] [--regex] \"pattern\""
      else
        echo "No custom vocab file yet."
        echo ""
        echo "Add corrections:"
        echo "  tmux-whisper vocab add \"health lag::help flag\""
        echo "  tmux-whisper vocab add \"my app::MyApp\""
      fi
      ;;
    *) die "unknown vocab command: $subcmd (use: add, import, export, clipboard, dedupe, edit, rm)" ;;
  esac
}

manage_mode() {
  local subcmd="${1:-}"
  shift 2>/dev/null || true
  
  mkdir -p "$DICTATE_CONFIG_DIR/modes"
  
  case "$subcmd" in
    apps)
      local apps_subcmd="${1:-}"
      shift 2>/dev/null || true
      
      # Get current mode for apps command
      local current_mode
      current_mode="$(get_current_mode)"
      
      local apps_file="$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$current_mode")/apps"
      
      case "$apps_subcmd" in
        add)
          local app_name="$*"
          if [[ -z "$app_name" ]]; then
            die "usage: tmux-whisper mode apps add \"AppName\""
          fi
          mkdir -p "$(dirname "$apps_file")"
          echo "$app_name" >> "$apps_file"
          echo "Added '$app_name' to $(mode_display_name "$current_mode") mode"
          ;;
        "")
          echo "Apps for $(mode_display_name "$current_mode") mode:"
          if [[ -f "$apps_file" ]]; then
            cat "$apps_file" | sed 's/^/  /'
          else
            echo "  (none configured)"
          fi
          ;;
        *) die "unknown apps command: $apps_subcmd (use: add)" ;;
      esac
      ;;
    create)
      local new_mode="$1"
      if [[ -z "$new_mode" ]]; then
        die "usage: tmux-whisper mode create <name>"
      fi
      local new_dir="$DICTATE_CONFIG_DIR/modes/$new_mode"
      if [[ -d "$new_dir" ]]; then
        die "mode '$new_mode' already exists"
      fi
      mkdir -p "$new_dir"
      touch "$new_dir/apps"
      touch "$new_dir/vocab"
      echo "Context: $new_mode mode." > "$new_dir/prompt"
      echo "Created mode: $new_mode"
      echo "  Edit apps: tmux-whisper mode apps add \"AppName\""
      echo "  Edit prompt: \$EDITOR $new_dir/prompt"
      echo "  Set flows: tmux-whisper mode flows $new_mode both"
      ;;
    flows)
      local flow_target="${1:-}"
      local flow_spec="${2:-}"
      local target_mode=""
      case "$flow_target" in
        "" )
          target_mode="$(get_current_mode)"
          ;;
        inline|tmux|both|all|clear|reset)
          target_mode="$(get_current_mode)"
          flow_spec="$flow_target"
          ;;
        *)
          target_mode="$(canonical_mode_name "$flow_target")"
          mode_exists "$target_mode" || die "unknown mode: $flow_target"
          ;;
      esac
      [[ -n "$target_mode" ]] || target_mode="$(get_current_mode)"
      if [[ -z "$flow_spec" ]]; then
        show_mode_flows "$target_mode"
      else
        write_mode_flows "$target_mode" "$flow_spec"
        show_mode_flows "$target_mode"
      fi
      ;;
    edit)
      local mode_to_edit="${1:-}"
      if [[ -z "$mode_to_edit" ]]; then
        # Edit current mode
        mode_to_edit="$(get_current_mode)"
      fi
      mode_to_edit="$(canonical_mode_name "$mode_to_edit")"
      local prompt_file="$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$mode_to_edit")/prompt"
      if [[ ! -f "$prompt_file" ]]; then
        mkdir -p "$(dirname "$prompt_file")"
        echo "Context: $mode_to_edit mode." > "$prompt_file"
      fi
      ${EDITOR:-nvim} "$prompt_file"
      ;;
    "")
      # Show current mode and list all
      local current_raw current
      if [[ -f "$MODE_FILE" ]]; then
        current_raw="$(head -n 1 "$MODE_FILE" 2>/dev/null | tr -d '\r' | sed -E 's/^[[:space:]]+//; s/[[:space:]]+$//')"
      else
        current_raw="auto"
      fi
      if [[ -z "$current_raw" || "$current_raw" == "auto" ]]; then
        current="$(get_current_mode)"
        echo "Current mode: auto (app-detected, current=$(mode_display_name "$current"))"
      else
        current="$(canonical_mode_name "$current_raw")"
        echo "Current mode: $(mode_display_name "$current") (fixed)"
      fi
      if [[ "${CFG_POSTPROCESS_ENABLED:-0}" == "1" ]]; then
        echo "Mode prompt (inline): active when postprocess runs"
      else
        echo "Mode prompt (inline): inactive (postprocess OFF)"
      fi
      
      echo ""
      echo "Available modes:"
      local mode_name mode_dir app_count flows_desc listed_any="0"
      while IFS= read -r mode_name; do
        [[ -n "$mode_name" ]] || continue
        listed_any="1"
        mode_dir="$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$mode_name")"
        app_count=0
        [[ -f "$mode_dir/apps" ]] && app_count="$(wc -l < "$mode_dir/apps" | tr -d ' ')"
        if mode_allows_flow "$mode_name" "tmux" && mode_allows_flow "$mode_name" "inline"; then
          flows_desc="tmux+inline"
        elif mode_allows_flow "$mode_name" "tmux"; then
          flows_desc="tmux"
        elif mode_allows_flow "$mode_name" "inline"; then
          flows_desc="inline"
        else
          flows_desc="hidden"
        fi
        echo "  $(mode_display_name "$mode_name") ($app_count apps, flows: $flows_desc)"
      done < <(list_modes "")
      [[ "$listed_any" == "1" ]] || echo "  (none)"
      echo ""
      echo "Commands:"
      echo "  tmux-whisper mode auto       - app-detect inline mode"
      echo "  tmux-whisper mode <name>     - set fixed mode (e.g. code)"
      echo "  tmux-whisper mode apps       - list apps for current mode"
      echo "  tmux-whisper mode apps add X - add app to current mode"
      echo "  tmux-whisper mode flows X Y  - set flows for mode X to inline|tmux|both"
      echo "  tmux-whisper mode create X   - create new mode"
      echo "  tmux-whisper mode edit [X]   - edit mode prompt"
      echo "  tmux-whisper mode flows X    - show current flow config for mode X"
      ;;
    auto)
      printf '%s\n' "auto" > "$MODE_FILE"
      current="$(get_current_mode)"
      echo "Mode set: auto (app-detected, current=$(mode_display_name "$current"))"
      ;;
    *)
      # Check if it's a custom mode name
      local canonical
      canonical="$(canonical_mode_name "$subcmd")"
      if [[ -d "$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$canonical")" ]]; then
        echo "$canonical" > "$MODE_FILE"
        echo "Mode set: $(mode_display_name "$canonical") (fixed)"
      else
        die "unknown mode: $subcmd"
      fi
      ;;
  esac
}

# Replay: re-run LLM post-processing on clipboard or provided text with a mode
# Usage: tmux-whisper replay [mode] [text]
#   tmux-whisper replay long          # reprocess clipboard with long mode
#   tmux-whisper replay long "text"   # reprocess provided text with long mode
replay() {
  local target_mode="${1:-}"
  shift 2>/dev/null || true
  local provided_text="$*"
  
  # Check for API key
  if [[ -z "${CEREBRAS_API_KEY:-}" ]]; then
    die "replay requires CEREBRAS_API_KEY for LLM post-processing"
  fi
  
  # Get input: from argument or clipboard
  local input
  if [[ -n "$provided_text" ]]; then
    input="$provided_text"
    echo "📝 Using provided text..."
  else
    input="$(pbpaste)"
    if [[ -z "$input" ]]; then
      die "clipboard is empty (or provide text: tmux-whisper replay <mode> \"text\")"
    fi
  fi
  
  # Determine mode
  local mode_to_use
  if [[ -n "$target_mode" ]]; then
    target_mode="$(canonical_mode_name "$target_mode")"
    # Validate mode exists
    if [[ ! -d "$DICTATE_CONFIG_DIR/modes/$(mode_to_dir_name "$target_mode")" ]]; then
      die "unknown mode: $target_mode (available: $(ls -1 "$DICTATE_CONFIG_DIR/modes" 2>/dev/null | tr '\n' ' '))"
    fi
    mode_to_use="$target_mode"
  else
    mode_to_use="$(get_current_mode)"
  fi
  
  echo "📋 Clipboard: ${input:0:50}..."
  echo "🔄 Re-processing with $(mode_display_name "$mode_to_use") mode..."
  
  # Force the mode and run post-processing
  local result
  result="$(DICTATE_FORCE_MODE="$mode_to_use" postprocess_llm "$input" "")"
  result="$(printf "%s" "$result" | auto_paragraphs "$mode_to_use" | normalize_british_spelling)"
  
  if [[ -z "$result" || "$result" == "$input" ]]; then
    echo "⚠️ No changes (LLM returned same text or failed)"
    return 0
  fi
  
  # Copy result to clipboard
  printf "%s" "$result" | pbcopy
  
  echo "✅ Done. Result copied to clipboard:"
  echo ""
  echo "$result"
}

manage_keybind() {
  local mode="${1:-}"
  local key="${2:-}"

  if [[ -z "$mode" ]]; then
    # Show current keybinds
    echo "Current keybinds:"
    echo "  tmux: ${CFG_UI_KEYBIND_TMUX:-F12}"
    echo "  inline: ${CFG_UI_KEYBIND_INLINE:-F11}"
    echo ""
    echo "Set keybind: tmux-whisper keybind <tmux|inline> <key>"
    echo "Note: This is for display only. Update actual bindings in zsh/Raycast."
  elif [[ -z "$key" ]]; then
    # Show specific keybind
    case "$mode" in
      tmux) echo "tmux: ${CFG_UI_KEYBIND_TMUX:-F12}" ;;
      inline) echo "inline: ${CFG_UI_KEYBIND_INLINE:-F11}" ;;
      *) die "unknown mode: $mode (use: tmux, inline)" ;;
    esac
  else
    # Set keybind
    if [[ "$mode" != "tmux" && "$mode" != "inline" ]]; then
      die "unknown mode: $mode (use: tmux, inline)"
    fi

    config_set "ui.keybinds.${mode}" "string" "$key"
    config_load
    echo "Keybind set: $mode=$key"
    echo "Note: Update actual binding in zsh config or Raycast to match."
  fi
}

manage_swiftbar() {
  local action="${1:-show}"
  local plugin_path="$HOME/.config/swiftbar/plugins/tmux-whisper-status.0.2s.sh"
  local enabled="${CFG_SWIFTBAR_ENABLED:-1}"

  case "$action" in
    ""|show|status)
      echo "SwiftBar integration: $([[ "$enabled" == "1" ]] && echo "ON" || echo "OFF")"
      echo "Plugin path: $plugin_path $([[ -f "$plugin_path" ]] && echo '(present)' || echo '(missing)')"
      if [[ ! -f "$plugin_path" ]]; then
        echo "Hint: install plugin with ./install.sh --force"
      fi
      ;;
    on|off)
      config_set "integrations.swiftbar.enabled" "bool" "$([[ "$action" == "on" ]] && echo "true" || echo "false")"
      config_load
      echo "SwiftBar integration: $([[ "${CFG_SWIFTBAR_ENABLED:-1}" == "1" ]] && echo "ON" || echo "OFF")"
      if [[ "${CFG_SWIFTBAR_ENABLED:-1}" == "1" && ! -f "$plugin_path" ]]; then
        echo "Hint: plugin file missing at $plugin_path"
        echo "Install with: ./install.sh --force"
      fi
      ;;
    toggle)
      if [[ "$enabled" == "1" ]]; then
        manage_swiftbar off
      else
        manage_swiftbar on
      fi
      ;;
    *)
      die "usage: tmux-whisper swiftbar [show|on|off|toggle]"
      ;;
  esac
}

manage_sounds() {
  local target="${1:-}"
  local val="${2:-}"

  local onoff
  onoff() {
    [[ "${1:-}" == "1" ]] && echo "ON" || echo "OFF"
  }

  case "$target" in
    "" )
      echo "Sounds:"
      echo "  enabled: $(onoff "${CFG_AUDIO_SOUNDS_ENABLED:-1}")"
      echo "  start:   $(onoff "${CFG_AUDIO_SOUNDS_START_ENABLED:-1}")"
      echo "  stop:    $(onoff "${CFG_AUDIO_SOUNDS_STOP_ENABLED:-1}")"
      echo "  process: $(onoff "${CFG_AUDIO_SOUNDS_PROCESS_ENABLED:-1}")"
      echo "  error:   $(onoff "${CFG_AUDIO_SOUNDS_ERROR_ENABLED:-1}")"
      echo "  cancel:  $(onoff "${CFG_AUDIO_SOUNDS_CANCEL_ENABLED:-1}")"
      echo ""
      echo "Paths (from config):"
      echo "  start:   ${CFG_AUDIO_SOUNDS_START:-$SOUNDS_DIR/dictate/start.wav}"
      echo "  stop:    ${CFG_AUDIO_SOUNDS_STOP:-$SOUNDS_DIR/dictate/stop.wav}"
      echo "  process: ${CFG_AUDIO_SOUNDS_PROCESS:-$SOUNDS_DIR/dictate/process.wav}"
      echo "  error:   ${CFG_AUDIO_SOUNDS_ERROR:-$SOUNDS_DIR/dictate/error.wav}"
      echo "  cancel:  ${CFG_AUDIO_SOUNDS_CANCEL:-$SOUNDS_DIR/dictate/cancel.wav}"
      ;;
    on|off|mute|unmute)
      case "$target" in
        on|unmute) config_set "audio.sounds.enabled" "bool" "true" ;;
        off|mute) config_set "audio.sounds.enabled" "bool" "false" ;;
      esac
      config_load
      echo "Sounds: $(onoff "${CFG_AUDIO_SOUNDS_ENABLED:-1}")"
      ;;
    start|stop|process|error|cancel)
      [[ -n "$val" ]] || die "usage: tmux-whisper sound $target on|off"
      case "$val" in
        on|1) config_set "audio.sounds.${target}_enabled" "bool" "true" ;;
        off|0) config_set "audio.sounds.${target}_enabled" "bool" "false" ;;
        *) die "usage: tmux-whisper sound $target on|off" ;;
      esac
      config_load
      local state="1"
      case "$target" in
        start) state="${CFG_AUDIO_SOUNDS_START_ENABLED:-1}" ;;
        stop) state="${CFG_AUDIO_SOUNDS_STOP_ENABLED:-1}" ;;
        process) state="${CFG_AUDIO_SOUNDS_PROCESS_ENABLED:-1}" ;;
        error) state="${CFG_AUDIO_SOUNDS_ERROR_ENABLED:-1}" ;;
        cancel) state="${CFG_AUDIO_SOUNDS_CANCEL_ENABLED:-1}" ;;
      esac
      echo "$target: $(onoff "$state")"
      ;;
    *) die "usage: tmux-whisper sound [on|off|start|stop|process|error|cancel] [on|off]" ;;
  esac
}

case "$cmd" in
  -h|--help|help) usage ;;
  devices) devices "${@:2}" ;;
  device) set_device "${@:2}" ;;
  debug) debug "${@:2}" ;;
  doctor) doctor "${@:2}" ;;
  logs) logs "${@:2}" ;;
  watch) watch "${@:2}" ;;
  warmup) warmup_backend "${@:2}" ;;
  bench) bench "${@:2}" ;;
  bench-matrix|bench_matrix) bench_matrix "${2:-}" "${3:-}" ;;
  changelog) changelog ;;
  config) manage_config "${2:-}" "${@:3}" ;;
  status) status "${@:2}" ;;
  stop) stop ;;
  cancel) cancel ;;
  toggle|"") toggle ;;
  inline)
    case "${2:-}" in
      ""|fg|foreground) inline ;;
      start) inline_start ;;
      stop) inline_stop ;;
      toggle) inline_toggle ;;
      process-sound|process_sound|processsound) set_inline_process_sound "${3:-}" ;;
      *) die "usage: tmux-whisper inline [start|stop|toggle|process-sound]" ;;
    esac
    ;;
  sound|sounds) manage_sounds "${2:-}" "${3:-}" ;;
  postprocess) set_postprocess "${2:-}" ;;
  keep-logs|keep_logs|keeplogs) set_keep_logs "${2:-}" ;;
  silence-trim|silence_trim) set_silence_trim "${2:-}" ;;
  repeats) set_repeats_level "${2:-}" ;;
  autosend) set_autosend "${2:-}" ;;
  send-mode|send_mode|sendmode) set_inline_send_mode "${2:-}" ;;
  target|paste_target) set_paste_target "${2:-}" ;;
  tmux) manage_tmux "${2:-}" "${3:-}" ;;
  llm) set_llm "${2:-}" "${3:-}" ;;
  budget) set_budget "${2:-}" "${3:-}" "${4:-}" ;;
  vocab) manage_vocab "${2:-}" "${@:3}" ;;
  mode) manage_mode "${2:-}" "${@:3}" ;;
  keybind) manage_keybind "${2:-}" "${3:-}" ;;
  integrations) manage_integrations "${2:-}" "${@:3}" ;;
  swiftbar) manage_swiftbar "${2:-}" ;;
  replay) replay "${2:-}" "${@:3}" ;;
  history) manage_history "${@:2}" ;;
  last)
    if [[ "${2:-}" == "--json" ]]; then
      show_last_history "json"
    else
      show_last_history
    fi
    ;;
  *) die "unknown command: $cmd (run: tmux-whisper --help)" ;;
esac
